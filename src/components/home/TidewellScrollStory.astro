---
// Tidewell "Tides in Motion" Scroll Story — integrated for 磊大大の小栈
const CF_PREFIX = 'https://d8j0ntlcm91z4.cloudfront.net/user_38xzZboKViGWJOttwIXH07lWA1P/';
const proxy = (file: string, w: number) =>
  `https://images.higgs.ai/?default=1&output=webp&url=${encodeURIComponent(CF_PREFIX + file)}&w=${w}&q=85`;

const GRID_A = proxy('hf_20261118_061436_77e1a13d-60a0-4746-bf7b-53b2365609f5.png', 900);
const GRID_B = proxy('hf_20261118_061435_8a1828bc-a149-44ea-80fd-c4c33eef7407.png', 900);
const GRID_C = proxy('hf_20261118_061433_df51e37b-d8b8-40b1-9830-01ea6c20c83d.png', 900);
const GRID_C_CHIP = proxy('hf_20261118_061433_df51e37b-d8b8-40b1-9830-01ea6c20c83d.png', 300);
const SKY_PLATE = proxy('hf_20261118_061434_a222c9d2-715b-44b7-873f-0548d1624211.png', 2400);
const SKY_VIDEO = CF_PREFIX + 'hf_20261118_065029_a6ae2ebb-cd79-41fd-ae60-6b66fdda04ee.mp4';
const CAMERA_IMG = proxy('hf_20261118_061547_10365665-40d3-4390-944f-7bcb10dc6d4a.png', 1400);
const STICKER_PLANE = proxy('hf_20261118_061547_979f8673-f904-4102-90a0-6458bce33bc8.png', 1200);
const STICKER_SHEET = proxy('hf_20261118_061547_979f8673-f904-4102-90a0-6458bce33bc8.png', 700);

const cardDefs = [
  { grid: GRID_B, pos: '100% 100%' }, // 0: B-BR
  { grid: GRID_A, pos: '100% 0%' },   // 1: A-TR
  { grid: GRID_A, pos: '0% 100%' },   // 2: A-BL
  { grid: GRID_A, pos: '100% 100%' }, // 3: A-BR
  { grid: GRID_B, pos: '0% 0%' },     // 4: B-TL
  { grid: GRID_B, pos: '100% 0%' },   // 5: B-TR
  { grid: GRID_C, pos: '100% 0%' },   // 6: C-TR
  { grid: GRID_C, pos: '0% 0%' },     // 7: C-TL
  { grid: GRID_B, pos: '0% 100%' },   // 8: B-BL
  { grid: GRID_A, pos: '0% 0%' },     // 9: A-TL
  { grid: GRID_C, pos: '0% 100%' },   // 10: C-BL
  { grid: GRID_C, pos: '100% 100%' }, // 11: C-BR
];
---

<div id="tidewell-root" class="tw-root">
  <!-- Quick jump to portfolio/blog below -->
  <a href="#hub-section" id="tw-skip-btn" class="tw-skip-btn" title="跳过滚动动效，直达作品与博客">
    <span>直达精选内容</span>
    <span aria-hidden="true">↓</span>
  </a>

  <!-- STORY SECTION -->
  <section id="story" class="tw-story">
    <!-- 1. Hero Header (scrolls 1:1 with page) -->
    <header id="tw-hero" class="tw-hero">
      <div id="tw-headline-wrap" class="tw-headline-wrap" role="heading" aria-level="1" aria-label="Tides in Motion">
        <div id="tw-headline-group" class="tw-headline-group">
          <span id="tw-letters" class="tw-letters"></span>
          <span id="tw-icon-row" class="tw-icon-row"></span>
        </div>
      </div>

      <!-- Subtitle badge under hero headline -->
      <p id="tw-hero-sub" class="tw-hero-sub">
        磊大大の小栈 · AI 产品架构与创意动效实验室
      </p>

      <!-- Paper plane sprite -->
      <div
        id="tw-plane"
        class="tw-plane"
        style={`background-image:url('${STICKER_PLANE}');`}
        aria-hidden="true"
      ></div>
    </header>

    <!-- 2. Pinned Stage -->
    <div id="tw-stage" class="tw-stage">
      <!-- Process Headline Block (z 4) -->
      <div id="tw-process" class="tw-process">
        <div class="tw-process-h">
          <div class="tw-process-line">
            <span class="tw-pw tw-muted">From</span>
            <span class="tw-pw">shore</span>
            <span class="tw-pw tw-chip" style={`background-image:url('${GRID_C_CHIP}');background-size:200% 200%;background-position:100% 0%;`}></span>
            <span class="tw-pw tw-muted">to</span>
            <span class="tw-pw">product</span>
          </div>
          <div class="tw-process-line">
            <span class="tw-pw">built</span>
            <span class="tw-pw tw-muted">through</span>
            <span class="tw-pw">real</span>
            <span class="tw-pw">process</span>
          </div>
        </div>
        <p id="tw-process-sub" class="tw-process-sub">
          Turning AI concepts into working digital products · 磊大大 Larry
        </p>
        <a id="tw-process-cta" href="/portfolio" class="tw-cta">
          <span>View All Collections</span>
          <svg class="tw-arrow" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 8h10M9 4l4 4-4 4" />
          </svg>
        </a>
      </div>

      <!-- 12 Art Cards Layer (z 2) -->
      <div id="tw-cards" class="tw-cards">
        {cardDefs.map((c, idx) => (
          <div
            class="tw-card"
            data-idx={idx}
            style={`background-image:url('${c.grid}');background-size:200% 200%;background-position:${c.pos};`}
          />
        ))}
      </div>

      <!-- Dawn Sky Panel + Cloud Video + 3D Camera (z 6) -->
      <div id="tw-sky" class="tw-sky">
        <div class="tw-sky-plate" style={`background-image:url('${SKY_PLATE}');`}></div>
        <video
          id="tw-sky-video"
          class="tw-sky-video"
          src={SKY_VIDEO}
          muted
          loop
          playsinline
          preload="metadata"
        ></video>
        <div class="tw-sky-veil"></div>

        <div id="tw-camera-wrap" class="tw-camera-wrap">
          <div
            id="tw-camera"
            class="tw-camera"
            style={`background-image:url('${CAMERA_IMG}');`}
          ></div>
        </div>

        <div class="tw-sky-words tw-sky-tl">
          <span class="tw-sw tw-sky-grey">Not</span>
          <span class="tw-sw tw-sky-grey">just</span>
          <span class="tw-sw">visuals</span>
        </div>
        <div class="tw-sky-words tw-sky-br">
          <span class="tw-sw">Real</span>
          <span class="tw-sw tw-sky-grey">products</span>
          <span class="tw-sw">that</span>
          <span class="tw-sw tw-sky-grey">run</span>
        </div>
      </div>

      <!-- Blackout Layer (z 8) -->
      <div id="tw-blackout" class="tw-blackout"></div>
    </div>
  </section>

  <!-- MANIFESTO SECTION (Dark Horizontal Scroll) -->
  <section id="manifesto" class="tw-manifesto">
    <div class="tw-manifesto-stage">
      <div id="tw-m-track" class="tw-m-track">
        <!-- 1. Intro Block -->
        <div class="tw-m-intro tw-m-item">
          <span class="tw-sticker-sm" style="background:#EFCEBE;top:-.95em;left:0;--rot:-6deg;">motion studio</span>
          <span class="tw-sticker-sm" style="background:#EBC9AE;top:-1.1em;left:3.4em;--rot:-4deg;">since 2024</span>
          <span class="tw-sticker-sm" style="background:#BAD9E6;bottom:-1em;left:.6em;--rot:4deg;">coast to coast</span>
          <div class="tw-m-intro-row">
            <span class="tw-mw tw-mgrey" data-reveal>Designing</span>
            <span class="tw-mw" data-reveal>motion</span>
          </div>
          <div class="tw-m-intro-row">
            <span class="tw-mw" data-reveal>that</span>
            <span class="tw-mw" data-reveal>moves</span>
            <span class="tw-mw tw-mgrey" data-reveal>people.</span>
          </div>
        </div>

        <!-- 2. Conch -->
        <div class="tw-m-obj tw-m-item" style="width:1.25em;height:1.25em;--rot:-12deg;background-image:url('${STICKER_SHEET}');background-size:311.5% 332.2%;background-position:16.05% 17.31%;" data-reveal-obj></div>

        <!-- 3. Crafting -->
        <span class="tw-mw tw-mgrey tw-m-item" data-reveal>Crafting</span>

        <!-- 4. Vertical stack -->
        <div class="tw-m-vstack tw-m-item">
          <span class="tw-sticker-lg" style="background:#DDAD95;--rot:-8deg;" data-reveal-obj>
            AI · PMOS
            <span class="tw-dot"></span>
          </span>
          <span class="tw-sticker-sm-inline" style="background:#B0AEC6;--rot:6deg;" data-reveal-obj>and immersive</span>
        </div>

        <!-- 5. animation experiences. -->
        <span class="tw-mw tw-mgrey tw-m-item" data-reveal>animation</span>
        <span class="tw-mw tw-m-item" data-reveal>experiences.</span>

        <!-- 6. Sparkle + Pearl -->
        <svg class="tw-sparkle tw-m-item" viewBox="0 0 20 20" data-reveal-obj>
          <path d="M10 0c.8 5.6 3.6 8.6 10 10-6.4 1.4-9.2 4.4-10 10-.8-5.6-3.6-8.6-10-10 6.4-1.4 9.2-4.4 10-10z" fill="#F4E3D3" />
        </svg>
        <div class="tw-m-obj tw-m-item" style="width:.8em;height:.8em;--rot:0deg;background-image:url('${STICKER_SHEET}');background-size:420.2% 411.5%;background-position:82.02% 20.08%;" data-reveal-obj></div>

        <!-- 7. The ocean - is a -->
        <span class="tw-mw tw-m-item" data-reveal>The</span>
        <span class="tw-mw tw-m-item" data-reveal>ocean</span>
        <span class="tw-mw tw-mgrey tw-m-item" data-reveal>–</span>
        <span class="tw-mw tw-mgrey tw-m-item" data-reveal>is</span>
        <span class="tw-mw tw-mgrey tw-m-item" data-reveal>a</span>

        <!-- 8. Stickers + Conch + Pearl + Sparkle -->
        <span class="tw-sticker-lg tw-m-item" style="background:#EFCEBE;--rot:-8deg;" data-reveal-obj>tidal</span>
        <div class="tw-m-obj tw-m-item" style="width:1.05em;height:1.05em;--rot:10deg;background-image:url('${STICKER_SHEET}');background-size:311.5% 332.2%;background-position:16.05% 17.31%;" data-reveal-obj></div>
        <div class="tw-m-obj tw-m-item" style="width:.5em;height:.5em;--rot:0deg;background-image:url('${STICKER_SHEET}');background-size:420.2% 411.5%;background-position:82.02% 20.08%;" data-reveal-obj></div>
        <svg class="tw-sparkle tw-m-item" viewBox="0 0 20 20" data-reveal-obj>
          <path d="M10 0c.8 5.6 3.6 8.6 10 10-6.4 1.4-9.2 4.4-10 10-.8-5.6-3.6-8.6-10-10 6.4-1.4 9.2-4.4 10-10z" fill="#F4E3D3" />
        </svg>
        <span class="tw-sticker-lg tw-m-item" style="background:#B0AEC6;--rot:3deg;" data-reveal-obj>93+ 动效</span>

        <!-- 9. and a drift + capsule -->
        <span class="tw-mw tw-mgrey tw-m-item" data-reveal>and</span>
        <span class="tw-mw tw-mgrey tw-m-item" data-reveal>a</span>
        <span class="tw-sticker-lg tw-m-item" style="background:#BAD9E6;--rot:-10deg;" data-reveal-obj>drift</span>
        <div class="tw-m-obj tw-m-item" style="width:1.05em;height:.44em;--rot:-8deg;background-image:url('${STICKER_SHEET}');background-size:308.6% 729.9%;background-position:13.9% 76.01%;" data-reveal-obj></div>

        <!-- 10. Closing phrase -->
        <span class="tw-mw tw-m-item" data-reveal>atelier</span>
        <span class="tw-mw tw-m-item" data-reveal>that</span>
        <span class="tw-mw tw-m-item" data-reveal>brings</span>
        <span class="tw-mw tw-m-item" data-reveal>brands,</span>
        <span class="tw-mw tw-m-item" data-reveal>stories,</span>
        <span class="tw-mw tw-mgrey tw-m-item" data-reveal>and</span>
        <span class="tw-mw tw-m-item" data-reveal>experiences</span>
        <span class="tw-mw tw-mgrey tw-m-item" data-reveal>to</span>
        <span class="tw-mw tw-mgrey tw-m-item" data-reveal>life</span>
        <span class="tw-mw tw-mgrey tw-m-item" data-reveal>through</span>
        <span class="tw-mw tw-m-item" data-reveal>art,</span>
        <span class="tw-mw tw-m-item" data-reveal>design,</span>
        <span class="tw-mw tw-mgrey tw-m-item" data-reveal>and</span>
        <span class="tw-mw tw-m-item" data-reveal>technology.</span>

        <div style="width:30vw;flex-shrink:0;"></div>
      </div>
    </div>
  </section>
</div>

<style is:global>
  @font-face {
    font-family: 'Inter';
    font-style: normal;
    font-weight: 100 900;
    font-display: swap;
    src: url('https://fonts.gstatic.com/s/inter/v20/UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa1ZL7.woff2') format('woff2');
  }

  :root {
    --tw-bg: #F1ECEA;
    --tw-ink: #1F2430;
    --tw-muted: #938B90;
    --tw-dark: #12141B;
    --tw-u: 1px;
    --tw-n: 1px;
    --tw-hfs: 80px;
    --tw-ic: 50px;
    --tw-pfs: 46px;
    --tw-sfs: 56px;
    --tw-mfs: 68px;
    --tw-camw: 260px;
  }

  .tw-root {
    position: relative;
    font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
    font-weight: 500;
    background: var(--tw-bg);
    color: var(--tw-ink);
  }

  .tw-skip-btn {
    position: fixed;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 45;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.55rem 0.95rem;
    border-radius: 9999px;
    background: rgba(31, 36, 48, 0.85);
    color: #F1ECEA;
    font-size: 12px;
    font-weight: 600;
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: 0 10px 25px rgba(0, 0, 0, 0.22);
    transition: transform 0.2s ease, opacity 0.25s ease, background 0.2s ease;
  }
  .tw-skip-btn:hover {
    transform: translateY(-2px);
    background: #2E3546;
  }

  .tw-story {
    position: relative;
    height: 820vh;
    background: var(--tw-bg);
  }

  .tw-hero {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    z-index: 9;
    pointer-events: none;
  }

  .tw-headline-wrap {
    position: absolute;
    top: 41%;
    left: 0;
    right: 0;
    height: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: var(--tw-hfs);
    font-weight: 560;
    letter-spacing: -0.035em;
    line-height: 1;
    color: var(--tw-ink);
  }

  .tw-headline-group {
    display: inline-flex;
    align-items: center;
    white-space: nowrap;
    transition: transform 0.22s cubic-bezier(0.25, 0.75, 0.2, 1);
  }

  .tw-letters {
    display: inline-flex;
    align-items: baseline;
  }

  .tw-ch {
    display: inline-block;
    clip-path: inset(0 100% 0 0);
    opacity: 0;
  }

  .tw-icon-row {
    display: inline-flex;
    align-items: center;
    gap: calc(var(--tw-ic) * 0.2);
    margin-left: calc(var(--tw-ic) * 0.32);
  }

  .tw-px-icon {
    width: var(--tw-ic);
    height: var(--tw-ic);
    flex-shrink: 0;
    opacity: 0;
    transform: scale(0.4);
  }

  .tw-hero-sub {
    position: absolute;
    top: calc(41% + var(--tw-hfs) * 0.76);
    left: 50%;
    transform: translateX(-50%);
    font-size: clamp(12px, 1.1vw, 15px);
    color: #5B5A62;
    letter-spacing: 0.06em;
    white-space: nowrap;
    opacity: 0;
    transition: opacity 0.6s ease;
  }

  .tw-plane {
    position: fixed;
    top: 0;
    left: 0;
    width: calc(var(--tw-u) * 62);
    height: calc(var(--tw-u) * 62);
    background-size: 336.7% 492.6%;
    background-position: 84.5% 77%;
    pointer-events: none;
    z-index: 20;
    opacity: 0;
    will-change: transform, opacity;
  }

  .tw-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    height: 100svh;
    overflow: hidden;
    background: var(--tw-bg);
  }

  .tw-process {
    position: absolute;
    top: 20%;
    left: 0;
    right: 0;
    z-index: 4;
    padding: 0 16px;
    text-align: center;
    opacity: 0;
    pointer-events: none;
  }
  .tw-process.is-visible {
    pointer-events: auto;
  }

  .tw-process-h {
    font-size: var(--tw-pfs);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: var(--tw-ink);
  }

  .tw-process-line {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.24em;
  }

  .tw-pw {
    display: inline-block;
    opacity: 0;
    transform: translateY(0.35em);
    filter: blur(6px);
  }
  .tw-muted {
    color: var(--tw-muted);
  }

  .tw-chip {
    width: 1.05em;
    height: 0.92em;
    border-radius: 0.16em;
    vertical-align: -0.12em;
    margin: 0 0.14em;
    box-shadow: 0 0.06em 0.18em rgba(31, 36, 48, 0.18);
  }

  .tw-process-sub {
    margin-top: calc(var(--tw-pfs) * 0.42);
    font-size: calc(var(--tw-pfs) * 0.27);
    font-weight: 400;
    color: #5B5A62;
    opacity: 0;
    transform: translateY(8px);
  }

  .tw-cta {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    height: calc(var(--tw-pfs) * 0.64);
    font-size: calc(var(--tw-pfs) * 0.25);
    padding: 0 calc(var(--tw-pfs) * 0.28) 0 calc(var(--tw-pfs) * 0.32);
    border-radius: calc(var(--tw-pfs) * 0.2);
    margin-top: calc(var(--tw-pfs) * 0.38);
    background: var(--tw-ink);
    color: var(--tw-bg);
    font-weight: 500;
    opacity: 0;
    transform: translateY(8px);
    transition: background 0.2s ease;
  }
  .tw-cta:hover {
    background: #2E3546;
  }
  .tw-arrow {
    width: 1.05em;
    height: 1.05em;
  }

  .tw-cards {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    --cw: 200;
  }

  .tw-card {
    position: absolute;
    left: 0;
    top: 0;
    width: calc(var(--cw) * 1px);
    height: calc(var(--cw) * 1.32px);
    margin-left: calc(var(--cw) * -0.5px);
    margin-top: calc(var(--cw) * -0.66px);
    border-radius: calc(var(--cw) * 0.075px);
    box-shadow:
      0 calc(var(--cw) * 0.03px) calc(var(--cw) * 0.09px) rgba(31, 36, 48, 0.16),
      inset 0 0 0 1px rgba(255, 255, 255, 0.35);
    will-change: transform, opacity;
    opacity: 0;
  }

  .tw-sky {
    position: absolute;
    inset: 0;
    z-index: 6;
    overflow: hidden;
    clip-path: inset(38% 41% 42% 41% round 14px);
    opacity: 0;
    pointer-events: none;
  }

  .tw-sky-plate,
  .tw-sky-video {
    position: absolute;
    left: -4%;
    top: -4%;
    width: 108%;
    height: 108%;
    object-fit: cover;
    background-size: cover;
    background-position: center;
    will-change: transform;
  }
  .tw-sky-video {
    opacity: 0;
    transition: opacity 1.2s ease;
  }
  .tw-sky-video.is-playing {
    opacity: 0.78;
  }
  .tw-sky-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(192, 201, 217, 0.14), rgba(239, 206, 190, 0.14));
  }

  .tw-camera-wrap {
    position: absolute;
    left: 50%;
    top: 51%;
    transform: translate(-50%, -50%);
    width: var(--tw-camw);
    perspective: 900px;
    will-change: transform;
  }

  .tw-camera {
    width: 100%;
    aspect-ratio: 1.094;
    background-size: 136.8% 149.7%;
    background-position: 55% 42.5%;
    filter: drop-shadow(0 calc(var(--tw-camw) * 0.12) calc(var(--tw-camw) * 0.08) rgba(60, 52, 70, 0.22));
    transform-origin: 54% 31%;
    will-change: transform;
  }

  .tw-sky-words {
    position: absolute;
    font-size: var(--tw-sfs);
    font-weight: 500;
    letter-spacing: -0.03em;
    line-height: 1.05;
    color: var(--tw-ink);
    display: flex;
    gap: 0.24em;
    flex-wrap: wrap;
  }
  .tw-sky-tl {
    left: calc(var(--tw-n) * 40);
    top: calc(var(--tw-n) * 104);
  }
  .tw-sky-br {
    right: calc(var(--tw-n) * 40);
    bottom: calc(var(--tw-n) * 46);
    justify-content: flex-end;
  }
  .tw-sky-grey {
    color: #8D8893;
  }
  .tw-sw {
    display: inline-block;
    opacity: 0;
    transform: translateY(0.3em);
    filter: blur(6px);
  }

  .tw-blackout {
    position: absolute;
    inset: 0;
    z-index: 8;
    background: var(--tw-dark);
    opacity: 0;
    pointer-events: none;
  }

  /* MANIFESTO SECTION */
  .tw-manifesto {
    position: relative;
    height: 420vh;
    background: var(--tw-dark);
    color: #fff;
  }

  .tw-manifesto-stage {
    position: sticky;
    top: 0;
    height: 100vh;
    overflow: hidden;
  }

  .tw-m-track {
    position: absolute;
    left: 0;
    top: 50%;
    transform: translate3d(0, -50%, 0);
    display: flex;
    align-items: center;
    gap: calc(var(--tw-mfs) * 0.32);
    white-space: nowrap;
    font-size: var(--tw-mfs);
    font-weight: 500;
    letter-spacing: -0.03em;
    color: #fff;
    will-change: transform;
  }

  .tw-m-intro {
    position: relative;
    font-size: 0.72em;
    display: flex;
    flex-direction: column;
    gap: 0.26em;
    margin-right: 0.35em;
  }
  .tw-m-intro-row {
    display: flex;
    align-items: baseline;
    gap: 0.25em;
  }

  .tw-mgrey {
    color: #6E7180;
  }

  .tw-mw {
    display: inline-flex;
  }
  .tw-mc {
    display: inline-block;
    opacity: 0;
    transform: translateY(0.55em) rotate(14deg);
    transform-origin: bottom left;
  }

  .tw-sticker-sm {
    position: absolute;
    font-size: calc(var(--tw-mfs) * 0.24);
    padding: 0.3em 0.6em;
    border-radius: 0.16em;
    color: var(--tw-ink);
    font-weight: 600;
    line-height: 1.1;
    box-shadow: 0 0.12em 0.3em rgba(0, 0, 0, 0.35);
    transform: rotate(var(--rot, 0deg));
  }

  .tw-sticker-sm-inline {
    display: inline-block;
    font-size: calc(var(--tw-mfs) * 0.24);
    padding: 0.3em 0.6em;
    border-radius: 0.16em;
    color: var(--tw-ink);
    font-weight: 600;
    line-height: 1.1;
    box-shadow: 0 0.12em 0.3em rgba(0, 0, 0, 0.35);
    opacity: 0;
    transform: scale(0) rotate(-14deg);
  }

  .tw-sticker-lg {
    position: relative;
    display: inline-block;
    font-size: calc(var(--tw-mfs) * 0.42);
    padding: 0.28em 0.62em 0.3em;
    border-radius: 0.16em;
    color: var(--tw-ink);
    font-weight: 600;
    line-height: 1.1;
    box-shadow: 0 0.12em 0.3em rgba(0, 0, 0, 0.35);
    opacity: 0;
    transform: scale(0) rotate(-14deg);
  }

  .tw-dot {
    position: absolute;
    top: -0.18em;
    right: -0.18em;
    width: 0.32em;
    height: 0.32em;
    border-radius: 50%;
    background: var(--tw-ink);
  }

  .tw-m-vstack {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.16em;
  }

  .tw-m-obj {
    flex-shrink: 0;
    opacity: 0;
    transform: scale(0) rotate(-14deg);
  }

  .tw-sparkle {
    width: 0.34em;
    height: 0.34em;
    flex-shrink: 0;
    opacity: 0;
    transform: scale(0) rotate(-14deg);
  }

  @media (max-width: 819px) {
    .tw-process {
      top: 17%;
    }
    .tw-sky-tl {
      left: 16px;
      top: 84px;
    }
    .tw-sky-br {
      right: 16px;
      bottom: 28px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tw-story,
    .tw-manifesto {
      height: auto !important;
    }
    .tw-stage,
    .tw-manifesto-stage {
      position: relative !important;
      height: 100vh;
    }
    .tw-plane {
      display: none !important;
    }
  }
</style>

<script is:inline>
  (() => {
    const PIXEL_ICONS = [
      // plane
      ['........k','......kkb','....kkwkb','..kkwwkb.','kkwwwkbb.','..kkkbb..','....kb...','....k....','.........'],
      // shell
      ['...kkk...','..kbwbk..','.kbwbwbk.','kbwbwbwbk','kwbwbwbwk','.kbwbwbk.','..kbbbk..','...kkk...','.........'],
      // boat
      ['....k....','....kb...','....kbb..','...wkbbb.','..wwkbbb.','....k....','kkkkkkkkk','.kpppppk.','..kkkkk..'],
      // lighthouse
      ['...kkk...','..kbbbk..','...kwk...','...kbk...','...kwk...','...kbk...','..kwwwk..','..kbbbk..','.kkkkkkk.'],
      // fish
      ['.........','...kkk..k','..kbbbkkk','.kbwbbbbk','kbbbbbkkk','.kbbbbk.k','..kkkk...','.........','.........'],
      // wave
      ['.........','...kkk...','..kbbbk..','.kbwwbbk.','kbw..kbbk','kb....kbk','bbbbbbbbb','kkkkkkkkk','.........'],
      // sun
      ['....p....','.p..k..p.','...kpk...','..kpppk..','pkpppppkp','..kpppk..','...kpk...','.p..k..p.','....p....'],
    ];
    const PALETTE = { k: '#1F2430', b: '#7DA3BB', w: '#FFFFFF', p: '#DDAD95' };

    const clamp = (v, a, b) => Math.max(a, Math.min(b, v));
    const lerp = (a, b, t) => a + (b - a) * t;
    const eOutCubic = (t) => 1 - Math.pow(1 - t, 3);
    const eInOutCubic = (t) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
    const eBackOut = (t, s = 1.15) => {
      const u = t - 1;
      return 1 + (s + 1) * u * u * u + s * u * u;
    };

    function catmullRom(pts, t) {
      for (let i = 0; i < pts.length - 1; i++) {
        if (t <= pts[i + 1][0] || i === pts.length - 2) {
          const p0 = pts[Math.max(0, i - 1)];
          const p1 = pts[i];
          const p2 = pts[i + 1];
          const p3 = pts[Math.min(pts.length - 1, i + 2)];
          const span = Math.max(0.0001, p2[0] - p1[0]);
          const u = clamp((t - p1[0]) / span, 0, 1);
          const u2 = u * u, u3 = u2 * u;
          const x = 0.5 * ((2 * p1[1]) + (-p0[1] + p2[1]) * u + (2 * p0[1] - 5 * p1[1] + 4 * p2[1] - p3[1]) * u2 + (-p0[1] + 3 * p1[1] - 3 * p2[1] + p3[1]) * u3);
          const y = 0.5 * ((2 * p1[2]) + (-p0[2] + p2[2]) * u + (2 * p0[2] - 5 * p1[2] + 4 * p2[2] - p3[2]) * u2 + (-p0[2] + 3 * p1[2] - 3 * p2[2] + p3[2]) * u3);
          return [x, y];
        }
      }
      return [pts[pts.length - 1][1], pts[pts.length - 1][2]];
    }

    let cleanupFn = null;

    function initTidewell() {
      if (cleanupFn) cleanupFn();
      const root = document.getElementById('tidewell-root');
      if (!root) return;

      const story = document.getElementById('story');
      const hero = document.getElementById('tw-hero');
      const headlineWrap = document.getElementById('tw-headline-wrap');
      const lettersEl = document.getElementById('tw-letters');
      const iconRow = document.getElementById('tw-icon-row');
      const heroSub = document.getElementById('tw-hero-sub');
      const planeEl = document.getElementById('tw-plane');
      const processEl = document.getElementById('tw-process');
      const processSub = document.getElementById('tw-process-sub');
      const processCta = document.getElementById('tw-process-cta');
      const cardsWrap = document.getElementById('tw-cards');
      const cardEls = Array.from(cardsWrap.querySelectorAll('.tw-card'));
      const skyEl = document.getElementById('tw-sky');
      const skyPlate = skyEl.querySelector('.tw-sky-plate');
      const skyVideo = document.getElementById('tw-sky-video');
      const camWrap = document.getElementById('tw-camera-wrap');
      const camEl = document.getElementById('tw-camera');
      const blackoutEl = document.getElementById('tw-blackout');
      const manifesto = document.getElementById('manifesto');
      const mTrack = document.getElementById('tw-m-track');
      const skipBtn = document.getElementById('tw-skip-btn');

      const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // Build headline chars ("Tides in Motion")
      const HEADLINE = 'Tides in Motion';
      lettersEl.innerHTML = '';
      const charSpans = [];
      for (const ch of HEADLINE) {
        const sp = document.createElement('span');
        sp.className = 'tw-ch';
        sp.innerHTML = ch === ' ' ? '&nbsp;' : ch;
        lettersEl.appendChild(sp);
        charSpans.push(sp);
      }

      // Build 7 pixel icons
      iconRow.innerHTML = '';
      const iconEls = PIXEL_ICONS.map((rows) => {
        const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
        svg.setAttribute('viewBox', '0 0 9 9');
        svg.setAttribute('shape-rendering', 'crispEdges');
        svg.setAttribute('class', 'tw-px-icon');
        rows.forEach((row, y) => {
          for (let x = 0; x < 9; x++) {
            const c = row[x];
            if (c !== '.' && PALETTE[c]) {
              const r = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
              r.setAttribute('x', x);
              r.setAttribute('y', y);
              r.setAttribute('width', '1.02');
              r.setAttribute('height', '1.02');
              r.setAttribute('fill', PALETTE[c]);
              svg.appendChild(r);
            }
          }
        });
        iconRow.appendChild(svg);
        return svg;
      });

      // Split manifesto words into character spans
      const mWords = Array.from(mTrack.querySelectorAll('.tw-mw'));
      mWords.forEach((wEl) => {
        if (wEl.dataset.split) return;
        wEl.dataset.split = '1';
        const txt = wEl.textContent || '';
        wEl.textContent = '';
        for (const c of txt) {
          const s = document.createElement('span');
          s.className = 'tw-mc';
          s.textContent = c;
          wEl.appendChild(s);
        }
      });

      // Layout sizing
      let W = window.innerWidth;
      let H = window.innerHeight;
      let isMobile = false;
      let cw = 200;
      let nUnit = 1;
      let hfs = 80;

      function applySizes() {
        W = window.innerWidth;
        H = window.innerHeight;
        isMobile = W < 820 && W < H * 1.1;
        const u = Math.min(W / 1440, H / 800);
        nUnit = isMobile ? Math.min(1, W / 560) : clamp(W / 1440, 0.62, 1.25);
        hfs = isMobile ? Math.min(W * 0.12, H * 0.09) : Math.min(W * 0.074, H * 0.135);
        const ic = hfs * 0.62;
        const pfs = isMobile ? Math.min(W * 0.085, 40) : Math.min(W * 0.0335, H * 0.062);
        const sfs = isMobile ? Math.min(W * 0.09, 44) : Math.min(W * 0.042, H * 0.078);
        const mfs = isMobile ? Math.min(W * 0.11, H * 0.075) : Math.min(W * 0.05, H * 0.1);
        const camw = isMobile ? Math.min(W * 0.62, H * 0.34) : Math.min(W * 0.19, H * 0.36);
        cw = isMobile ? Math.min(W * 0.3, H * 0.2) : Math.min(W / 1440, H / 780) * 218;

        const rs = document.documentElement.style;
        rs.setProperty('--tw-u', u + 'px');
        rs.setProperty('--tw-n', nUnit + 'px');
        rs.setProperty('--tw-hfs', hfs + 'px');
        rs.setProperty('--tw-ic', ic + 'px');
        rs.setProperty('--tw-pfs', pfs + 'px');
        rs.setProperty('--tw-sfs', sfs + 'px');
        rs.setProperty('--tw-mfs', mfs + 'px');
        rs.setProperty('--tw-camw', camw + 'px');
        cardsWrap.style.setProperty('--cw', cw.toFixed(1));
      }
      applySizes();

      // Card Pose Calculators [x, y, rotDeg, scale, opacity]
      const stepAngle = (R) => 2 * Math.asin(clamp((1.05 * cw) / (2 * R), -0.99, 0.99)) * (180 / Math.PI);

      function getFanPose(i) {
        if (i >= 6) return [W * 0.5, H * 1.4, 0, 1, 0];
        const R = isMobile ? W * 1.35 : (1250 * W) / 1440;
        const th = (i - 2.5) * stepAngle(R);
        const rad = (th * Math.PI) / 180;
        const cx = isMobile ? W * 0.5 : W * 0.55;
        const cy = H * 0.86 + R;
        const x = cx + R * Math.sin(rad) - (isMobile ? 0 : W * 0.02);
        const y = cy - R * Math.cos(rad) + (isMobile ? cw * 0.2 : 0);
        return [x, y, th, 1, 1];
      }

      const SCATTER_DESK = [
        [0.08, 0.46, -20], [0.20, 0.86, -12], [0.80, 0.84, 14],
        [0.38, 1.04, -8],  [0.92, 0.42, 16],  [0.62, 1.04, 9],
      ];
      const SCATTER_MOB = [
        [0.06, 0.60, -20], [0.45, 0.66, 12], [0.94, 0.60, 16],
        [0.22, 0.93, -14], [0.72, 0.96, 9],  [0.50, 1.30, 0],
      ];

      function getScatterPose(i) {
        if (i >= 6) return [W * 0.5, H * 1.4, 0, 1, 0];
        const arr = isMobile ? SCATTER_MOB : SCATTER_DESK;
        let [fx, fy, rot] = arr[i];
        if (H < 500 && fy < 0.1) fy += 0.08;
        return [W * fx, H * fy, rot, 1, 1];
      }

      function getPilePose(i) {
        const x = W * 0.5 + ((i % 3) - 1) * cw * 0.08;
        const y = H * 0.62 + (((i * 7) % 5) - 2) * cw * 0.04;
        const rot = (i % 2 === 0 ? 1 : -1) * (4 + i * 1.3);
        return [x, y, rot, 1, 1];
      }

      function getWheelPose(i, rotSlots) {
        const R = isMobile ? W * 1.2 : (900 * W) / 1440;
        const slot = ((i + rotSlots + 120) % 12) - 5.5;
        const angle = slot * stepAngle(R);
        const rad = (angle * Math.PI) / 180;
        const cx = W * 0.5;
        const cy = (isMobile ? H * 0.76 : H * 0.82) + R;
        const x = cx + R * Math.sin(rad);
        const y = cy - R * Math.cos(rad);
        const vis = Math.abs(angle) < 62 ? 1 : 0;
        return [x, y, angle, 1, vis];
      }

      // Current displayed card poses for per-card inertia
      const currCards = cardEls.map((_, i) => [...getFanPose(i)]);

      // Plane Catmull-Rom waypoints [t, x%, y%]
      const PLANE_PTS = [
        [0.33, -3, 73], [0.45, 4, 71], [0.60, 13, 65], [0.70, 22, 55],
        [0.80, 31, 44], [0.87, 32.5, 47.5], [0.93, 26, 48], [1.00, 21.5, 45],
        [1.07, 22.5, 51.5], [1.15, 27, 52], [1.27, 36, 41],
      ];

      const HERO_ORDER = [5, 2, 0, 1, 3, 4];
      const HERO_STARTS = [0.53, 0.60, 0.63, 0.70, 0.80, 0.86];

      let processRevealed = false;
      let processRevealStart = 0;
      let skyWordsRevealed = false;
      let skyWordsStart = 0;
      let skyProgDisp = 0;
      let videoStarted = false;

      const processWords = Array.from(processEl.querySelectorAll('.tw-pw'));
      const skyWords = Array.from(skyEl.querySelectorAll('.tw-sw'));

      // Smooth scrolling state (desktop fine pointer)
      const isFinePointer = window.matchMedia('(pointer: fine)').matches;
      let ty = window.scrollY;
      let sy = window.scrollY;
      let lastWheelAt = 0;

      const onWheel = (e) => {
        if (reducedMotion || !isFinePointer) return;
        const dy = e.deltaMode === 1 ? e.deltaY * 32 : e.deltaY;
        ty = clamp(ty + dy * 0.75, 0, document.documentElement.scrollHeight - H);
        lastWheelAt = performance.now();
        window.scrollTo({ top: ty, behavior: 'instant' });
      };

      if (!reducedMotion && isFinePointer) {
        window.addEventListener('wheel', onWheel, { passive: true });
      }

      const startTime = performance.now();
      let lastFrame = startTime;
      let rafId = 0;

      const revealedManifesto = new Set();

      function tick(now) {
        const dt = Math.min(50, now - lastFrame);
        lastFrame = now;
        const t = reducedMotion ? 10 : (now - startTime) / 1000;

        // Smooth scroll catch-up
        if (!reducedMotion && isFinePointer) {
          if (now - lastWheelAt > 250) ty = window.scrollY;
          const sk = 1 - Math.pow(1 - 0.08, dt / 16.67);
          sy += (ty - sy) * sk;
        } else {
          sy = window.scrollY;
        }

        const storyTop = story.offsetTop;
        const storySpan = Math.max(1, story.offsetHeight - H);
        const p = clamp((sy - storyTop) / storySpan, 0, 1);

        // Toggle skip button visibility once past story/manifesto
        if (skipBtn) {
          const hub = document.getElementById('hub-section');
          const hubTop = hub ? hub.offsetTop : Infinity;
          skipBtn.style.opacity = sy > hubTop - H * 0.6 ? '0' : '1';
          skipBtn.style.pointerEvents = sy > hubTop - H * 0.6 ? 'none' : 'auto';
        }

        // 1. Load intro: Paper Plane + Icons -> Headline
        if (!reducedMotion) {
          if (t >= 0.33 && t <= 1.35) {
            planeEl.style.opacity = t > 1.27 ? String(clamp(1 - (t - 1.27) / 0.06, 0, 1)) : '1';
            const [px, py] = catmullRom(PLANE_PTS, Math.min(t, 1.27));
            const [nx, ny] = catmullRom(PLANE_PTS, Math.min(t + 0.015, 1.27));
            const ang = (Math.atan2((ny - py) * H, (nx - px) * W) * 180) / Math.PI + 18;
            const sc = t > 1.27 ? lerp(1, 0.6, (t - 1.27) / 0.06) : 1;
            planeEl.style.transform = `translate3d(${(px * W) / 100 - 30}px, ${(py * H) / 100 - 30}px, 0) rotate(${ang.toFixed(1)}deg) scale(${sc.toFixed(2)})`;
          } else {
            planeEl.style.opacity = '0';
          }

          // Icon-to-letter morph (1.9s -> ~5.2s)
          const stepIdx = t < 1.9 ? 0 : Math.min(HEADLINE.length, Math.floor((t - 1.9) / 0.22) + 1);
          const lettersLeft = HEADLINE.length - stepIdx;
          const iconsLeft = Math.ceil((7 * lettersLeft) / 13);

          charSpans.forEach((sp, idx) => {
            if (idx < stepIdx) {
              const charStart = 1.9 + idx * 0.22;
              const cp = clamp((t - charStart) / 0.2, 0, 1);
              const wipe = clamp((cp - 0.15) / 0.75, 0, 1);
              sp.style.opacity = '1';
              sp.style.clipPath = `inset(0 ${((1 - wipe) * 100).toFixed(1)}% 0 0)`;
            } else {
              sp.style.opacity = '0';
              sp.style.clipPath = 'inset(0 100% 0 0)';
            }
          });

          iconEls.forEach((icEl, j) => {
            const consumedCount = 7 - iconsLeft;
            if (j < consumedCount) {
              icEl.style.display = 'none';
            } else {
              icEl.style.display = 'block';
              if (j === 0) {
                if (t >= 1.27) {
                  const ip = clamp((t - 1.27) / 0.18, 0, 1);
                  icEl.style.opacity = String(ip);
                  icEl.style.transform = `scale(${eBackOut(ip).toFixed(3)})`;
                }
              } else {
                const startJ = 1.27 + 0.03 + j * 0.07;
                if (t >= startJ) {
                  const ip = clamp((t - startJ) / 0.32, 0, 1);
                  icEl.style.opacity = String(clamp((t - startJ) / 0.12, 0, 1));
                  icEl.style.transform = `scale(${eBackOut(ip).toFixed(3)})`;
                }
              }
            }
          });

          if (stepIdx >= HEADLINE.length && heroSub) {
            heroSub.style.opacity = '1';
          }
        } else {
          // Reduced motion immediate state
          charSpans.forEach((sp) => {
            sp.style.opacity = '1';
            sp.style.clipPath = 'none';
          });
          iconEls.forEach((ic) => (ic.style.display = 'none'));
          if (heroSub) heroSub.style.opacity = '1';
        }

        // Hero headline fade before hitting navbar
        const heroTopRect = headlineWrap.getBoundingClientRect().top;
        const fadeStart = 86 + 1.9 * hfs;
        const fadeEnd = 86 + 0.55 * hfs;
        hero.style.opacity = String(clamp((heroTopRect - fadeEnd) / Math.max(1, fadeStart - fadeEnd), 0, 1));

        // 2. Card poses across scroll phases
        let allSettled = true;
        cardEls.forEach((el, i) => {
          let target;
          if (p < 0.004) {
            target = getFanPose(i);
          } else if (p < 0.21) {
            const u = eInOutCubic(clamp((p - 0.004) / (0.085 - 0.004), 0, 1));
            const f = getFanPose(i);
            const s = getScatterPose(i);
            target = f.map((v, k) => lerp(v, s[k], u));
          } else if (p < 0.31) {
            const u = eInOutCubic(clamp((p - 0.21) / 0.1, 0, 1));
            const s = getScatterPose(i);
            const pl = getPilePose(i);
            target = s.map((v, k) => lerp(v, pl[k], u));
          } else if (p < 0.41) {
            const u = eInOutCubic(clamp((p - 0.31) / 0.1, 0, 1));
            const pl = getPilePose(i);
            const wh = getWheelPose(i, 0);
            target = pl.map((v, k) => lerp(v, wh[k], u));
          } else {
            const turn = eInOutCubic(clamp((p - 0.41) / 0.16, 0, 1));
            target = getWheelPose(i, -3 * turn);
          }

          // Hero card rise-up during load (p ≈ 0)
          if (!reducedMotion && p < 0.004 && i < 6) {
            const ordIdx = HERO_ORDER.indexOf(i);
            const startS = HERO_STARTS[ordIdx];
            if (t < startS) {
              target = [target[0], H + cw * 1.2, target[2] + 8, 1, 0];
            } else if (t < startS + 0.7) {
              const u = eBackOut((t - startS) / 0.7);
              target = [
                target[0],
                lerp(H + cw * 1.2, target[1], u),
                lerp(target[2] + 8, target[2], u),
                1,
                clamp((t - startS) / 0.15, 0, 1),
              ];
            }
          }

          const c = currCards[i];
          if (reducedMotion || p < 0.004) {
            for (let k = 0; k < 5; k++) c[k] = target[k];
          } else {
            const w = 0.055 + (i % 4) * 0.008;
            const k = 1 - Math.pow(1 - w, dt / 16.67);
            for (let m = 0; m < 5; m++) c[m] += (target[m] - c[m]) * k;
          }

          if (Math.abs(c[0] - target[0]) > 3 || Math.abs(c[1] - target[1]) > 3 || Math.abs(c[2] - target[2]) > 1) {
            allSettled = false;
          }

          el.style.transform = `translate3d(${c[0].toFixed(1)}px, ${c[1].toFixed(1)}px, 0) rotate(${c[2].toFixed(2)}deg) scale(${c[3].toFixed(3)})`;
          el.style.opacity = c[4].toFixed(3);
        });

        // 3. Process Headline reveal
        if (p < 0.05) {
          processEl.style.opacity = '0';
          processEl.classList.remove('is-visible');
          processRevealed = false;
          processWords.forEach((w) => {
            w.style.opacity = '0';
            w.style.transform = 'translateY(0.35em)';
            w.style.filter = 'blur(6px)';
          });
          processSub.style.opacity = '0';
          processCta.style.opacity = '0';
        } else {
          const procOp = p < 0.075 ? (p - 0.05) / 0.025 : p > 0.58 ? clamp(1 - (p - 0.58) / 0.06, 0, 1) : 1;
          processEl.style.opacity = String(procOp);
          if (procOp > 0.1) processEl.classList.add('is-visible');
          else processEl.classList.remove('is-visible');

          if (p > 0.078 && !processRevealed) {
            processRevealed = true;
            processRevealStart = now;
          }
          if (processRevealed) {
            const pt = (now - processRevealStart) / 1000;
            processWords.forEach((w, idx) => {
              const u = eOutCubic(clamp((pt - idx * 0.09) / 0.5, 0, 1));
              w.style.opacity = String(u);
              w.style.transform = `translateY(${((1 - u) * 0.35).toFixed(3)}em)`;
              w.style.filter = `blur(${((1 - u) * 6).toFixed(1)}px)`;
            });
            const su = eOutCubic(clamp((pt - 0.65) / 0.5, 0, 1));
            processSub.style.opacity = String(su);
            processSub.style.transform = `translateY(${((1 - su) * 8).toFixed(1)}px)`;
            const cu = eOutCubic(clamp((pt - 0.8) / 0.5, 0, 1));
            processCta.style.opacity = String(cu);
            processCta.style.transform = `translateY(${((1 - cu) * 8).toFixed(1)}px)`;
          }
        }

        // 4. Gated Dawn Sky Panel + Camera Yaw + Lens Zoom
        const rawSkyTarget = p >= 0.62 ? (allSettled || skyProgDisp > 0.02 ? clamp((p - 0.62) / 0.12, 0, 1) : 0) : 0;
        const skyK = 1 - Math.pow(1 - 0.09, dt / 16.67);
        skyProgDisp += (rawSkyTarget - skyProgDisp) * (reducedMotion ? 1 : skyK);
        const sp = eInOutCubic(clamp(skyProgDisp, 0, 1));

        if (sp > 0.01) {
          skyEl.style.opacity = String(clamp(sp * 3, 0, 1));
          const top0 = isMobile ? 36 : 28;
          const bot0 = isMobile ? 48 : 52;
          const side0 = isMobile ? 29 : 41.5;
          const insT = lerp(top0, 0, sp);
          const insB = lerp(bot0, 0, sp);
          const insS = lerp(side0, 0, sp);
          const rad = lerp(14, 0, sp);
          skyEl.style.clipPath = `inset(${insT.toFixed(2)}% ${insS.toFixed(2)}% ${insB.toFixed(2)}% ${insS.toFixed(2)}% round ${rad.toFixed(1)}px)`;

          const bgScale = lerp(1.18, 1, sp);
          skyPlate.style.transform = `scale(${bgScale.toFixed(3)})`;
          skyVideo.style.transform = `scale(${bgScale.toFixed(3)})`;

          if (!reducedMotion && !videoStarted && sp > 0.15) {
            videoStarted = true;
            skyVideo.playbackRate = 0.6;
            skyVideo.play().then(() => skyVideo.classList.add('is-playing')).catch(() => {});
          }

          // Camera scale, yaw & lens zoom
          const camBaseScale = lerp(0.5, 1, sp);
          const yawP = clamp((p - 0.74) / 0.14, 0, 1);
          const yawDeg = lerp(-10, 10, yawP);
          const bob = Math.sin(t * 1.6) * 6 * nUnit;

          const gateZoom = sp >= 0.9 ? clamp((sp - 0.9) / 0.1, 0, 1) : 0;
          const q = p >= 0.88 ? Math.pow(clamp((p - 0.88) / 0.09, 0, 1), 1.6) * gateZoom : 0;
          const zoomScale = 1 + q * q * 24;

          camWrap.style.transform = `translate(-50%, calc(-50% + ${bob.toFixed(1)}px)) scale(${camBaseScale.toFixed(3)})`;
          camEl.style.transform = `rotateY(${yawDeg.toFixed(2)}deg) scale(${zoomScale.toFixed(3)})`;

          // Sky words reveal when panel is full
          if (sp > 0.96 && !skyWordsRevealed) {
            skyWordsRevealed = true;
            skyWordsStart = now;
          }
          if (skyWordsRevealed) {
            const st = (now - skyWordsStart) / 1000;
            const delays = [0, 0.12, 0.24, 0.45, 0.57, 0.69, 0.81];
            skyWords.forEach((sw, idx) => {
              const u = eOutCubic(clamp((st - delays[idx]) / 0.6, 0, 1));
              sw.style.opacity = String(u);
              sw.style.transform = `translateY(${((1 - u) * 0.3).toFixed(3)}em)`;
              sw.style.filter = `blur(${((1 - u) * 6).toFixed(1)}px)`;
            });
          }

          // Blackout over lens zoom
          const blackOp = clamp((q - 0.45) / 0.4, 0, 1);
          blackoutEl.style.opacity = String(blackOp);
        } else {
          skyEl.style.opacity = '0';
          blackoutEl.style.opacity = '0';
        }

        // 5. Manifesto Horizontal Scroll
        const mTop = manifesto.offsetTop;
        const mSpan = Math.max(1, manifesto.offsetHeight - H);
        const mp = clamp((sy - mTop) / mSpan, 0, 1);
        const startX = isMobile ? W * 0.08 : W * 0.06;
        const endX = -(mTrack.scrollWidth - W * 0.9);
        const curX = lerp(startX, endX, mp);
        mTrack.style.transform = `translate3d(${curX.toFixed(1)}px, -50%, 0)`;

        // Reveal manifesto items as they enter viewport
        if (sy + H * 1.2 >= mTop) {
          const threshold = W * (isMobile ? 0.92 : 0.88);
          mTrack.querySelectorAll('[data-reveal]').forEach((el) => {
            if (revealedManifesto.has(el)) return;
            if (el.getBoundingClientRect().left <= threshold) {
              revealedManifesto.add(el);
              const chars = el.querySelectorAll('.tw-mc');
              chars.forEach((c, idx) => {
                c.style.transition = `opacity 0.5s cubic-bezier(0.22,1,0.36,1) ${idx * 35}ms, transform 0.5s cubic-bezier(0.22,1,0.36,1) ${idx * 35}ms`;
                c.style.opacity = '1';
                c.style.transform = 'translateY(0) rotate(0deg)';
              });
            }
          });
          mTrack.querySelectorAll('[data-reveal-obj]').forEach((el) => {
            if (revealedManifesto.has(el)) return;
            if (el.getBoundingClientRect().left <= threshold) {
              revealedManifesto.add(el);
              el.style.transition = 'opacity 0.5s ease 120ms, transform 0.5s cubic-bezier(0.34,1.56,0.64,1) 120ms';
              el.style.opacity = '1';
              el.style.transform = 'scale(1) rotate(var(--rot, 0deg))';
            }
          });
        }

        rafId = requestAnimationFrame(tick);
      }

      rafId = requestAnimationFrame(tick);
      window.addEventListener('resize', applySizes);

      cleanupFn = () => {
        cancelAnimationFrame(rafId);
        window.removeEventListener('wheel', onWheel);
        window.removeEventListener('resize', applySizes);
      };
    }

    document.addEventListener('astro:page-load', initTidewell);
    document.addEventListener('astro:before-swap', () => {
      if (cleanupFn) cleanupFn();
    });
  })();
</script>
