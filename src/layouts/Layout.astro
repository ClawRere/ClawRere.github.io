---
import { ClientRouter } from 'astro:transitions';
import { NetEaseMusicPlayer } from '@/components/ui/NetEaseMusicPlayer';
import { HangingSideBoard } from '@/components/ui/HangingSideBoard';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  hideFooter?: boolean;
  fullWidth?: boolean;
  sideTitle?: string;
  watermarkTitle?: string;
}

const {
  title = '磊大大の小栈 | AI 产品经理与共创作品集',
  description = '以产品思维定义人机边界，以工程实践打磨 AI 生产力工具。面向 AI 协同时代的数字花园。',
  hideFooter = false,
  fullWidth = false,
  sideTitle,
  watermarkTitle,
} = Astro.props;

const currentPath = Astro.url.pathname;
const resolvedWatermark =
  watermarkTitle || sideTitle || (currentPath !== '/' ? title.split('|')[0].trim() : '');

const entertainItems = [
  { name: '音乐馆', href: '/entertain/music', emoji: '🎵' },
  { name: '壁纸图库', href: '/entertain/gallery', emoji: '🖼️' },
  { name: '93+ 特效实验室', href: '/effects', emoji: '✨' },
  { name: '烟花秀', href: '/entertain/fireworks', emoji: '🎆' },
  { name: '雨声院', href: '/entertain/rain', emoji: '🌧️' },
];
---

<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      window.__applySitePrefs = function () {
        try {
          var theme = localStorage.getItem('theme');
          if (theme === 'dark') document.documentElement.classList.add('dark');
          else if (theme === 'light') document.documentElement.classList.remove('dark');
          var bg = localStorage.getItem('blogbg');
          if (bg) {
            var p = JSON.parse(bg);
            if (p && p.value) {
              var cssVal = p.type === 'image' ? 'url("' + p.value + '") center/cover no-repeat' : p.value;
              document.documentElement.style.setProperty('--hero-bg', cssVal);
            }
          }
          var cs = localStorage.getItem('layout_card_scale');
          if (cs) document.documentElement.style.setProperty('--card-scale', cs);
          var ps = localStorage.getItem('layout_pill_scale');
          if (ps) document.documentElement.style.setProperty('--pill-scale', ps);
          var ph = localStorage.getItem('layout_pip_vh');
          if (ph) document.documentElement.style.setProperty('--pip-height', ph + 'vh');
          var accentRgb = localStorage.getItem('site_theme_accent_rgb');
          if (accentRgb) document.documentElement.style.setProperty('--theme-accent', accentRgb);
        } catch (e) {}
      };
      window.__applySitePrefs();
      document.addEventListener('astro:after-swap', () => {
        window.__applySitePrefs();
        if (window.__updateHeaderBg) window.__updateHeaderBg();
      });

      window.__updateHeaderBg = function () {
        var hdr = document.getElementById('site-header');
        if (!hdr) return;
        var isHome = hdr.dataset.home === 'true';
        var heroThreshold = isHome ? Math.max(360, (window.innerHeight || 760) * 0.72) : 24;
        var scrolled = window.scrollY > 24;
        var pastHero = window.scrollY > heroThreshold;

        if (scrolled) {
          if (isHome) {
            hdr.classList.add('bg-white/20', 'dark:bg-slate-800/40', 'backdrop-blur-xl', 'shadow-sm');
            hdr.classList.remove('bg-cream-50/96', 'dark:bg-[#232736]/94');
          } else {
            hdr.classList.add('bg-cream-50/96', 'dark:bg-[#232736]/94', 'backdrop-blur-md', 'shadow-sm');
            hdr.classList.remove('bg-white/20', 'dark:bg-slate-800/40', 'backdrop-blur-xl');
          }
          hdr.classList.remove('bg-transparent', 'bg-gradient-to-b', 'from-black/25', 'to-transparent');
        } else {
          hdr.classList.remove('bg-cream-50/96', 'dark:bg-[#232736]/94', 'bg-white/20', 'dark:bg-slate-800/40', 'backdrop-blur-xl', 'backdrop-blur-md', 'shadow-sm');
          if (isHome) {
            hdr.classList.add('bg-gradient-to-b', 'from-black/25', 'to-transparent');
          } else {
            hdr.classList.add('bg-transparent');
          }
        }

        if (isHome) {
          hdr.classList.add('at-home-top');
        } else {
          hdr.classList.remove('at-home-top');
        }
      };
      window.__updateWatermarkParallax = function () {
        var wm = document.querySelector('[data-parallax-watermark]');
        if (!wm) return;
        var y = Math.min(window.scrollY, 320);
        var opacity = Math.max(0, 1 - y / 220);
        wm.style.transform = 'translateY(' + Math.round(-y * 0.35) + 'px)';
        wm.style.opacity = String(opacity);
      };
      window.addEventListener('scroll', function () {
        window.__updateHeaderBg();
        window.__updateWatermarkParallax();
      }, { passive: true });
      window.__updateHeaderBg();
      window.__updateWatermarkParallax();

      // Watermark hover particle-dissolve effect
      window.__initWatermarkParticles = function () {
        var wm = document.querySelector('[data-parallax-watermark]');
        if (!wm || wm.dataset.wmBound) return;
        wm.dataset.wmBound = '1';
        var span = wm.querySelector('.wm-text');
        var canvas = wm.querySelector('.wm-canvas');
        if (!span || !canvas) return;
        var ctx = canvas.getContext('2d');
        var raf = 0, hovering = false, particles = [];

        function buildParticles() {
          var w = (canvas.width = wm.offsetWidth || 800);
          var h = (canvas.height = wm.offsetHeight || 120);
          ctx.clearRect(0, 0, w, h);
          var text = wm.dataset.wmText || span.textContent || '';
          var cs = window.getComputedStyle(span);
          ctx.font = (cs.fontWeight || '900') + ' ' + (cs.fontSize || '88px') + ' ' + (cs.fontFamily || 'system-ui, sans-serif');
          if ('letterSpacing' in ctx && cs.letterSpacing) {
            ctx.letterSpacing = cs.letterSpacing;
          }
          ctx.textAlign = 'center';
          ctx.textBaseline = 'alphabetic';
          var accentRaw = window.getComputedStyle(document.documentElement).getPropertyValue('--theme-accent').trim() || '217 119 87';
          var accentRgb = accentRaw.split(/\s+/).join(',');
          var grad = ctx.createLinearGradient(w * 0.25, 0, w * 0.75, 0);
          grad.addColorStop(0, 'rgba(' + accentRgb + ', 0.7)');
          grad.addColorStop(0.5, 'rgba(251, 113, 133, 0.65)');
          grad.addColorStop(1, 'rgba(253, 186, 116, 0.65)');
          ctx.fillStyle = grad;
          var spanRect = span.getBoundingClientRect();
          var wmRect = wm.getBoundingClientRect();
          var centerY = (spanRect.top - wmRect.top) + spanRect.height / 2;
          var tm = ctx.measureText(text);
          var ascent = tm.fontBoundingBoxAscent || tm.actualBoundingBoxAscent || (parseFloat(cs.fontSize) * 0.72);
          var descent = tm.fontBoundingBoxDescent || tm.actualBoundingBoxDescent || (parseFloat(cs.fontSize) * 0.18);
          var baselineY = centerY + (ascent - descent) / 2;
          ctx.fillText(text, w / 2, baselineY);

          var imgData = ctx.getImageData(0, 0, w, h).data;
          particles = [];
          var step = 4;
          var pCount = 0;
          for (var y = 0; y < h; y += step) {
            for (var x = 0; x < w; x += step) {
              var idx = (y * w + x) * 4;
              if (imgData[idx + 3] > 20) {
                pCount++;
                particles.push({
                  ox: x, oy: y, x: x, y: y,
                  vx: (Math.random() - 0.5) * 4.2,
                  vy: (Math.random() - 0.5) * 4.2 - 0.6,
                  alpha: 1,
                  keepFloating: pCount % 15 === 0,
                  phase: Math.random() * Math.PI * 2,
                  rgb: imgData[idx] + ',' + imgData[idx + 1] + ',' + imgData[idx + 2]
                });
              }
            }
          }
          ctx.clearRect(0, 0, w, h);
        }

        function tick() {
          ctx.clearRect(0, 0, canvas.width, canvas.height);
          var settled = true;
          var nowSec = performance.now() * 0.002;
          for (var i = 0; i < particles.length; i++) {
            var p = particles[i];
            if (hovering) {
              if (p.keepFloating) {
                p.x += Math.sin(nowSec + p.phase) * 0.45;
                p.y += Math.cos(nowSec * 0.9 + p.phase) * 0.35;
                p.alpha += (0.38 - p.alpha) * 0.08;
              } else {
                p.x += p.vx; p.y += p.vy;
                p.vx *= 0.988; p.vy *= 0.988;
                p.alpha = Math.max(0, p.alpha - 0.024);
              }
              settled = false;
            } else {
              p.x += (p.ox - p.x) * 0.16;
              p.y += (p.oy - p.y) * 0.16;
              p.alpha += (1 - p.alpha) * 0.14;
              if (Math.abs(p.ox - p.x) > 0.4 || Math.abs(p.oy - p.y) > 0.4 || p.alpha < 0.98) settled = false;
            }
            if (p.alpha > 0.01) {
              ctx.fillStyle = 'rgba(' + p.rgb + ',' + (p.alpha * 0.78).toFixed(3) + ')';
              ctx.fillRect(p.x, p.y, 3, 3);
            }
          }
          if (!settled) {
            raf = requestAnimationFrame(tick);
          } else {
            if (!hovering) {
              canvas.style.opacity = '0';
              span.style.opacity = '1';
            }
            raf = 0;
          }
        }

        wm.addEventListener('mouseenter', function () {
          hovering = true;
          buildParticles();
          span.style.opacity = '0';
          canvas.style.opacity = '1';
          if (!raf) raf = requestAnimationFrame(tick);
        });
        wm.addEventListener('mouseleave', function () {
          hovering = false;
          if (!raf) raf = requestAnimationFrame(tick);
        });
      };
      window.__initWatermarkParticles();
      document.addEventListener('astro:after-swap', window.__initWatermarkParticles);
    </script>
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col bg-cream-50 dark:bg-[#1c1f2b] text-charcoal-DEFAULT dark:text-cream-100 transition-colors duration-300 relative selection:bg-terracotta/20 selection:text-terracotta overflow-x-hidden">
    <!-- Top accent line -->
    <div class="fixed top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-terracotta/60 to-transparent z-50 pointer-events-none" />

    <!-- Global Page Loading Overlay (DeviceLoader) during View Transitions / initial ready -->
    <div
      id="page-loader-overlay"
      class="fixed inset-0 z-[100] bg-cream-50 dark:bg-obsidian flex flex-col items-center justify-center gap-3 text-terracotta transition-opacity duration-300 pointer-events-none opacity-0"
      aria-hidden="true"
    >
      <div class="device-loader">
        <div class="device__a"><div class="device__a-1"></div><div class="device__a-2"></div></div>
        <div class="device__b"></div><div class="device__c"></div><div class="device__d"></div>
        <div class="device__e"></div><div class="device__f"></div><div class="device__g"></div>
      </div>
      <span class="text-xs font-mono text-charcoal-100 dark:text-cream-400 tracking-widest">LOADING...</span>
    </div>

    <!-- Lightweight Ambient Hero Background (disabled in dark mode so images never look muddy/grey) -->
    <div class="fixed inset-0 pointer-events-none z-0 overflow-hidden dark:hidden" style="contain: strict;" aria-hidden="true">
      <div
        id="global-blurred-bg"
        class="w-full h-full opacity-20"
        style="background: var(--hero-bg, url('/img/starry-sky.jpg') center/cover no-repeat);"
      />
    </div>

    <!-- TOP NAVIGATION BAR (no bottom line, white text + subtle scrim over home hero, normal text below) -->
    <header
      id="site-header"
      data-home={currentPath === '/' ? 'true' : 'false'}
      class={`fixed top-0 left-0 right-0 z-40 transition-all duration-300 ${
        currentPath === '/' ? 'at-home-top bg-gradient-to-b from-black/25 to-transparent' : 'bg-transparent'
      }`}
    >
      <div class="max-w-7xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between gap-4">
        
        <!-- Logo: clean pure text -->
        <a href="/" class="font-serif font-bold text-base tracking-tight text-charcoal-DEFAULT dark:text-cream-50 hover:text-terracotta transition-colors shrink-0">
          磊大大の小栈
        </a>

        <!-- Center Navigation -->
        <nav class="hidden md:flex items-center gap-1 text-sm font-medium">
          <a href="/" class={`px-3 py-1.5 rounded-lg transition-colors ${currentPath === '/' ? 'text-terracotta bg-terracotta/8' : 'text-charcoal-200 dark:text-cream-300 hover:text-charcoal dark:hover:text-cream-50 hover:bg-black/5 dark:hover:bg-white/5'}`}>首页</a>
          <a href="/portfolio" class={`px-3 py-1.5 rounded-lg transition-colors ${currentPath.startsWith('/portfolio') ? 'text-terracotta bg-terracotta/8' : 'text-charcoal-200 dark:text-cream-300 hover:text-charcoal dark:hover:text-cream-50 hover:bg-black/5 dark:hover:bg-white/5'}`}>作品集</a>
          <a href="/posts" class={`px-3 py-1.5 rounded-lg transition-colors ${currentPath.startsWith('/posts') ? 'text-terracotta bg-terracotta/8' : 'text-charcoal-200 dark:text-cream-300 hover:text-charcoal dark:hover:text-cream-50 hover:bg-black/5 dark:hover:bg-white/5'}`}>博客</a>
          
          <!-- Entertainment hover dropdown -->
          <div class="relative group/entertain">
            <a href="/entertain" class={`px-3 py-1.5 rounded-lg transition-colors flex items-center gap-1 ${currentPath.startsWith('/entertain') || currentPath.startsWith('/effects') ? 'text-terracotta bg-terracotta/8' : 'text-charcoal-200 dark:text-cream-300 hover:text-charcoal dark:hover:text-cream-50 hover:bg-black/5 dark:hover:bg-white/5'}`}>
              娱乐馆
              <svg class="w-3 h-3 transition-transform group-hover/entertain:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            </a>
            <div class="absolute top-full left-1/2 -translate-x-1/2 mt-1 w-48 py-1.5 rounded-2xl bg-white dark:bg-zinc-900 border border-black/8 dark:border-white/10 shadow-2xl backdrop-blur-xl opacity-0 invisible group-hover/entertain:opacity-100 group-hover/entertain:visible transition-all duration-200 z-50">
              {entertainItems.map(item => (
                <a href={item.href} class="flex items-center gap-2.5 px-4 py-2 text-sm text-charcoal-200 dark:text-cream-300 hover:text-terracotta hover:bg-terracotta/5 transition-colors" target={item.href.endsWith('.html') ? '_blank' : undefined} rel={item.href.endsWith('.html') ? 'noopener' : undefined}>
                  <span>{item.emoji}</span>
                  <span>{item.name}</span>
                </a>
              ))}
            </div>
          </div>

          <a href="/tools" class={`px-3 py-1.5 rounded-lg transition-colors ${currentPath.startsWith('/tools') ? 'text-terracotta bg-terracotta/8' : 'text-charcoal-200 dark:text-cream-300 hover:text-charcoal dark:hover:text-cream-50 hover:bg-black/5 dark:hover:bg-white/5'}`}>工具箱</a>
          <a href="/links" class={`px-3 py-1.5 rounded-lg transition-colors ${currentPath.startsWith('/links') ? 'text-terracotta bg-terracotta/8' : 'text-charcoal-200 dark:text-cream-300 hover:text-charcoal dark:hover:text-cream-50 hover:bg-black/5 dark:hover:bg-white/5'}`}>友链</a>
          <a href="/about" class={`px-3 py-1.5 rounded-lg transition-colors ${currentPath.startsWith('/about') ? 'text-terracotta bg-terracotta/8' : 'text-charcoal-200 dark:text-cream-300 hover:text-charcoal dark:hover:text-cream-50 hover:bg-black/5 dark:hover:bg-white/5'}`}>关于</a>
        </nav>

        <!-- Right actions -->
        <div class="flex items-center gap-3 shrink-0">
          <!-- Theme Accent Color Switcher (click-friendly on mobile & desktop) -->
          <details id="palette-menu" class="relative">
            <summary
              class="list-none cursor-pointer p-2 rounded-full text-charcoal-100 dark:text-cream-300 hover:bg-black/5 dark:hover:bg-white/10 transition-colors flex items-center justify-center"
              title="切换网站主题色（Claude / Gemini / Codex / DeepSeek）"
              aria-label="切换网站主题色"
            >
              <span class="block w-4 h-4 rounded-full bg-terracotta ring-2 ring-white/85 dark:ring-zinc-800 shadow-sm" />
            </summary>
            <div class="palette-panel absolute top-full right-0 mt-2 w-48 p-2 rounded-2xl bg-white/95 dark:bg-zinc-900/95 backdrop-blur-xl border border-black/10 dark:border-white/15 shadow-2xl z-50 space-y-1 text-charcoal-800 dark:text-cream-100">
              <div class="px-2 py-1 text-[10px] font-mono uppercase tracking-wider text-charcoal-400 dark:text-cream-400">主题风格配色</div>
              {[
                { name: 'Claude 暖陶土', rgb: '217 119 87', hex: '#D97757' },
                { name: 'Gemini 幻彩蓝', rgb: '66 133 244', hex: '#4285F4' },
                { name: 'Codex 极客绿', rgb: '16 163 127', hex: '#10A37F' },
                { name: 'DeepSeek 智蓝', rgb: '37 99 235', hex: '#2563EB' },
                { name: '紫罗兰幻境', rgb: '139 92 246', hex: '#8B5CF6' },
              ].map((preset) => (
                <button
                  type="button"
                  onclick={`document.documentElement.style.setProperty('--theme-accent','${preset.rgb}');localStorage.setItem('site_theme_accent_rgb','${preset.rgb}');var pm=document.getElementById('palette-menu');if(pm)pm.removeAttribute('open');`}
                  class="w-full flex items-center gap-2 px-2.5 py-1.5 rounded-xl text-xs text-charcoal-800 dark:text-cream-100 hover:bg-black/5 dark:hover:bg-white/10 transition-colors text-left"
                >
                  <span class="w-3 h-3 rounded-full shrink-0" style={`background:${preset.hex}`} />
                  <span class="truncate">{preset.name}</span>
                </button>
              ))}
              <label class="w-full flex items-center justify-between px-2.5 py-1.5 rounded-xl text-xs text-charcoal-800 dark:text-cream-100 hover:bg-black/5 dark:hover:bg-white/10 cursor-pointer border-t border-black/8 dark:border-white/10 mt-1 pt-2">
                <span>自定义颜色</span>
                <input
                  type="color"
                  defaultValue="#D97757"
                  oninput="var h=this.value;var r=parseInt(h.slice(1,3),16)+' '+parseInt(h.slice(3,5),16)+' '+parseInt(h.slice(5,7),16);document.documentElement.style.setProperty('--theme-accent',r);localStorage.setItem('site_theme_accent_rgb',r);"
                  class="w-5 h-5 rounded cursor-pointer border-0 bg-transparent p-0"
                />
              </label>
            </div>
          </details>

          <button
            id="theme-toggle-btn"
            onclick="document.documentElement.classList.toggle('dark'); localStorage.setItem('theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light');"
            class="firefly-btn group/ff relative w-[56px] h-[28px] rounded-full bg-gradient-to-r from-sky-400 to-sky-500 dark:from-slate-800 dark:to-slate-900 border border-sky-300/70 dark:border-amber-300/35 shadow-inner transition-colors duration-500 overflow-visible shrink-0"
            title="切换日间（晴空太阳）/ 夜间模式（月亮萤火虫）"
            aria-label="切换日间/夜间模式"
          >
            {/* Inner clipped track for drifting cloud */}
            <span class="dark:hidden absolute inset-0 rounded-full overflow-hidden pointer-events-none" aria-hidden="true">
              <svg class="w-6 h-4 text-white/95 absolute right-1 top-1.5 animate-cloud-drift" viewBox="0 0 36 20" fill="currentColor">
                <path d="M9 17h18a5 5 0 0 0 .6-9.96A7 7 0 0 0 14.2 5.4 5.5 5.5 0 0 0 9 17z" />
              </svg>
            </span>
            {/* Snug Sliding Knob: Sun with Rotating Rays (Day) / Moon + Orbiting Fireflies (Night) */}
            <span class="absolute top-[2px] left-[2px] dark:left-[30px] w-[22px] h-[22px] rounded-full flex items-center justify-center transition-all duration-500 bg-white dark:bg-slate-800 shadow-[0_0_10px_rgba(251,191,36,0.9)] dark:shadow-[0_0_10px_rgba(253,224,71,0.55)]">
              {/* Fireflies orbiting directly around the Moon in dark mode */}
              <span class="ff-dot ff-dot-1" aria-hidden="true"></span>
              <span class="ff-dot ff-dot-2" aria-hidden="true"></span>
              <span class="ff-dot ff-dot-3" aria-hidden="true"></span>
              <span class="ff-dot ff-dot-4" aria-hidden="true"></span>
              {/* Rotating Sun with outward radiating rays */}
              <svg class="w-4 h-4 dark:hidden text-amber-400 relative z-10 animate-[spin_12s_linear_infinite]" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.2">
                <circle cx="12" cy="12" r="3.6" fill="currentColor" stroke="none" />
                <path stroke-linecap="round" d="M12 2.2v2.4M12 19.4v2.4M5.1 5.1l1.7 1.7M17.2 17.2l1.7 1.7M2.2 12h2.4M19.4 12h2.4M5.1 18.9l1.7-1.7M17.2 6.8l1.7-1.7" />
              </svg>
              {/* Moon */}
              <svg class="w-3.5 h-3.5 hidden dark:block text-amber-300 relative z-10" fill="currentColor" viewBox="0 0 24 24">
                <path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z" />
              </svg>
            </span>
          </button>
          <a href="/messageboard" class="hidden sm:inline-flex items-center px-3 py-1.5 rounded-lg text-xs font-medium text-charcoal-100 dark:text-cream-400 hover:text-terracotta transition-colors">
            留言
          </a>

          <!-- Mobile hamburger -->
          <details id="mobile-nav-menu" class="md:hidden relative">
            <summary class="list-none cursor-pointer p-2 rounded-xl hover:bg-black/5 dark:hover:bg-white/10 transition-colors text-charcoal-200 dark:text-cream-300">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
            </summary>
            <div class="mobile-nav-panel absolute top-full right-0 mt-2.5 w-56 p-2 rounded-2xl bg-white/95 dark:bg-zinc-900/95 border border-black/10 dark:border-white/15 shadow-2xl backdrop-blur-xl z-50 space-y-0.5 text-charcoal-800 dark:text-cream-100">
              {[
                { name: '首页', href: '/' },
                { name: '作品集', href: '/portfolio' },
                { name: '博客', href: '/posts' },
                { name: '娱乐 · 音乐馆', href: '/entertain/music' },
                { name: '娱乐 · 93+特效', href: '/effects' },
                { name: '娱乐 · 烟花', href: '/entertain/fireworks' },
                { name: '娱乐 · 雨声', href: '/entertain/rain' },
                { name: '工具箱', href: '/tools' },
                { name: '友链', href: '/links' },
                { name: '关于', href: '/about' },
                { name: '留言板', href: '/messageboard' },
              ].map(item => (
                <a
                  href={item.href}
                  onclick="var mn=document.getElementById('mobile-nav-menu');if(mn)mn.removeAttribute('open');"
                  class={`block px-3.5 py-2 rounded-xl text-sm font-medium transition-colors ${
                    currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href))
                      ? 'bg-terracotta/12 text-terracotta font-semibold'
                      : 'text-charcoal-800 dark:text-cream-100 hover:text-terracotta hover:bg-black/5 dark:hover:bg-white/8'
                  }`}
                >
                  {item.name}
                </a>
              ))}
            </div>
          </details>
        </div>
      </div>
    </header>

    <!-- Left-Margin Nail + Elastic Rope Hanging Wooden Title Board -->
    {sideTitle && <HangingSideBoard client:load title={sideTitle} />}

    <!-- Main Content Slot -->
    <main class={`flex-1 w-full relative z-10 ${currentPath === '/' ? '' : 'pt-14'} ${fullWidth ? '' : 'max-w-6xl mx-auto px-4 sm:px-6'}`}>
      {currentPath !== '/' && resolvedWatermark && !currentPath.startsWith('/entertain/fireworks') && !currentPath.startsWith('/entertain/rain') && (
        <div
          data-parallax-watermark
          data-wm-text={resolvedWatermark}
          class={`pointer-events-auto cursor-default select-none text-center pt-2 relative z-0 overflow-hidden ${
            currentPath.startsWith('/entertain/music') ? '-mb-16 sm:-mb-24' : '-mb-8 sm:-mb-12'
          }`}
        >
          <span
            class="wm-text block text-[13vw] sm:text-[6.5rem] lg:text-[8.5rem] font-black leading-none tracking-[0.12em] bg-clip-text text-transparent truncate px-2 transition-opacity duration-300"
            style="background-image: linear-gradient(90deg, rgb(var(--theme-accent, 217 119 87) / 0.55), rgb(var(--theme-accent, 217 119 87) / 0.30) 55%, rgba(251, 191, 36, 0.42));"
          >
            {resolvedWatermark}
          </span>
          <canvas class="wm-canvas pointer-events-none absolute inset-0 w-full h-full opacity-0 transition-opacity duration-300" />
        </div>
      )}
      <div class="relative z-10">
        <slot />
      </div>
    </main>

    <!-- Synced Raga-style NetEase Music Player (persists across View Transitions) -->
    <NetEaseMusicPlayer client:load transition:persist="global-music-player" />

    <!-- Footer -->
    {!hideFooter && (
      <footer class="border-t border-charcoal-500/10 dark:border-white/10 py-10 text-center text-xs text-charcoal-100 dark:text-cream-400 relative z-20">
        <div class="max-w-4xl mx-auto px-4 space-y-3">
          <p class="font-serif text-sm">
            Crafted with <span class="text-terracotta animate-pulse">♥</span> by 磊大大 & AI Co-creators
          </p>
          <p class="font-mono text-[11px] opacity-75">
            PMOS V0.2 · 380+ 演进天数 · 108+ 灵感导航 · 93+ 原生动效
          </p>
          <div class="flex items-center justify-center gap-4 text-[11px] pt-1 opacity-60">
            <a href="/messageboard" class="hover:text-terracotta transition-colors">友链互换</a>
            <span>•</span>
            <a href="/tools" class="hover:text-terracotta transition-colors">AI日报</a>
            <span>•</span>
            <a href="https://github.com/ClawRere" target="_blank" rel="noopener noreferrer" class="hover:text-terracotta transition-colors">GitHub</a>
          </div>
        </div>
      </footer>
    )}

    <script is:inline>
      (function () {
        const saved = localStorage.getItem('theme');
        const hour = new Date().getHours();
        const isNight = hour >= 19 || hour < 6;
        if (saved === 'dark' || (!saved && isNight)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }

        const loader = document.getElementById('page-loader-overlay');
        document.addEventListener('astro:before-preparation', () => {
          if (loader) {
            loader.style.opacity = '1';
            loader.style.pointerEvents = 'auto';
          }
        });
        document.addEventListener('astro:page-load', () => {
          if (loader) {
            loader.style.opacity = '0';
            loader.style.pointerEvents = 'none';
          }
        });
        document.addEventListener('click', (e) => {
          const pm = document.getElementById('palette-menu');
          if (pm && pm.hasAttribute('open') && !pm.contains(e.target)) {
            pm.removeAttribute('open');
          }
          const mn = document.getElementById('mobile-nav-menu');
          if (mn && mn.hasAttribute('open') && !mn.contains(e.target)) {
            mn.removeAttribute('open');
          }
        });
      })();
    </script>
  </body>
</html>
