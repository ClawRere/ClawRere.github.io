---
import { ClientRouter } from 'astro:transitions';
import { FloatingDock } from '@/components/ui/FloatingDock';
import { BackgroundCanvas } from '@/components/ui/BackgroundCanvas';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = '磊大大 Larry | AI 产品经理与共创作品集',
  description = '以产品思维定义人机边界，以工程实践打磨 AI 生产力工具。面向 AI 协同时代的数字花园。',
} = Astro.props;

const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col bg-cream-50 dark:bg-obsidian text-charcoal-DEFAULT dark:text-cream-100 transition-colors duration-300 relative">
    <!-- Top delicate glow banner -->
    <div class="fixed top-0 left-0 right-0 h-1 bg-gradient-to-r from-transparent via-terracotta to-transparent opacity-60 z-50 pointer-events-none" />

    <!-- Interactive Living Background Canvas (Apple/Claude Particle Constellation) -->
    <BackgroundCanvas client:load />

    <!-- Ambient background gradient mesh -->
    <div class="fixed inset-0 pointer-events-none z-[-2] overflow-hidden">
      <div class="absolute top-[-10%] left-[-10%] w-[550px] h-[550px] rounded-full bg-terracotta/10 dark:bg-terracotta/15 blur-[140px]" />
      <div class="absolute top-[35%] right-[-10%] w-[500px] h-[500px] rounded-full bg-amber-500/10 dark:bg-amber-500/10 blur-[130px]" />
    </div>

    <!-- Header bar -->
    <header class="max-w-6xl w-full mx-auto px-4 sm:px-6 py-6 flex items-center justify-between">
      <a href="/" class="flex items-center gap-3 group">
        <span class="w-9 h-9 rounded-2xl bg-gradient-to-tr from-terracotta to-amber-500 text-white flex items-center justify-center font-serif font-bold text-base shadow-glow-terracotta group-hover:scale-105 transition-transform">
          L
        </span>
        <div class="flex flex-col">
          <span class="font-serif font-bold text-base tracking-tight text-charcoal-DEFAULT dark:text-cream-50 group-hover:text-terracotta transition-colors">
            磊大大 Larry
          </span>
          <span class="text-[11px] font-mono text-charcoal-100 dark:text-cream-400">
            AI Product Manager · PMOS Creator
          </span>
        </div>
      </a>

      <div class="flex items-center gap-3 text-xs font-mono">
        <a
          href="/effects"
          class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full glass hover:border-terracotta/40 text-charcoal-DEFAULT dark:text-cream-100 transition-colors"
        >
          <span class="w-2 h-2 rounded-full bg-amber-500 animate-ping" />
          <span>93+ 交互特效库</span>
        </a>
      </div>
    </header>

    <!-- Main Content Slot -->
    <main class="flex-1 max-w-6xl w-full mx-auto px-4 sm:px-6 pb-28">
      <slot />
    </main>

    <!-- Floating Dock Navigation Bar -->
    <FloatingDock client:load currentPath={currentPath} />

    <!-- Footer -->
    <footer class="border-t border-charcoal-500/10 dark:border-white/10 py-8 text-center text-xs text-charcoal-100 dark:text-cream-400">
      <p class="font-serif">
        Crafted with <span class="text-terracotta">♥</span> by Larry (磊大大) & AI Co-creators (Claude, Gemini & Cursor)
      </p>
      <p class="font-mono text-[11px] mt-1 opacity-70">
        AI Product Management · PMOS V0.2 · Deployed on GitHub Pages
      </p>
    </footer>
  </body>
</html>
