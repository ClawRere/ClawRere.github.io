---
import { ClientRouter } from 'astro:transitions';
import { BackgroundCanvas } from '@/components/ui/BackgroundCanvas';
import { NetEaseMusicPlayer } from '@/components/ui/NetEaseMusicPlayer';
import '@/styles/global.css';

interface Props {
  title?: string;
  description?: string;
  hideFooter?: boolean;
  fullWidth?: boolean;
}

const {
  title = '磊大大 Larry | AI 产品经理与共创作品集',
  description = '以产品思维定义人机边界，以工程实践打磨 AI 生产力工具。面向 AI 协同时代的数字花园。',
  hideFooter = false,
  fullWidth = false,
} = Astro.props;

const currentPath = Astro.url.pathname;

const entertainItems = [
  { name: '音乐馆', href: '/entertain/music', emoji: '🎵' },
  { name: '烟花秀', href: '/entertain/fireworks', emoji: '🎆' },
  { name: '雨声院', href: '/entertain/rain', emoji: '🌧️' },
  { name: '变形金刚', href: '/effects/optimus_prime/index.html', emoji: '🤖' },
  { name: '飞机大战', href: '/effects/flight_game/index.html', emoji: '✈️' },
  { name: '极速赛车', href: '/effects/car_racing_game/index.html', emoji: '🏎️' },
];
---

<!doctype html>
<html lang="zh-CN" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <ClientRouter />
  </head>
  <body class="min-h-screen flex flex-col bg-cream-50 dark:bg-obsidian text-charcoal-DEFAULT dark:text-cream-100 transition-colors duration-300 relative selection:bg-terracotta/20 selection:text-terracotta overflow-x-hidden">
    <!-- Top accent line -->
    <div class="fixed top-0 left-0 right-0 h-[2px] bg-gradient-to-r from-transparent via-terracotta/60 to-transparent z-50 pointer-events-none" />

    <!-- Daytime Snowflakes / Nighttime Fireflies Interactive Canvas -->
    <BackgroundCanvas client:load />

    <!-- Ambient gradient mesh -->
    <div class="fixed inset-0 pointer-events-none z-[-2] overflow-hidden">
      <div class="absolute top-[-10%] left-[-10%] w-[550px] h-[550px] rounded-full bg-terracotta/8 dark:bg-terracotta/10 blur-[140px]" />
      <div class="absolute top-[35%] right-[-10%] w-[500px] h-[500px] rounded-full bg-amber-500/8 dark:bg-amber-500/8 blur-[130px]" />
    </div>

    <!-- TOP NAVIGATION BAR -->
    <header class="fixed top-0 left-0 right-0 z-40 backdrop-blur-xl border-b border-black/5 dark:border-white/5 bg-cream-50/80 dark:bg-obsidian/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 h-14 flex items-center justify-between gap-4">
        
        <!-- Logo -->
        <a href="/" class="flex items-center gap-2.5 group shrink-0">
          <span class="w-8 h-8 rounded-xl bg-gradient-to-tr from-terracotta to-amber-500 text-white flex items-center justify-center font-serif font-bold text-sm shadow-glow-terracotta group-hover:scale-105 transition-transform">
            L
          </span>
          <div class="hidden sm:flex flex-col">
            <span class="font-serif font-bold text-sm text-charcoal-DEFAULT dark:text-cream-50 group-hover:text-terracotta transition-colors leading-none">
              磊大大 Larry
            </span>
            <span class="text-[10px] font-mono text-charcoal-100 dark:text-cream-400 leading-none mt-0.5">
              AI PM · PMOS
            </span>
          </div>
        </a>

        <!-- Center Navigation -->
        <nav class="hidden md:flex items-center gap-1 text-sm font-medium">
          <a href="/" class={`px-3 py-1.5 rounded-lg transition-colors ${currentPath === '/' ? 'text-terracotta bg-terracotta/8' : 'text-charcoal-200 dark:text-cream-300 hover:text-charcoal dark:hover:text-cream-50 hover:bg-black/5 dark:hover:bg-white/5'}`}>首页</a>
          <a href="/portfolio" class={`px-3 py-1.5 rounded-lg transition-colors ${currentPath.startsWith('/portfolio') ? 'text-terracotta bg-terracotta/8' : 'text-charcoal-200 dark:text-cream-300 hover:text-charcoal dark:hover:text-cream-50 hover:bg-black/5 dark:hover:bg-white/5'}`}>作品集</a>
          <a href="/posts" class={`px-3 py-1.5 rounded-lg transition-colors ${currentPath.startsWith('/posts') ? 'text-terracotta bg-terracotta/8' : 'text-charcoal-200 dark:text-cream-300 hover:text-charcoal dark:hover:text-cream-50 hover:bg-black/5 dark:hover:bg-white/5'}`}>博客</a>
          
          <!-- Entertainment hover dropdown -->
          <div class="relative group/entertain">
            <a href="/entertain" class={`px-3 py-1.5 rounded-lg transition-colors flex items-center gap-1 ${currentPath.startsWith('/entertain') || currentPath.startsWith('/effects/optimus') ? 'text-terracotta bg-terracotta/8' : 'text-charcoal-200 dark:text-cream-300 hover:text-charcoal dark:hover:text-cream-50 hover:bg-black/5 dark:hover:bg-white/5'}`}>
              娱乐馆
              <svg class="w-3 h-3 transition-transform group-hover/entertain:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
            </a>
            <div class="absolute top-full left-1/2 -translate-x-1/2 mt-1 w-44 py-1.5 rounded-2xl bg-white dark:bg-zinc-900 border border-black/8 dark:border-white/10 shadow-2xl backdrop-blur-xl opacity-0 invisible group-hover/entertain:opacity-100 group-hover/entertain:visible transition-all duration-200 z-50">
              {entertainItems.map(item => (
                <a href={item.href} class="flex items-center gap-2.5 px-4 py-2 text-sm text-charcoal-200 dark:text-cream-300 hover:text-terracotta hover:bg-terracotta/5 transition-colors" target={item.href.endsWith('.html') ? '_blank' : undefined} rel={item.href.endsWith('.html') ? 'noopener' : undefined}>
                  <span>{item.emoji}</span>
                  <span>{item.name}</span>
                </a>
              ))}
            </div>
          </div>

          <a href="/tools" class={`px-3 py-1.5 rounded-lg transition-colors ${currentPath.startsWith('/tools') ? 'text-terracotta bg-terracotta/8' : 'text-charcoal-200 dark:text-cream-300 hover:text-charcoal dark:hover:text-cream-50 hover:bg-black/5 dark:hover:bg-white/5'}`}>工具箱</a>
          <a href="/links" class={`px-3 py-1.5 rounded-lg transition-colors ${currentPath.startsWith('/links') ? 'text-terracotta bg-terracotta/8' : 'text-charcoal-200 dark:text-cream-300 hover:text-charcoal dark:hover:text-cream-50 hover:bg-black/5 dark:hover:bg-white/5'}`}>友链</a>
          <a href="/about" class={`px-3 py-1.5 rounded-lg transition-colors ${currentPath.startsWith('/about') ? 'text-terracotta bg-terracotta/8' : 'text-charcoal-200 dark:text-cream-300 hover:text-charcoal dark:hover:text-cream-50 hover:bg-black/5 dark:hover:bg-white/5'}`}>关于</a>
        </nav>

        <!-- Right actions -->
        <div class="flex items-center gap-2 shrink-0">
          <button
            id="theme-toggle-btn"
            onclick="document.documentElement.classList.toggle('dark'); localStorage.setItem('theme', document.documentElement.classList.contains('dark') ? 'dark' : 'light');"
            class="p-2 rounded-lg text-charcoal-100 dark:text-cream-400 hover:bg-black/5 dark:hover:bg-white/5 transition-colors"
            title="切换白天(飘雪) / 夜间(萤火虫)模式"
          >
            <span class="dark:hidden">❄️</span>
            <span class="hidden dark:inline">✨</span>
          </button>
          <a href="/messageboard" class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium text-charcoal-100 dark:text-cream-400 hover:text-terracotta transition-colors">
            💌 留言
          </a>
          <a href="/login" class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-medium text-charcoal-100 dark:text-cream-400 hover:text-terracotta transition-colors">
            🔐 管理
          </a>

          <!-- Mobile hamburger -->
          <details class="md:hidden relative group/mobile">
            <summary class="list-none cursor-pointer p-2 rounded-lg hover:bg-black/5 dark:hover:bg-white/5 transition-colors text-charcoal-200 dark:text-cream-300">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" /></svg>
            </summary>
            <div class="absolute top-full right-0 mt-2 w-52 py-2 rounded-2xl bg-white dark:bg-zinc-900 border border-black/8 dark:border-white/10 shadow-2xl backdrop-blur-xl z-50">
              {[
                { name: '首页', href: '/' },
                { name: '作品集', href: '/portfolio' },
                { name: '博客', href: '/posts' },
                { name: '娱乐 · 音乐馆', href: '/entertain/music' },
                { name: '娱乐 · 烟花', href: '/entertain/fireworks' },
                { name: '娱乐 · 雨声', href: '/entertain/rain' },
                { name: '工具箱', href: '/tools' },
                { name: '友链', href: '/links' },
                { name: '关于', href: '/about' },
                { name: '留言板', href: '/messageboard' },
              ].map(item => (
                <a href={item.href} class="block px-4 py-2 text-sm text-charcoal-200 dark:text-cream-300 hover:text-terracotta hover:bg-terracotta/5 transition-colors">{item.name}</a>
              ))}
            </div>
          </details>
        </div>
      </div>
    </header>

    <!-- Main Content Slot -->
    <main class={`flex-1 w-full pt-14 relative z-10 ${fullWidth ? '' : 'max-w-6xl mx-auto px-4 sm:px-6'}`}>
      <slot />
    </main>

    <!-- Synced NetEase Music Player -->
    <NetEaseMusicPlayer client:load />

    <!-- Footer -->
    {!hideFooter && (
      <footer class="border-t border-charcoal-500/10 dark:border-white/10 py-10 text-center text-xs text-charcoal-100 dark:text-cream-400 relative z-20">
        <div class="max-w-4xl mx-auto px-4 space-y-3">
          <p class="font-serif text-sm">
            Crafted with <span class="text-terracotta animate-pulse">♥</span> by Larry & AI Co-creators
          </p>
          <p class="font-mono text-[11px] opacity-75">
            PMOS V0.2 · 380+ 演进天数 · 108+ 灵感导航 · 93+ 原生动效
          </p>
          <div class="flex items-center justify-center gap-4 text-[11px] pt-1 opacity-60">
            <a href="/messageboard" class="hover:text-terracotta transition-colors">友链互换</a>
            <span>•</span>
            <a href="/tools" class="hover:text-terracotta transition-colors">AI日报</a>
            <span>•</span>
            <a href="https://github.com/ClawRere" target="_blank" rel="noopener noreferrer" class="hover:text-terracotta transition-colors">GitHub</a>
          </div>
        </div>
      </footer>
    )}

    <script is:inline>
      (function () {
        const saved = localStorage.getItem('theme');
        const hour = new Date().getHours();
        const isNight = hour >= 19 || hour < 6;
        if (saved === 'dark' || (!saved && isNight)) {
          document.documentElement.classList.add('dark');
        } else {
          document.documentElement.classList.remove('dark');
        }
      })();
    </script>
  </body>
</html>
