---
import Layout from '../layouts/Layout.astro';
import { Sparkles, Code2, Layers, Cpu, Award, Target, Rocket, Compass, Workflow, CheckCircle2, ArrowRight, Palette, Terminal, ShieldCheck, Heart } from 'lucide-react';
import ImageWithFallback from '../components/ui/ImageWithFallback';

const skills = [
  {
    category: "AI 产品方法论 & 0-1 架构",
    icon: Target,
    color: "from-amber-500/20 to-orange-500/10 text-amber-500 border-amber-500/30",
    items: [
      { name: "5W1H 深度拆解", desc: "穿透业务伪需求，从根本上定义 AI Agent 的系统边界与效用函数" },
      { name: "假设 vs 事实分层追踪", desc: "在 PRD 阶段隔离未知风险，建立自动化基线核验闭环" },
      { name: "动态一致性基线状态机", desc: "控制生成物版本（V0.2/vX.Y/rN），保证复杂任务多轮迭代不跑偏" },
      { name: "AI 交互心智模型构建", desc: "设计非侵入式渐进增强体验，降低大模型幻觉对端侧用户的影响" }
    ]
  },
  {
    category: "设计工程 & 极致交互品味",
    icon: Palette,
    color: "from-purple-500/20 to-pink-500/10 text-purple-500 border-purple-500/30",
    items: [
      { name: "Apple 流体动效与空间感", desc: "追求 120fps 极佳手感，弹簧物理动量与微交互细节" },
      { name: "Claude 式人文温润质感", desc: "克制的排版韵律，柔和暗色渐变，阅读呼吸感与沉浸感" },
      { name: "Canvas / WebGL / CSS 3D", desc: "100+ 独立动效研究，轻量化渲染，低内存占用设计" },
      { name: "Design System & Token 化", desc: "跨端设计资产复用，原子化样式保证长期协同一致性" }
    ]
  },
  {
    category: "工程落地 & 全栈协作能力",
    icon: Terminal,
    color: "from-cyan-500/20 to-blue-500/10 text-cyan-500 border-cyan-500/30",
    items: [
      { name: "LLM / RAG / Multi-Agent", desc: "熟悉 LangChain / LlamaIndex / Agentic Workflow 链路工程与评测体系" },
      { name: "现代前端技术栈", desc: "TypeScript / React / Vue 3 / Astro / Tailwind CSS / Framer Motion" },
      { name: "后端与数据底座", desc: "FastAPI / Python / Node.js / SQLite / Vector DB (Chroma, Pinecone)" },
      { name: "端侧工具链协同", desc: "Cursor, Windsurf, Git 工作流，高效人机共创与协同研发" }
    ]
  }
];

const timeline = [
  {
    period: "2024 - 至今",
    role: "AI 架构设计 & 资深产品经理",
    org: "AI 创新工坊 / PMOS 孵化",
    highlight: "主导 PMOS (Product Manager Operating System) 0-1 架构设计，首创基于 Agent 靶向生成的证据分层协同引擎；探索大模型时代下产品经理与 AI 结对共创的最佳实践。"
  },
  {
    period: "2022 - 2024",
    role: "产品专家 / 体验架构师",
    org: "数字消费 & SaaS 科技平台",
    highlight: "主导核心业务线全流程体验重构，引入流体设计系统与多维数据洞察看板，将复杂流程流失率降低 34%，日活留存提升 21%。"
  },
  {
    period: "2020 - 2022",
    role: "产品经理 & 个人数字花园创作者",
    org: "Hexo / 开源动效社区",
    highlight: "持续沉淀 99+ 篇技术与产品思考博客，独立收集与复刻 100+ 前端原生动效库，累计访问突破 100,000+ 次。"
  }
];

const metrics = [
  { value: "380+", label: "持续演进天数", sub: "Digital Garden" },
  { value: "99+", label: "原创博文沉淀", sub: "Deep Insights" },
  { value: "93+", label: "原生视效交互", sub: "Motion Lab" },
  { value: "108+", label: "精选灵感导航", sub: "Curated Links" }
];
---

<Layout title="关于我 | AI 产品经理 & 体验架构师">
  <div class="relative max-w-5xl mx-auto px-4 sm:px-6 py-12 md:py-16 space-y-20">
    
    <!-- Top Hero Section -->
    <div class="relative overflow-hidden rounded-3xl border border-white/10 bg-gradient-to-br from-white/[0.04] via-transparent to-white/[0.01] p-8 md:p-12 backdrop-blur-xl">
      <div class="absolute -top-32 -right-32 w-80 h-80 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-32 -left-32 w-80 h-80 bg-purple-500/10 rounded-full blur-3xl pointer-events-none"></div>
      
      <div class="flex flex-col md:flex-row items-center gap-8 md:gap-12 relative z-10">
        <div class="relative group">
          <div class="w-36 h-36 md:w-44 md:h-44 rounded-3xl overflow-hidden border-2 border-white/20 shadow-2xl relative">
            <ImageWithFallback
              client:load
              src="https://q1.qlogo.cn/g?b=qq&nk=2472919073&s=640"
              alt="磊大大 Larry"
              className="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
          </div>
          <span class="absolute -bottom-2 -right-2 px-3 py-1 text-xs font-semibold rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center gap-1.5 shadow-lg backdrop-blur-md">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            AI Product Manager
          </span>
        </div>

        <div class="flex-1 text-center md:text-left space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-xs font-medium text-amber-300">
            <Sparkles className="w-3.5 h-3.5" />
            以工程严谨度衡量需求，以艺术家眼光雕琢体验
          </div>
          <h1 class="text-3xl md:text-5xl font-extrabold tracking-tight text-white">
            磊大大 <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-orange-300 to-purple-400">Larry</span>
          </h1>
          <p class="text-slate-300 text-base md:text-lg leading-relaxed max-w-2xl font-light">
            AI 产品经理 / 体验架构师 / 数字花园园丁。专注于大语言模型时代的 <strong class="text-white font-medium">Agent 操作系统</strong>、<strong class="text-white font-medium">证据分层决策</strong> 与 <strong class="text-white font-medium">极致流体交互</strong>。
          </p>

          <div class="flex flex-wrap items-center justify-center md:justify-start gap-3 pt-2">
            <a href="/portfolio/pmos-ai-workspace" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-gradient-to-r from-amber-500 to-orange-500 hover:from-amber-400 hover:to-orange-400 text-black font-semibold text-sm transition-all shadow-lg shadow-amber-500/20">
              了解旗舰项目 PMOS
              <ArrowRight className="w-4 h-4" />
            </a>
            <a href="/messageboard" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white/10 hover:bg-white/15 text-white font-medium text-sm border border-white/10 transition-all">
              <Heart className="w-4 h-4 text-pink-400" />
              向我留言 / 友链申请
            </a>
          </div>
        </div>
      </div>

      <!-- Live Metrics Strip -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-10 pt-8 border-t border-white/10">
        {metrics.map((m) => (
          <div class="text-center md:text-left">
            <div class="text-2xl md:text-3xl font-extrabold text-white tracking-tight">{m.value}</div>
            <div class="text-xs font-medium text-slate-300">{m.label}</div>
            <div class="text-[10px] text-slate-400 uppercase tracking-wider">{m.sub}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- Product Mindset & Philosophy -->
    <div class="space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <h2 class="text-2xl font-bold text-white flex items-center gap-2.5">
            <Compass className="w-6 h-6 text-amber-400" />
            产品信念与设计哲学
          </h2>
          <p class="text-sm text-slate-400 mt-1">在混沌的模型生成中，建立确定性的产品价值与用户心智</p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/10 hover:border-amber-500/30 transition-all space-y-3">
          <div class="w-10 h-10 rounded-xl bg-amber-500/10 border border-amber-500/20 flex items-center justify-center text-amber-400 font-bold">
            01
          </div>
          <h3 class="text-lg font-bold text-white">5W1H 穿透本质</h3>
          <p class="text-sm text-slate-400 leading-relaxed">
            AI 不该只是炫技的聊天框。一个合格的产品经理必须追问：<strong class="text-slate-200">Who</strong>（受众心理）、<strong class="text-slate-200">Why</strong>（效用何在）、<strong class="text-slate-200">How</strong>（低阻力路径），用最清晰的结构化语言定义边界。
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/10 hover:border-purple-500/30 transition-all space-y-3">
          <div class="w-10 h-10 rounded-xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400 font-bold">
            02
          </div>
          <h3 class="text-lg font-bold text-white">假设与事实分层</h3>
          <p class="text-sm text-slate-400 leading-relaxed">
            大模型最危险的陷阱是“自信地编造”。在 PMOS 中，我们将信息严格解耦为已知事实（Facts）、待证假设（Assumptions）与生成物，用基线状态机确保每一步推理都立足于客观证据。
          </p>
        </div>

        <div class="p-6 rounded-2xl bg-white/[0.02] border border-white/10 hover:border-cyan-500/30 transition-all space-y-3">
          <div class="w-10 h-10 rounded-xl bg-cyan-500/10 border border-cyan-500/20 flex items-center justify-center text-cyan-400 font-bold">
            03
          </div>
          <h3 class="text-lg font-bold text-white">温润而克制的交互</h3>
          <p class="text-sm text-slate-400 leading-relaxed">
            吸收 Apple 的流体物理反馈与 Claude 的自然版式哲学。拒绝无效的堆砌与文字疲劳，让每一次点击、每一次悬停都自然、顺畅、极具响应感。
          </p>
        </div>
      </div>
    </div>

    <!-- Core Skills Matrix -->
    <div class="space-y-6">
      <div>
        <h2 class="text-2xl font-bold text-white flex items-center gap-2.5">
          <Workflow className="w-6 h-6 text-purple-400" />
          全栈能力全景图
        </h2>
        <p class="text-sm text-slate-400 mt-1">从战略规划到原型构建，打通需求、算法与工程的端到端实现</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {skills.map((s) => {
          const Icon = s.icon;
          return (
            <div class="rounded-2xl border border-white/10 bg-white/[0.02] p-6 space-y-5 hover:border-white/20 transition-all">
              <div class="flex items-center gap-3">
                <div class={`p-2.5 rounded-xl border bg-gradient-to-br ${s.color}`}>
                  <Icon className="w-5 h-5" />
                </div>
                <h3 class="font-bold text-base text-white">{s.category}</h3>
              </div>

              <div class="space-y-4">
                {s.items.map((it) => (
                  <div class="space-y-1">
                    <div class="text-sm font-semibold text-slate-200 flex items-center gap-1.5">
                      <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                      {it.name}
                    </div>
                    <div class="text-xs text-slate-400 pl-3 leading-relaxed">
                      {it.desc}
                    </div>
                  </div>
                ))}
              </div>
            </div>
          );
        })}
      </div>
    </div>

    <!-- Career & Creation Timeline -->
    <div class="space-y-6">
      <div>
        <h2 class="text-2xl font-bold text-white flex items-center gap-2.5">
          <Rocket className="w-6 h-6 text-emerald-400" />
          经历与创作足迹
        </h2>
        <p class="text-sm text-slate-400 mt-1">不断探索人机协作的前沿边界</p>
      </div>

      <div class="relative pl-6 md:pl-8 border-l border-white/10 space-y-8">
        {timeline.map((item) => (
          <div class="relative group">
            <div class="absolute -left-[31px] md:-left-[39px] top-1.5 w-4 h-4 rounded-full border-2 border-slate-900 bg-amber-400 group-hover:scale-125 transition-transform"></div>
            <div class="flex flex-wrap items-center gap-2 text-xs font-semibold text-amber-400 uppercase tracking-wider">
              <span>{item.period}</span>
              <span class="text-slate-600">•</span>
              <span class="text-slate-300 font-normal">{item.org}</span>
            </div>
            <h3 class="text-lg font-bold text-white mt-1">{item.role}</h3>
            <p class="text-sm text-slate-400 mt-2 leading-relaxed">
              {item.highlight}
            </p>
          </div>
        ))}
      </div>
    </div>

    <!-- Contact & Co-creation -->
    <div class="rounded-3xl border border-white/10 bg-gradient-to-r from-amber-500/10 via-purple-500/10 to-blue-500/10 p-8 text-center space-y-4">
      <h3 class="text-2xl font-bold text-white">想与我聊聊产品、AI 协作，或者交换友链？</h3>
      <p class="text-slate-400 text-sm max-w-xl mx-auto">
        无论是探讨大模型 Agent 架构、产品设计方案，还是单纯交流前沿视效灵感，都欢迎随时联系或在留言板写下想法。
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4 pt-2">
        <a href="mailto:2472919073@qq.com" class="px-5 py-2.5 rounded-xl bg-white text-black font-semibold text-sm hover:bg-slate-200 transition-colors shadow-lg">
          2472919073@qq.com
        </a>
        <a href="/messageboard" class="px-5 py-2.5 rounded-xl bg-white/10 text-white font-medium text-sm hover:bg-white/20 border border-white/15 transition-colors">
          前往互动留言板
        </a>
      </div>
    </div>

  </div>
</Layout>
