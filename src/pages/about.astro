---
import Layout from '../layouts/Layout.astro';

const skills = [
  {
    category: "AI 产品方法论 & 0-1 架构",
    color: "text-amber-400",
    border: "border-amber-500/30",
    bg: "bg-amber-500/8",
    items: [
      { name: "5W1H 深度拆解", desc: "穿透业务伪需求，从根本上定义 AI Agent 的系统边界与效用函数" },
      { name: "假设 vs 事实分层追踪", desc: "在 PRD 阶段隔离未知风险，建立自动化基线核验闭环" },
      { name: "动态一致性基线状态机", desc: "控制生成物版本（V0.2/vX.Y/rN），保证复杂任务多轮迭代不跑偏" },
      { name: "AI 交互心智模型构建", desc: "设计非侵入式渐进增强体验，降低大模型幻觉对端侧用户的影响" },
    ],
  },
  {
    category: "设计工程 & 交互品味",
    color: "text-purple-400",
    border: "border-purple-500/30",
    bg: "bg-purple-500/8",
    items: [
      { name: "Apple 流体动效与空间感", desc: "追求 120fps 极佳手感，弹簧物理动量与微交互细节" },
      { name: "Claude 式人文温润质感", desc: "克制的排版韵律，柔和暗色渐变，阅读呼吸感与沉浸感" },
      { name: "Canvas / WebGL / CSS 3D", desc: "100+ 独立动效研究，轻量化渲染，低内存占用设计" },
      { name: "Design System & Token 化", desc: "跨端设计资产复用，原子化样式保证长期协同一致性" },
    ],
  },
  {
    category: "工程落地 & 全栈协作",
    color: "text-cyan-400",
    border: "border-cyan-500/30",
    bg: "bg-cyan-500/8",
    items: [
      { name: "LLM / RAG / Multi-Agent", desc: "熟悉 LangChain / LlamaIndex / Agentic Workflow 链路工程与评测" },
      { name: "现代前端技术栈", desc: "TypeScript / React / Vue 3 / Astro / Tailwind CSS / Framer Motion" },
      { name: "后端与数据底座", desc: "FastAPI / Python / Node.js / SQLite / Vector DB (Chroma)" },
      { name: "端侧工具链协同", desc: "Cursor, Windsurf, Git 工作流，高效人机共创与协同研发" },
    ],
  },
];

const timeline = [
  {
    period: "2024 - 至今",
    role: "AI 架构设计 & 资深产品经理",
    org: "AI 创新工坊 / PMOS 孵化",
    highlight: "主导 PMOS 0-1 架构设计，首创基于 Agent 靶向生成的证据分层协同引擎；探索大模型时代下产品经理与 AI 结对共创的最佳实践。",
  },
  {
    period: "2022 - 2024",
    role: "产品专家 / 体验架构师",
    org: "数字消费 & SaaS 科技平台",
    highlight: "主导核心业务线全流程体验重构，引入流体设计系统与多维数据洞察看板，将复杂流程流失率降低 34%，日活留存提升 21%。",
  },
  {
    period: "2020 - 2022",
    role: "产品经理 & 数字花园创作者",
    org: "Hexo 开源动效社区",
    highlight: "持续沉淀 99+ 篇技术与产品思考博客，独立收集与复刻 100+ 前端动效库，累计访问突破 100,000+ 次。",
  },
];

const metrics = [
  { value: "380+", label: "持续演进天数" },
  { value: "99+", label: "原创博文沉淀" },
  { value: "93+", label: "原生视效交互" },
  { value: "108+", label: "精选灵感导航" },
];
---

<Layout title="关于我 | AI 产品经理 & 体验架构师">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 space-y-16">

    <!-- Hero -->
    <div class="relative overflow-hidden rounded-3xl border border-white/10 dark:border-white/8 bg-gradient-to-br from-zinc-100/80 via-transparent to-transparent dark:from-zinc-800/40 p-8 md:p-10">
      <div class="absolute -top-32 -right-32 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none"></div>
      <div class="absolute -bottom-32 -left-32 w-72 h-72 bg-purple-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="flex flex-col md:flex-row items-center gap-8 relative z-10">
        <div class="relative shrink-0">
          <div class="w-32 h-32 md:w-40 md:h-40 rounded-3xl overflow-hidden border-2 border-white/20 shadow-2xl">
            <img
              src="https://q1.qlogo.cn/g?b=qq&nk=2472919073&s=640"
              alt="磊大大 Larry"
              class="w-full h-full object-cover"
              onerror="this.src='https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=200&h=200&fit=crop'"
            />
          </div>
          <span class="absolute -bottom-2 -right-2 px-2.5 py-1 text-xs font-semibold rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 flex items-center gap-1.5 shadow-lg backdrop-blur-md whitespace-nowrap">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            AI PM
          </span>
        </div>

        <div class="flex-1 text-center md:text-left space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-xs font-medium text-amber-300">
            ✨ 以工程严谨度衡量需求，以艺术家眼光雕琢体验
          </div>
          <h1 id="about-name" class="text-3xl md:text-4xl font-extrabold tracking-tight text-zinc-900 dark:text-white">
            磊大大 <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-400 via-orange-300 to-purple-400">Larry</span>
          </h1>
          <p id="about-bio" class="text-zinc-600 dark:text-zinc-300 text-sm md:text-base leading-relaxed max-w-xl">
            AI 产品经理 / 体验架构师 / 数字花园园丁。专注于
            <strong class="text-zinc-900 dark:text-white font-medium">Agent 操作系统</strong>、
            <strong class="text-zinc-900 dark:text-white font-medium">证据分层决策</strong>与
            <strong class="text-zinc-900 dark:text-white font-medium">极致流体交互</strong>。
          </p>
          <div class="flex flex-wrap items-center justify-center md:justify-start gap-3">
            <a href="/portfolio/pmos-ai-workspace" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-gradient-to-r from-amber-500 to-orange-500 hover:opacity-90 text-black font-semibold text-sm transition-all shadow-lg">
              了解 PMOS →
            </a>
            <a href="/messageboard" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white/8 dark:bg-white/8 hover:bg-white/15 text-zinc-900 dark:text-white font-medium text-sm border border-zinc-200 dark:border-white/15 transition-all">
              💌 留言 / 友链
            </a>
          </div>
        </div>
      </div>

      <!-- Metrics -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-10 pt-8 border-t border-zinc-200 dark:border-white/10">
        {metrics.map(m => (
          <div class="text-center md:text-left">
            <div class="text-2xl md:text-3xl font-extrabold text-zinc-900 dark:text-white">{m.value}</div>
            <div class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">{m.label}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- Philosophy -->
    <div class="space-y-5">
      <h2 class="text-xl font-bold text-zinc-900 dark:text-white flex items-center gap-2">
        🧭 产品信念与设计哲学
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {[
          { num: '01', title: '5W1H 穿透本质', color: 'text-amber-400 bg-amber-500/10 border-amber-500/20', body: 'AI 不该只是聊天框。必须追问 Who（受众心理）、Why（效用何在）、How（低阻力路径），用最清晰的结构化语言定义边界。' },
          { num: '02', title: '假设与事实分层', color: 'text-purple-400 bg-purple-500/10 border-purple-500/20', body: '大模型最危险的陷阱是"自信地编造"。在 PMOS 中，将信息解耦为已知事实、待证假设与生成物，用基线状态机确保每步推理立足客观证据。' },
          { num: '03', title: '温润而克制的交互', color: 'text-cyan-400 bg-cyan-500/10 border-cyan-500/20', body: '吸收 Apple 的流体物理反馈与 Claude 的自然版式哲学。拒绝无效堆砌与文字疲劳，让每次点击、每次悬停都自然、顺畅、响应。' },
        ].map(card => (
          <div class="p-5 rounded-2xl border border-zinc-200 dark:border-white/8 bg-white/50 dark:bg-zinc-900/40 hover:border-zinc-300 dark:hover:border-white/15 transition-all space-y-3">
            <div class={`w-9 h-9 rounded-xl border flex items-center justify-center font-bold text-sm ${card.color}`}>
              {card.num}
            </div>
            <h3 class="text-base font-bold text-zinc-900 dark:text-white">{card.title}</h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 leading-relaxed">{card.body}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Skills matrix -->
    <div class="space-y-5">
      <h2 class="text-xl font-bold text-zinc-900 dark:text-white flex items-center gap-2">
        ⚙️ 全栈能力全景图
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {skills.map(s => (
          <div class={`rounded-2xl border p-5 space-y-4 ${s.border} ${s.bg}`}>
            <h3 class={`font-bold text-sm ${s.color}`}>{s.category}</h3>
            <div class="space-y-3">
              {s.items.map(it => (
                <div>
                  <div class="text-sm font-semibold text-zinc-900 dark:text-white flex items-center gap-1.5">
                    <span class={`w-1.5 h-1.5 rounded-full ${s.color.replace('text-', 'bg-')}`}></span>
                    {it.name}
                  </div>
                  <div class="text-xs text-zinc-600 dark:text-zinc-400 pl-3 mt-0.5 leading-relaxed">{it.desc}</div>
                </div>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Timeline -->
    <div class="space-y-5">
      <h2 class="text-xl font-bold text-zinc-900 dark:text-white flex items-center gap-2">
        🚀 经历与创作足迹
      </h2>
      <div class="relative pl-6 border-l border-zinc-200 dark:border-white/10 space-y-8">
        {timeline.map(item => (
          <div class="relative group">
            <div class="absolute -left-[27px] top-1.5 w-3.5 h-3.5 rounded-full border-2 border-white dark:border-zinc-900 bg-amber-400 group-hover:scale-125 transition-transform"></div>
            <div class="text-xs font-mono text-amber-500 uppercase tracking-wider">
              {item.period} · <span class="text-zinc-500 dark:text-zinc-400 normal-case tracking-normal font-normal">{item.org}</span>
            </div>
            <h3 class="text-base font-bold text-zinc-900 dark:text-white mt-1">{item.role}</h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-1.5 leading-relaxed">{item.highlight}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Contact CTA -->
    <div class="rounded-3xl border border-zinc-200 dark:border-white/10 bg-gradient-to-r from-amber-500/8 via-purple-500/8 to-blue-500/8 p-8 text-center space-y-4">
      <h3 class="text-xl font-bold text-zinc-900 dark:text-white">想聊产品、AI 协作，或者交换友链？</h3>
      <p class="text-zinc-600 dark:text-zinc-400 text-sm max-w-xl mx-auto">
        无论是探讨 Agent 架构、产品设计方案，还是交流前沿视效灵感，都欢迎随时联系。
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a id="about-email-btn" href="mailto:2472919073@qq.com" class="px-5 py-2.5 rounded-xl bg-zinc-900 dark:bg-white text-white dark:text-black font-semibold text-sm hover:opacity-90 transition-opacity shadow-lg">
          发邮件联系
        </a>
        <a href="/messageboard" class="px-5 py-2.5 rounded-xl border border-zinc-200 dark:border-white/15 text-zinc-900 dark:text-white font-medium text-sm hover:bg-zinc-100 dark:hover:bg-white/8 transition-colors">
          互动留言板
        </a>
      </div>
    </div>

  </div>

  <script is:inline>
    (function () {
      try {
        var raw = localStorage.getItem('about_config');
        if (!raw) return;
        var cfg = JSON.parse(raw);
        if (cfg.bio) {
          var bioEl = document.getElementById('about-bio');
          if (bioEl) bioEl.textContent = cfg.bio;
        }
        if (cfg.email) {
          var mailEl = document.getElementById('about-email-btn');
          if (mailEl) mailEl.setAttribute('href', 'mailto:' + cfg.email);
        }
      } catch (e) {}
    })();
  </script>
</Layout>
