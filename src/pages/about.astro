---
import Layout from '../layouts/Layout.astro';

const skills = [
  {
    category: "AI 产品方法论 & 0-1 架构",
    color: "text-amber-400",
    glow: "from-amber-400 via-orange-500 to-rose-500",
    items: [
      { name: "5W1H 深度拆解", desc: "穿透业务伪需求，从根本上定义 AI Agent 的系统边界与效用函数" },
      { name: "假设 vs 事实分层追踪", desc: "在 PRD 阶段隔离未知风险，建立自动化基线核验闭环" },
      { name: "动态一致性基线状态机", desc: "控制生成物版本（V0.2/vX.Y/rN），保证复杂任务多轮迭代不跑偏" },
      { name: "AI Evals 评测集与幻觉治理", desc: "构建 Badcase 回归测试与 Rubric 评分标准，保障生成稳定性" },
    ],
  },
  {
    category: "AI 交互设计 & 生成式 UI",
    color: "text-purple-400",
    glow: "from-purple-400 via-fuchsia-500 to-pink-500",
    items: [
      { name: "Apple 流体动效与空间感", desc: "追求 120fps 极佳手感，弹簧物理动量与微交互细节" },
      { name: "Claude 式人文温润质感", desc: "克制的排版韵律，柔和渐变，阅读呼吸感与沉浸感" },
      { name: "多模态交互与生成式 UI", desc: "探索文生图、语音流式交互与动态自适应组件编排" },
      { name: "Axure / Visio / PS / Canvas", desc: "高保真交互原型、动效研究与轻量化渲染" },
    ],
  },
  {
    category: "AI 研发工程 & 数据分析栈",
    color: "text-cyan-400",
    glow: "from-cyan-400 via-blue-500 to-indigo-500",
    items: [
      { name: "Agentic Workflow / MCP / RAG", desc: "熟悉 Multi-Agent 编排、MCP Server 接入与知识库检索增强" },
      { name: "Prompt & Context 工程", desc: "系统级提示词架构、记忆压缩与工具调用约束设计" },
      { name: "Python / FineBI / Tableau / Matlab", desc: "数据采集清洗、自动化报告与多维分析驾驶舱搭建" },
      { name: "Vue / React / Astro / Node / Git", desc: "全栈原型快速构建，Claude / Codex / Cursor 结对共创" },
    ],
  },
];

const timeline = [
  {
    period: "2024 - 至今",
    role: "AI 产品架构与独立共创实践",
    org: "PMOS / AI 工作流孵化",
    highlight: "主导 PMOS 产品经理工作台 0-1 设计，围绕「需求对话—阶段结论—产品成果—影响分析—版本基线」构建可追溯的 AI 协作流；同步落地日报工作台、人格测试实验室等独立产品。",
  },
  {
    period: "2021 - 2024",
    role: "SaaS & 算法产品经理",
    org: "企业数字化 / 智慧履约平台",
    highlight: "主导智慧履约 WIFI 指纹定位与到访识别（定位准确率 95% / 识别率 90%+）等核心产品从需求抽象、评测口径制定到线上交付闭环。",
  },
  {
    period: "2019 - 2021",
    role: "教育产品经理 & 数字花园创作者",
    org: "省级在线教育项目 · 中南财大 & 华中科大",
    highlight: "负责之江汇寒暑假公益课堂活动策划、产品设计与跨组织资源整合，参与武汉空中课堂分析驾驶舱与 Python 自动化报表建设；业余持续沉淀 99+ 篇博客与 93+ 原生前端动效。",
  },
];

const interests = [
  {
    tag: "🐱 我的小猫 · 派派",
    title: "派派的专属小站",
    sub: "点击探望我的小猫派派 → paipai.ldddd.eu.org",
    img: "/img/paipai.webp",
    href: "https://paipai.ldddd.eu.org/",
  },
  {
    tag: "爱好游戏 · 英雄联盟",
    title: "召唤师峡谷的热血对局",
    sub: "喜欢团队配合与战术博弈 · 永远的青春回忆",
    img: "https://images.unsplash.com/photo-1542751371-adc38448a05e?q=80&w=900&auto=format&fit=crop",
  },
  {
    tag: "爱好番剧 · 夏目友人帐",
    title: "温柔以待世界万物",
    sub: "治愈系日常与人情羁绊 · 永远的白月光番剧",
    img: "https://images.unsplash.com/photo-1448375240586-882707db888b?q=80&w=900&auto=format&fit=crop",
  },
  {
    tag: "坐标 · 武汉双校足迹",
    title: "江城烟火与求学时光",
    sub: "本科 中南财经政法大学 · 硕士 华中科技大学",
    img: "https://images.unsplash.com/photo-1477959858617-67f85cf4f1df?q=80&w=900&auto=format&fit=crop",
  },
];

const metrics = [
  { value: "380+", label: "持续演进天数" },
  { value: "99+", label: "原创博文沉淀" },
  { value: "93+", label: "原生视效交互" },
  { value: "108+", label: "精选灵感导航" },
];
---

<Layout title="关于我 | 磊大大の小栈" sideTitle="关于磊大大">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 py-8 space-y-12">

    <!-- Hero (tilts toward cursor) -->
    <div class="tilt-card relative overflow-hidden rounded-3xl border border-white/10 dark:border-white/8 bg-gradient-to-br from-zinc-100/80 via-transparent to-transparent dark:from-zinc-800/40 backdrop-blur-md p-8 md:p-10 group transition-transform duration-200 ease-out will-change-transform">
      <div class="absolute -top-32 -right-32 w-72 h-72 bg-amber-500/10 rounded-full blur-3xl pointer-events-none group-hover:scale-125 transition-transform duration-700"></div>
      <div class="absolute -bottom-32 -left-32 w-72 h-72 bg-purple-500/10 rounded-full blur-3xl pointer-events-none group-hover:scale-125 transition-transform duration-700"></div>

      <div class="flex flex-col md:flex-row items-center gap-8 relative z-10">
        <div class="relative shrink-0">
          <div class="w-32 h-32 md:w-40 md:h-40 rounded-3xl overflow-hidden border-2 border-white/20 shadow-2xl transition-transform duration-500 hover:rotate-3 hover:scale-105 cursor-pointer">
            <img
              src="https://q1.qlogo.cn/g?b=qq&nk=2472919073&s=640"
              alt="磊大大 Larry"
              class="w-full h-full object-cover"
              onerror="this.src='https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=300&h=300&fit=crop'"
            />
          </div>
          <span class="absolute -bottom-2 -right-2 px-2.5 py-1 text-xs font-semibold rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center gap-1.5 shadow-lg backdrop-blur-md whitespace-nowrap">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            ENTP · AI PM
          </span>
        </div>

        <div class="flex-1 text-center md:text-left space-y-4">
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-500/10 border border-amber-500/20 text-xs font-medium text-amber-500 dark:text-amber-300">
            ✨ 充满好奇，保持理性 · 源于热爱而去感受
          </div>
          <h1 id="about-name" class="text-3xl md:text-4xl font-extrabold tracking-tight text-zinc-900 dark:text-white">
            你好，我是 <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-500 via-orange-400 to-purple-500">磊大大</span> 👋
          </h1>
          <p id="about-bio" class="text-zinc-600 dark:text-zinc-300 text-sm md:text-base leading-relaxed max-w-xl">
            是一名 <strong class="text-zinc-900 dark:text-white font-medium">AI 产品经理</strong>、业余研发与数字花园博主。现居 <strong class="text-zinc-900 dark:text-white font-medium">中国·武汉</strong>，专注于 Agent 操作系统、证据分层决策与极致流体交互。
          </p>
          <div class="flex flex-wrap items-center justify-center md:justify-start gap-3">
            <a href="/portfolio/pmos-ai-workspace" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-gradient-to-r from-amber-500 to-orange-500 hover:opacity-90 text-black font-semibold text-sm transition-all shadow-lg hover:-translate-y-0.5">
              了解 PMOS →
            </a>
            <a href="https://paipai.ldddd.eu.org/" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-pink-500/15 text-pink-500 dark:text-pink-300 border border-pink-500/25 font-medium text-sm hover:bg-pink-500/25 transition-all hover:-translate-y-0.5">
              🐱 探望小猫派派 ↗
            </a>
            <a href="/messageboard" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-white/8 dark:bg-white/8 hover:bg-white/15 text-zinc-900 dark:text-white font-medium text-sm border border-zinc-200 dark:border-white/15 transition-all hover:-translate-y-0.5">
              💌 留言 / 友链
            </a>
          </div>
        </div>
      </div>

      <!-- Metrics -->
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mt-10 pt-8 border-t border-zinc-200 dark:border-white/10">
        {metrics.map(m => (
          <div class="text-center md:text-left p-2 rounded-xl hover:bg-white/5 transition-colors">
            <div class="text-2xl md:text-3xl font-extrabold text-zinc-900 dark:text-white">{m.value}</div>
            <div class="text-xs text-zinc-500 dark:text-zinc-400 mt-0.5">{m.label}</div>
          </div>
        ))}
      </div>
    </div>

    <!-- Visual Interest & Pet Cards -->
    <div class="space-y-4">
      <h2 class="text-xl font-bold text-zinc-900 dark:text-white flex items-center gap-2">
        🎨 兴趣、派派与生活切片
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        {interests.map(item => {
          const Wrapper = item.href ? 'a' : 'div';
          return (
            <Wrapper
              href={item.href}
              target={item.href ? '_blank' : undefined}
              rel={item.href ? 'noopener noreferrer' : undefined}
              class="tilt-card group relative h-60 rounded-2xl overflow-hidden border border-zinc-200 dark:border-white/10 shadow-lg cursor-pointer block transition-transform duration-200 ease-out will-change-transform"
            >
              <img
                src={item.img}
                alt={item.title}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 ease-out"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/30 to-transparent group-hover:from-black/90 transition-colors" />
              <span class="absolute top-3 left-3 px-2.5 py-1 rounded-full bg-black/55 backdrop-blur-md text-[10px] font-mono text-amber-300 border border-white/15">
                {item.tag}
              </span>
              <div class="absolute bottom-0 inset-x-0 p-4 text-white transform translate-y-1 group-hover:translate-y-0 transition-transform">
                <h3 class="font-bold text-sm">{item.title}</h3>
                <p class="text-[11px] text-white/75 mt-1 leading-relaxed">{item.sub}</p>
              </div>
            </Wrapper>
          );
        })}
      </div>
    </div>

    <!-- Fixed Bottom-Right Lovely Corgi (Transparent Background) -->
    <div class="fixed bottom-3 right-3 z-30 flex items-end pointer-events-none select-none" aria-hidden="true">
      <iframe
        src="/effects/lovely_dog/widget.html"
        title="可爱柯基"
        class="w-28 h-24 sm:w-32 sm:h-28 border-0 bg-transparent pointer-events-none"
      />
    </div>

    <!-- Personal Bento Cards: Profile & AI Stack tilt toward cursor -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 [perspective:1000px] pt-4">
      <div class="tilt-card p-5 rounded-2xl border border-white/25 dark:border-white/12 bg-white/60 dark:bg-zinc-900/55 backdrop-blur-md shadow-xl space-y-2 transition-transform duration-200 ease-out will-change-transform">
        <div class="text-xs font-mono text-amber-500 uppercase tracking-wider">个人档案</div>
        <div class="space-y-2 text-sm pt-1">
          <div class="flex justify-between"><span class="text-zinc-500 dark:text-zinc-400">生于</span><span class="font-semibold text-sky-500">1997 年</span></div>
          <div class="flex justify-between"><span class="text-zinc-500 dark:text-zinc-400">坐标</span><span class="font-semibold text-zinc-900 dark:text-white">中国 · 武汉市</span></div>
          <div class="flex justify-between items-center gap-2">
            <span class="text-zinc-500 dark:text-zinc-400 shrink-0">本科</span>
            <span class="font-semibold text-amber-500 inline-flex items-center gap-1.5">
              <img src="/img/logo-zuel.png" alt="中南财经政法大学" class="w-5 h-5 rounded-full object-contain bg-white p-0.5 shrink-0" />
              中南财经政法大学
            </span>
          </div>
          <div class="flex justify-between items-center gap-2">
            <span class="text-zinc-500 dark:text-zinc-400 shrink-0">硕士</span>
            <span class="font-semibold text-amber-500 inline-flex items-center gap-1.5">
              <img src="/img/logo-hust.png" alt="华中科技大学" class="w-5 h-5 rounded-full object-contain bg-white p-0.5 shrink-0" />
              华中科技大学
            </span>
          </div>
        </div>
      </div>

      <!-- ENTP Card: Large Transparent Cutout Character overflowing card borders -->
      <div class="tilt-card relative overflow-visible p-5 rounded-2xl border border-purple-400/30 bg-gradient-to-br from-purple-500/12 via-white/65 to-transparent dark:from-purple-900/25 dark:via-zinc-900/60 backdrop-blur-md shadow-xl flex items-center gap-2 transition-transform duration-200 ease-out will-change-transform">
        <img
          src="/img/entp-character.png"
          alt="ENTP 辩论家卡通形象"
          class="w-40 h-56 sm:w-44 sm:h-60 -my-14 -ml-5 scale-110 object-contain shrink-0 transition-transform duration-300 hover:rotate-3 hover:scale-125 cursor-pointer drop-shadow-2xl relative z-10"
        />
        <div class="space-y-1.5">
          <div class="text-xs font-mono text-purple-400 uppercase tracking-wider">性格与座右铭</div>
          <div class="text-xl font-extrabold text-purple-500 dark:text-purple-300">ENTP · 辩论家</div>
          <p class="text-xs text-zinc-600 dark:text-zinc-400 leading-relaxed">
            「充满好奇，保持理性。」把复杂概念拆成清晰可操作的系统。
          </p>
        </div>
      </div>

      <!-- AI Software Brand Icons Matrix (tilts toward cursor) -->
      <div class="tilt-card p-5 rounded-2xl border border-white/25 dark:border-white/12 bg-white/60 dark:bg-zinc-900/55 backdrop-blur-md shadow-xl space-y-3 transition-transform duration-200 ease-out will-change-transform">
        <div class="text-xs font-mono text-emerald-500 uppercase tracking-wider">常用 AI 共创工具栈</div>
        <div class="grid grid-cols-4 gap-2 pt-0.5">
          <!-- Claude -->
          <div class="flex flex-col items-center justify-center py-2 px-1 rounded-xl border border-[#D97757]/25 bg-white/70 dark:bg-zinc-800/70 hover:scale-105 transition-transform" title="Claude">
            <svg class="w-5 h-5 text-[#D97757]" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2v20M4.9 4.9l14.2 14.2M2 12h20M4.9 19.1L19.1 4.9M8.2 2.8l7.6 18.4M2.8 8.2l18.4 7.6M2.8 15.8l18.4-7.6M8.2 21.2l7.6-18.4" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/>
            </svg>
            <span class="text-[9px] font-mono font-bold mt-1">Claude</span>
          </div>
          <!-- OpenAI / Codex -->
          <div class="flex flex-col items-center justify-center py-2 px-1 rounded-xl border border-emerald-500/25 bg-white/70 dark:bg-zinc-800/70 hover:scale-105 transition-transform" title="OpenAI / Codex">
            <svg class="w-5 h-5 text-zinc-900 dark:text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <circle cx="12" cy="12" r="4"/>
              <path d="M12 3a5 5 0 0 1 4.3 2.5M21 12a5 5 0 0 1-2.5 4.3M12 21a5 5 0 0 1-4.3-2.5M3 12a5 5 0 0 1 2.5-4.3M7.5 4.5a5 5 0 0 1 5 0M19.5 7.5a5 5 0 0 1 0 5M16.5 19.5a5 5 0 0 1-5 0M4.5 16.5a5 5 0 0 1 0-5"/>
            </svg>
            <span class="text-[9px] font-mono font-bold mt-1">Codex</span>
          </div>
          <!-- Gemini -->
          <div class="flex flex-col items-center justify-center py-2 px-1 rounded-xl border border-blue-500/25 bg-white/70 dark:bg-zinc-800/70 hover:scale-105 transition-transform" title="Gemini">
            <svg class="w-5 h-5" viewBox="0 0 24 24">
              <defs><linearGradient id="gemG" x1="0" y1="0" x2="24" y2="24"><stop stop-color="#4285F4"/><stop offset="1" stop-color="#A855F7"/></linearGradient></defs>
              <path d="M12 2C12.8 8.2 15.8 11.2 22 12c-6.2.8-9.2 3.8-10 10-.8-6.2-3.8-9.2-10-10 6.2-.8 9.2-3.8 10-10z" fill="url(#gemG)"/>
            </svg>
            <span class="text-[9px] font-mono font-bold mt-1">Gemini</span>
          </div>
          <!-- DeepSeek -->
          <div class="flex flex-col items-center justify-center py-2 px-1 rounded-xl border border-blue-600/25 bg-white/70 dark:bg-zinc-800/70 hover:scale-105 transition-transform" title="DeepSeek">
            <svg class="w-5 h-5 text-[#2563EB]" viewBox="0 0 24 24" fill="currentColor">
              <path d="M4 13c0-4.4 3.6-8 8-8 3.2 0 5.9 1.9 7.2 4.6.6-.4 1.5-.8 2.3-.6-.4 1.2-1 2.2-1.8 2.9 0 .4.1.7.1 1.1 0 4.4-3.6 8-8 8S4 17.4 4 13zm4.5-1a1.5 1.5 0 1 0 0 3 1.5 1.5 0 0 0 0-3z"/>
            </svg>
            <span class="text-[9px] font-mono font-bold mt-1">DeepSeek</span>
          </div>
          <!-- Grok -->
          <div class="flex flex-col items-center justify-center py-2 px-1 rounded-xl border border-zinc-500/25 bg-white/70 dark:bg-zinc-800/70 hover:scale-105 transition-transform" title="Grok">
            <svg class="w-5 h-5 text-zinc-900 dark:text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2">
              <circle cx="12" cy="12" r="7"/>
              <path d="M5 19L19 5" stroke-linecap="round"/>
            </svg>
            <span class="text-[9px] font-mono font-bold mt-1">Grok</span>
          </div>
          <!-- Perplexity -->
          <div class="flex flex-col items-center justify-center py-2 px-1 rounded-xl border border-teal-500/25 bg-white/70 dark:bg-zinc-800/70 hover:scale-105 transition-transform" title="Perplexity">
            <svg class="w-5 h-5 text-zinc-900 dark:text-white" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M12 2v20M4 7l8 5 8-5M4 17l8-5 8 5M6 4v16M18 4v16"/>
            </svg>
            <span class="text-[9px] font-mono font-bold mt-1">Perplexity</span>
          </div>
          <!-- Kimi -->
          <div class="flex flex-col items-center justify-center py-2 px-1 rounded-xl border border-zinc-500/25 bg-white/70 dark:bg-zinc-800/70 hover:scale-105 transition-transform" title="Kimi">
            <svg class="w-5 h-5 text-zinc-900 dark:text-white" viewBox="0 0 24 24" fill="currentColor">
              <rect x="4" y="4" width="3.5" height="16" rx="1"/>
              <path d="M9 12l6-7h4l-6 7 6 7h-4l-6-7z"/>
              <circle cx="19" cy="5.5" r="2" fill="#3B82F6"/>
            </svg>
            <span class="text-[9px] font-mono font-bold mt-1">Kimi</span>
          </div>
          <!-- Cursor -->
          <div class="flex flex-col items-center justify-center py-2 px-1 rounded-xl border border-sky-500/25 bg-white/70 dark:bg-zinc-800/70 hover:scale-105 transition-transform" title="Cursor">
            <svg class="w-5 h-5 text-sky-500" viewBox="0 0 24 24" fill="currentColor">
              <polygon points="12,2 21,7 21,17 12,22 3,17 3,7" fill-opacity="0.2" stroke="currentColor" stroke-width="1.8"/>
              <polygon points="12,6 18,12 12,18 9,12"/>
            </svg>
            <span class="text-[9px] font-mono font-bold mt-1">Cursor</span>
          </div>
        </div>
      </div>
    </div>

    <!-- Skills matrix with Animated Glowing Border Flow (描边流光效果) -->
    <div class="space-y-5">
      <h2 class="text-xl font-bold text-zinc-900 dark:text-white flex items-center gap-2">
        ⚙️ 全栈能力全景图
      </h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
        {skills.map(s => (
          <div class="tilt-card glow-card relative rounded-2xl p-[3px] overflow-hidden group hover:shadow-2xl transition-all duration-200 ease-out will-change-transform">
            {/* Single-color flowing conic gradient marquee border — visible ONLY on hover */}
            <div class={`absolute inset-[-120%] bg-[conic-gradient(from_0deg,transparent_0_200deg,currentColor_290deg,transparent_360deg)] animate-[spin_2.2s_linear_infinite] opacity-0 group-hover:opacity-100 transition-opacity duration-300 ${s.color}`} />
            <div class="relative h-full rounded-[13px] bg-white/95 dark:bg-zinc-900/95 backdrop-blur-xl p-5 space-y-4">
              <h3 class={`font-bold text-sm ${s.color}`}>{s.category}</h3>
              <div class="space-y-3">
                {s.items.map(it => (
                  <div>
                    <div class="text-sm font-semibold text-zinc-900 dark:text-white flex items-center gap-1.5">
                      <span class={`w-1.5 h-1.5 rounded-full ${s.color.replace('text-', 'bg-')}`}></span>
                      {it.name}
                    </div>
                    <div class="text-xs text-zinc-600 dark:text-zinc-400 pl-3 mt-0.5 leading-relaxed">{it.desc}</div>
                  </div>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Timeline -->
    <div class="space-y-5">
      <h2 class="text-xl font-bold text-zinc-900 dark:text-white flex items-center gap-2">
        🚀 经历与创作足迹
      </h2>
      <div class="relative pl-6 border-l border-zinc-200 dark:border-white/10 space-y-6">
        {timeline.map(item => (
          <div class="relative group p-4 rounded-2xl hover:bg-white/50 dark:hover:bg-zinc-900/50 transition-colors">
            <div class="absolute -left-[31px] top-6 w-3.5 h-3.5 rounded-full border-2 border-white dark:border-zinc-900 bg-amber-400 group-hover:scale-125 transition-transform"></div>
            <div class="text-xs font-mono text-amber-500 uppercase tracking-wider">
              {item.period} · <span class="text-zinc-500 dark:text-zinc-400 normal-case tracking-normal font-normal">{item.org}</span>
            </div>
            <h3 class="text-base font-bold text-zinc-900 dark:text-white mt-1 group-hover:text-terracotta transition-colors">{item.role}</h3>
            <p class="text-sm text-zinc-600 dark:text-zinc-400 mt-1.5 leading-relaxed">{item.highlight}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Contact CTA -->
    <div class="tilt-card rounded-3xl border border-zinc-200 dark:border-white/10 bg-gradient-to-r from-amber-500/8 via-purple-500/8 to-blue-500/8 p-8 text-center space-y-4 transition-transform duration-200 ease-out will-change-transform">
      <h3 class="text-xl font-bold text-zinc-900 dark:text-white">想聊产品、AI 协作，或者交换友链？</h3>
      <p class="text-zinc-600 dark:text-zinc-400 text-sm max-w-xl mx-auto">
        无论是探讨 Agent 架构、产品设计方案，还是交流前沿视效灵感，都欢迎随时联系。
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a id="about-email-btn" href="mailto:2472919073@qq.com" class="px-5 py-2.5 rounded-xl bg-zinc-900 dark:bg-white text-white dark:text-black font-semibold text-sm hover:opacity-90 transition-opacity shadow-lg">
          发邮件联系
        </a>
        <a href="/messageboard" class="px-5 py-2.5 rounded-xl border border-zinc-200 dark:border-white/15 text-zinc-900 dark:text-white font-medium text-sm hover:bg-zinc-100 dark:hover:bg-white/8 transition-colors">
          互动留言板
        </a>
      </div>
    </div>

    <!-- Full-Bleed Borderless Canvas Crowd at Bottom (taller, zero scrollbars) -->
    <div class="w-screen relative left-1/2 -translate-x-1/2 overflow-hidden">
      <iframe
        src="/effects/canvas_crowd/index.html"
        title="Canvas 人群动画"
        loading="lazy"
        scrolling="no"
        class="w-full h-80 sm:h-96 border-0 block overflow-hidden"
      />
    </div>

  </div>

  <script is:inline>
    (function () {
      // Mouse-direction 3D tilt for Profile & AI Stack cards
      const initTilt = () => {
        document.querySelectorAll('.tilt-card').forEach((card) => {
          if (card.dataset.tiltBound) return;
          card.dataset.tiltBound = '1';
          card.addEventListener('mousemove', (e) => {
            const rect = card.getBoundingClientRect();
            const dx = (e.clientX - rect.left) / rect.width - 0.5;
            const dy = (e.clientY - rect.top) / rect.height - 0.5;
            card.style.transform = `perspective(900px) rotateX(${(-dy * 14).toFixed(2)}deg) rotateY(${(dx * 14).toFixed(2)}deg) translateY(-4px)`;
          });
          card.addEventListener('mouseleave', () => {
            card.style.transform = 'perspective(900px) rotateX(0deg) rotateY(0deg) translateY(0px)';
          });
        });
      };
      initTilt();
      document.addEventListener('astro:page-load', initTilt);

      try {
        var raw = localStorage.getItem('about_config');
        if (!raw) return;
        var cfg = JSON.parse(raw);
        if (cfg.bio) {
          var bioEl = document.getElementById('about-bio');
          if (bioEl) bioEl.textContent = cfg.bio;
        }
        if (cfg.email) {
          var mailEl = document.getElementById('about-email-btn');
          if (mailEl) mailEl.setAttribute('href', 'mailto:' + cfg.email);
        }
      } catch (e) {}
    })();
  </script>

  <style>
    @keyframes pixelPatrol {
      0% { transform: translateX(0); }
      48% { transform: translateX(calc(100% - 170px)); }
      50% { transform: translateX(calc(100% - 170px)) scaleX(-1); }
      98% { transform: translateX(0) scaleX(-1); }
      100% { transform: translateX(0) scaleX(1); }
    }
    @keyframes pixelStep1 {
      0%, 49% { display: block; }
      50%, 100% { display: none; }
    }
    @keyframes pixelStep2 {
      0%, 49% { display: none; }
      50%, 100% { display: block; }
    }
    .pixel-walker {
      width: 100%;
      animation: pixelPatrol 14s linear infinite;
    }
    .pixel-walk-f1 {
      animation: pixelStep1 0.45s steps(1) infinite;
    }
    .pixel-walk-f2 {
      animation: pixelStep2 0.45s steps(1) infinite;
    }
  </style>
</Layout>
