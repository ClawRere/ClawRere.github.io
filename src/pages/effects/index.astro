---
import Layout from '@/layouts/Layout.astro';
import { Sparkles, Play, Code2, Layers, ExternalLink } from 'lucide-react';
---

<Layout title="实验室 | 磊大大 Larry - 动效与交互演练场">
  <div class="py-8">
    <div class="max-w-2xl">
      <div class="inline-flex items-center gap-1.5 text-xs font-mono uppercase tracking-wider text-terracotta mb-2">
        <Sparkles class="w-3.5 h-3.5" />
        Interactive Playground & Effects
      </div>
      <h1 class="font-serif text-3xl sm:text-4xl font-medium text-charcoal-DEFAULT dark:text-cream-50">
        动效与交互实验室
      </h1>
      <p class="mt-3 text-sm text-charcoal-100 dark:text-cream-300 leading-relaxed">
        收录原生 Web 动效、Canvas 微交互与 Shader 视觉实验。这里也是原 Hexo 站点 <code class="px-1.5 py-0.5 rounded bg-cream-200 dark:bg-obsidian-border text-xs font-mono">source/effects</code> 特效集向现代组件化转型的试验场。
      </p>
    </div>

    <!-- Effects Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mt-10">
      <!-- Effect 1: Apple Spotlight Glow Card -->
      <div class="p-6 rounded-2xl glass border border-charcoal-500/10 dark:border-white/10 hover:border-terracotta/40 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="h-32 rounded-xl bg-gradient-to-br from-terracotta/10 via-amber-500/10 to-transparent flex items-center justify-center border border-charcoal-500/5 dark:border-white/5 relative overflow-hidden group">
            <div class="w-16 h-16 rounded-full bg-terracotta/20 blur-xl group-hover:scale-150 transition-transform duration-500" />
            <Sparkles class="w-8 h-8 text-terracotta z-10 animate-pulse" />
          </div>
          <h3 class="font-serif text-lg font-medium text-charcoal-DEFAULT dark:text-cream-50 mt-4">
            Apple 风格光影跟随 (Spotlight Glow)
          </h3>
          <p class="mt-2 text-xs text-charcoal-100 dark:text-cream-300 leading-relaxed">
            实时侦听光标相对于容器网格的物理坐标，利用径向渐变蒙版渲染微米级发光边缘。
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-charcoal-500/10 dark:border-white/10 flex items-center justify-between text-xs font-mono text-terracotta">
          <span>React + Tailwind</span>
          <span class="hover:underline cursor-pointer">交互体验中 ✓</span>
        </div>
      </div>

      <!-- Effect 2: Spring Physics Dock -->
      <div class="p-6 rounded-2xl glass border border-charcoal-500/10 dark:border-white/10 hover:border-terracotta/40 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="h-32 rounded-xl bg-gradient-to-br from-blue-500/10 to-indigo-500/10 flex items-center justify-center border border-charcoal-500/5 dark:border-white/5">
            <Layers class="w-8 h-8 text-blue-500" />
          </div>
          <h3 class="font-serif text-lg font-medium text-charcoal-DEFAULT dark:text-cream-50 mt-4">
            macOS 灵动悬浮 Dock 导航
          </h3>
          <p class="mt-2 text-xs text-charcoal-100 dark:text-cream-300 leading-relaxed">
            基于 Framer Motion 物理弹簧阻尼与 layoutId 共享布局，实现丝滑指示器位移与高斯模糊吸顶。
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-charcoal-500/10 dark:border-white/10 flex items-center justify-between text-xs font-mono text-terracotta">
          <span>Framer Motion</span>
          <span class="hover:underline cursor-pointer">全局常驻 ✓</span>
        </div>
      </div>

      <!-- Effect 3: HTML Effects Sandbox Hub -->
      <div class="p-6 rounded-2xl glass border border-charcoal-500/10 dark:border-white/10 hover:border-terracotta/40 transition-all duration-300 flex flex-col justify-between">
        <div>
          <div class="h-32 rounded-xl bg-gradient-to-br from-amber-500/10 to-emerald-500/10 flex items-center justify-center border border-charcoal-500/5 dark:border-white/5">
            <Code2 class="w-8 h-8 text-amber-500" />
          </div>
          <h3 class="font-serif text-lg font-medium text-charcoal-DEFAULT dark:text-cream-50 mt-4">
            HTML+CSS+JS 特效展厅矩阵
          </h3>
          <p class="mt-2 text-xs text-charcoal-100 dark:text-cream-300 leading-relaxed">
            规划将原项目 100+ 个独立 HTML 特效以沙盒（iframe/Sandpack）形式集成，免受框架样式污染。
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-charcoal-500/10 dark:border-white/10 flex items-center justify-between text-xs font-mono text-charcoal-100 dark:text-cream-400">
          <span>待接入模块</span>
          <span>敬请期待</span>
        </div>
      </div>
    </div>
  </div>
</Layout>
