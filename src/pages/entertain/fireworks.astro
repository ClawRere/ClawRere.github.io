---
import Layout from '@/layouts/Layout.astro';
import { ArrowLeft, Maximize2, Sparkles } from 'lucide-react';
---

<Layout title="烟花模拟器 | 磊大大 Larry" hideFooter={true} fullWidth={true}>
  <div class="fixed inset-0 pt-14 bg-black z-20 flex flex-col">
    <!-- Floating Back & Tip Bar -->
    <div class="absolute top-20 left-6 right-6 z-30 flex items-center justify-between pointer-events-none">
      <a
        href="/"
        class="pointer-events-auto inline-flex items-center gap-2 px-4 py-2 rounded-full bg-black/60 hover:bg-black/80 backdrop-blur-md text-white text-xs font-mono border border-white/20 transition-all shadow-lg"
      >
        <ArrowLeft class="w-3.5 h-3.5" />
        返回首页
      </a>

      <div class="hidden sm:flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-black/50 backdrop-blur-md text-amber-300 text-xs font-mono border border-white/10">
        <Sparkles class="w-3.5 h-3.5 animate-pulse" />
        <span>点击屏幕任意位置引燃烟花</span>
      </div>

      <a
        href="/effects/fireworks/index.html"
        target="_blank"
        rel="noreferrer"
        class="pointer-events-auto inline-flex items-center gap-1.5 px-3.5 py-2 rounded-full bg-black/60 hover:bg-black/80 backdrop-blur-md text-white/80 hover:text-white text-xs font-mono border border-white/20 transition-all"
      >
        <Maximize2 class="w-3.5 h-3.5" />
        <span class="hidden sm:inline">独立窗口</span>
      </a>
    </div>

    <iframe
      src="/effects/fireworks/index.html"
      class="w-full h-full border-0 flex-1"
      title="烟花模拟器"
      allowFullScreen
    />
  </div>
</Layout>
