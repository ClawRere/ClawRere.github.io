---
import Layout from '@/layouts/Layout.astro';
import { Sparkles, Music, CloudRain, Flame, Gamepad2, ArrowUpRight, Play, Bot } from 'lucide-react';

const entertainModules = [
  {
    title: '93+ 原生交互特效实验室 (Effects Lab)',
    desc: '收录原博客全部 93+ 个 HTML/CSS/JS 原生视效、粒子、按钮与 3D 动效，支持分类检索与在线实时预览。',
    icon: Sparkles,
    link: '/effects',
    color: 'from-violet-500/20 to-fuchsia-500/20',
    tag: '特效合集',
    badge: '93+ Live Demos',
  },
  {
    title: '网易云音乐馆 (Music Lounge)',
    desc: '沉浸式黑胶唱片试听室，收录磊大大的私人歌单，支持在线播放与歌词律动。',
    icon: Music,
    link: '/entertain/music',
    color: 'from-rose-500/20 to-terracotta/20',
    tag: '音乐随行',
    badge: 'NetEase 901594222',
  },
  {
    title: '烟花模拟器 (Fireworks Display)',
    desc: '交互式全屏粒子烟花。鼠标点击屏幕任意位置，即刻绽放绚烂的多彩光芒。',
    icon: Flame,
    link: '/entertain/fireworks',
    color: 'from-amber-500/20 to-orange-500/20',
    tag: '视觉盛宴',
    badge: 'Canvas 粒子模拟',
  },
  {
    title: '雨夜电影院与白噪音 (Rain & Cinema)',
    desc: '逼真雨丝滑落动效与清脆的雨声白噪音，适合深夜专注编程与思考。',
    icon: CloudRain,
    link: '/entertain/rain',
    color: 'from-sky-500/20 to-blue-500/20',
    tag: '沉浸白噪音',
    badge: 'Audio + Canvas',
  },
  {
    title: '擎天柱 3D 变形金刚 (Optimus Prime)',
    desc: '纯 CSS 打造的 3D 擎天柱卡车与机器人变形动画，支持视角自由拖拽把玩。',
    icon: Bot,
    link: '/effects/optimus_prime/index.html',
    color: 'from-red-500/20 to-blue-600/20',
    tag: '硬核 3D 动效',
    badge: 'CSS3 3D Transform',
  },
  {
    title: '复古飞机大战 (Flight Battle)',
    desc: '经典街机风格竖版弹幕射击游戏，拾取道具击落敌机，挑战最高分数！',
    icon: Gamepad2,
    link: '/effects/flight_game/index.html',
    color: 'from-emerald-500/20 to-teal-500/20',
    tag: '街机小游戏',
    badge: 'HTML5 Arcade',
  },
  {
    title: '急速赛车模拟 (Car Racing)',
    desc: '极简 2D 赛车避障小游戏，键盘左右键高速变道超车，解压神器。',
    icon: Gamepad2,
    link: '/effects/car_racing_game/index.html',
    color: 'from-purple-500/20 to-indigo-500/20',
    tag: '休闲避障',
    badge: 'Canvas Game',
  },
];
---

<Layout title="娱乐馆 | 音乐、烟花与雨声 | 磊大大 Larry">
  <div class="py-8 space-y-10">
    <!-- Header -->
    <div class="max-w-2xl">
      <div class="inline-flex items-center gap-1.5 text-xs font-mono uppercase tracking-wider text-terracotta mb-2 font-semibold">
        <Sparkles class="w-3.5 h-3.5" />
        Entertainment Lounge
      </div>
      <h1 class="font-serif text-3xl sm:text-4xl font-bold text-charcoal-DEFAULT dark:text-cream-50">
        娱乐与休闲体验馆
      </h1>
      <p class="mt-3 text-sm text-charcoal-100 dark:text-cream-300 leading-relaxed font-serif">
        工作与代码之外的趣味避风港。收录从 Hexo 经典继承的网易云音乐馆、交互式烟花模拟器、雨声白噪音与街机小游戏。
      </p>
    </div>

    <!-- Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {entertainModules.map((item) => {
        const Icon = item.icon;
        return (
          <a
            href={item.link}
            class="group p-6 rounded-3xl glass border border-charcoal-500/10 dark:border-white/10 hover:border-terracotta/40 dark:hover:border-terracotta/40 hover:shadow-2xl transition-all duration-300 flex flex-col justify-between"
          >
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class={`w-12 h-12 rounded-2xl bg-gradient-to-br ${item.color} flex items-center justify-center text-terracotta border border-charcoal-500/5 dark:border-white/5 group-hover:scale-110 transition-transform`}>
                  <Icon class="w-6 h-6" />
                </div>
                <span class="px-2.5 py-1 rounded-full bg-cream-200/80 dark:bg-obsidian-border text-[10px] font-mono text-charcoal-200 dark:text-cream-300">
                  {item.badge}
                </span>
              </div>

              <h2 class="font-serif text-xl font-bold text-charcoal-DEFAULT dark:text-cream-50 group-hover:text-terracotta transition-colors">
                {item.title}
              </h2>

              <p class="mt-2 text-xs sm:text-sm text-charcoal-100 dark:text-cream-300 leading-relaxed line-clamp-3">
                {item.desc}
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-charcoal-500/10 dark:border-white/10 flex items-center justify-between text-xs font-mono text-terracotta">
              <span>{item.tag}</span>
              <span class="flex items-center gap-1 group-hover:translate-x-1 transition-transform font-medium">
                进入体验 →
              </span>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</Layout>
