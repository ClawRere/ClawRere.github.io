---
import Layout from '@/layouts/Layout.astro';
import { MusicLounge } from '@/components/entertain/MusicLounge';
import { ArrowLeft } from 'lucide-react';
---

<Layout title="音乐馆 | 磊大大の小栈" sideTitle="私人音乐馆">
  <div class="py-8 space-y-6 max-w-5xl mx-auto">
    <a
      href="/"
      class="inline-flex items-center gap-1.5 text-xs font-mono text-charcoal-100 dark:text-cream-400 hover:text-terracotta transition-colors"
    >
      <ArrowLeft class="w-3.5 h-3.5" />
      返回首页
    </a>

    <MusicLounge client:load />
  </div>
</Layout>
