---
import Layout from '@/layouts/Layout.astro';
import { HeroCover } from '@/components/home/HeroCover';
import { CoCreationBadge } from '@/components/portfolio/CoCreationBadge';
import { getCollection } from 'astro:content';
import { getPostCover } from '@/lib/covers';
import { ArrowUpRight, BookOpen, Sparkles, Calendar, Gamepad2, Wrench, Link2, MessageSquare, GraduationCap } from 'lucide-react';

const allProjects = (await getCollection('projects')).filter(p => !p.data.hidden);
const featuredProjects = allProjects
  .filter(p => p.data.featured && p.data.description)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 4);

const isEmbeddableDemo = (url?: string | null) =>
  !!url && !url.includes('mp.weixin.qq.com');

const allPosts = await getCollection('posts');
const latestPosts = allPosts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);
---

<Layout title="磊大大 Larry | AI 产品经理与共创作品集" fullWidth={true}>
  <!-- Full viewport hero cover (1st screen, lightweight & interactive) -->
  <HeroCover client:load />

  <!-- Page body content inside constrained container -->
  <div id="hub-section" class="max-w-7xl mx-auto px-4 sm:px-6 pt-10 pb-20 space-y-20">

    <!-- Unified 7 Cards: Wider Spread, Larger Size, Clean Top Title (No Black Mask) -->
    <section id="second-screen-cards" class="relative z-30 pt-2 pb-6">
      <div class="group/fan grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-7 gap-5 sm:gap-6 items-center">
        {[
          { href: '/portfolio', title: '作品集', img: '/img/fan/card-1.svg', rot: -15, arcY: 46, spreadX: -44 },
          { href: '/effects', title: '93+ 动效', img: '/img/fan/card-2.svg', rot: -10, arcY: 22, spreadX: -26 },
          { href: '/posts', title: '博客归档', img: '/img/fan/card-3.svg', rot: -5, arcY: 7, spreadX: -12 },
          { href: '/tools', title: '工具箱', img: '/img/fan/card-4.svg', rot: 0, arcY: 0, spreadX: 0 },
          { href: '/links', title: '友链导航', img: '/img/fan/card-5.svg', rot: 5, arcY: 7, spreadX: 12 },
          { href: '/entertain/music', title: '音乐电台', img: '/img/fan/card-6.svg', rot: 10, arcY: 22, spreadX: 26 },
          { href: '/messageboard', title: '留言板', img: '/img/fan/card-7.svg', rot: 15, arcY: 46, spreadX: 44 },
        ].map((card, i) => (
          <a
            href={card.href}
            data-rot={card.rot}
            data-arcy={card.arcY}
            data-spreadx={card.spreadX}
            style={`--bob-delay:${i * 0.35}s;`}
            class="unified-fan-card group/card relative block aspect-[3/4] will-change-transform group-hover/fan:opacity-75 hover:!opacity-100 hover:z-40"
          >
            <div class="w-full h-full rounded-2xl overflow-hidden border border-white/60 dark:border-white/15 ring-1 ring-inset ring-white/40 shadow-[0_14px_30px_rgba(31,36,48,0.22)] transition-all duration-300 ease-out group-hover/card:-translate-y-5 group-hover/card:scale-105 group-hover/card:ring-2 group-hover/card:ring-terracotta group-hover/card:shadow-[0_24px_48px_rgba(31,36,48,0.34)]">
              <img src={card.img} alt={card.title} loading="lazy" class="w-full h-full object-cover rounded-2xl group-hover/card:scale-105 transition-transform duration-500" />
              <div class="absolute inset-x-0 top-2.5 flex justify-center pointer-events-none">
                <span class="px-2.5 py-0.5 rounded-full bg-white/85 dark:bg-zinc-900/80 text-[#1F2430] dark:text-white text-[11px] font-bold tracking-wider shadow-sm">
                  {card.title}
                </span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <style>
      @keyframes cardFloatBob {
        0%, 100% { transform: translate3d(0, 0px, 0) rotate(0deg); }
        50% { transform: translate3d(0, -8px, 0) rotate(0deg); }
      }
      .unified-fan-card.is-settled {
        animation: cardFloatBob 3.4s ease-in-out infinite;
        animation-delay: var(--bob-delay, 0s);
      }
    </style>

    <script is:inline>
      (() => {
        let rafId = null;
        const initUnifiedCards = () => {
          const cards = Array.from(document.querySelectorAll('.unified-fan-card'));
          if (!cards.length) return;
          let isLocked = false;

          cards.forEach((c) => {
            c.addEventListener('click', () => {
              isLocked = true;
            });
          });

          const update = () => {
            rafId = null;
            if (isLocked) return;
            const vh = window.innerHeight || 800;
            const p = Math.max(0, Math.min(1, window.scrollY / (vh * 0.85)));
            const ease = 1 - Math.pow(1 - p, 3);
            const isMobile = window.innerWidth < 1024;

            cards.forEach((card) => {
              if (p >= 0.98) {
                card.classList.add('is-settled');
                card.style.transform = '';
                return;
              }
              card.classList.remove('is-settled');
              const rot0 = Number(card.dataset.rot || 0);
              const arcY0 = Number(card.dataset.arcy || 0);
              const spreadX0 = Number(card.dataset.spreadx || 0);
              // Richer downward drift + subtle arc-to-row spread
              const liftY = isMobile ? -155 : -245;
              const curY = (liftY + arcY0) * (1 - ease) + Math.sin(ease * Math.PI) * 18;
              const curX = isMobile ? 0 : spreadX0 * (1 - ease);
              const curRot = rot0 * (1 - ease);
              const curScale = 1.22 - 0.22 * ease;
              card.style.transform = `translate3d(${curX.toFixed(1)}px, ${curY.toFixed(1)}px, 0) rotate(${curRot.toFixed(2)}deg) scale(${curScale.toFixed(3)})`;
            });
          };

          const onScroll = () => {
            if (!rafId && !isLocked) rafId = requestAnimationFrame(update);
          };

          update();
          window.addEventListener('scroll', onScroll, { passive: true });
          window.addEventListener('resize', onScroll, { passive: true });
        };

        initUnifiedCards();
        document.addEventListener('astro:page-load', initUnifiedCards);
      })();
    </script>

    <!-- Featured projects (4 core cases + 2 edu mini cards) -->
    {featuredProjects.length > 0 && (
      <section class="space-y-8">
        <div class="flex items-end justify-between pb-4 border-b border-charcoal-500/8 dark:border-white/8">
          <div>
            <div class="text-xs font-mono uppercase tracking-widest text-terracotta mb-1 font-semibold flex items-center gap-1.5">
              <Sparkles class="w-3.5 h-3.5" /> Selected Works
            </div>
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-charcoal-DEFAULT dark:text-cream-50">产品与 AI 作品精选</h2>
          </div>
          <a href="/portfolio" class="text-xs sm:text-sm font-mono text-terracotta hover:underline inline-flex items-center gap-1">
            全部作品 ({allProjects.length}) <ArrowUpRight class="w-4 h-4" />
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {featuredProjects.map(project => {
            const canEmbed = isEmbeddableDemo(project.data.demoUrl);
            return (
            <div class="group flex flex-col rounded-[20px] border border-charcoal-500/10 dark:border-white/10 ring-1 ring-inset ring-white/40 dark:ring-white/10 overflow-hidden hover:border-terracotta/30 shadow-[0_12px_32px_rgba(31,36,48,0.12)] hover:shadow-[0_22px_48px_rgba(31,36,48,0.22)] hover:-translate-y-1.5 transition-all duration-500 ease-[cubic-bezier(0.25,0.75,0.2,1)] bg-white/70 dark:bg-zinc-900/65 backdrop-blur-md">
              <div class="h-56 w-full relative overflow-hidden bg-zinc-950">
                <a href={`/portfolio/${project.id}`} class="block w-full h-full">
                  <img src={project.data.cover} alt={project.data.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out" loading="lazy" />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent" />
                </a>
                {canEmbed && (
                  <span class="absolute top-3 right-3 px-2.5 py-0.5 rounded-full bg-emerald-500/90 text-white text-[10px] font-mono font-semibold shadow pointer-events-none">● DEMO</span>
                )}
                <span class="absolute top-3 left-3 px-3 py-1 rounded-full bg-black/55 backdrop-blur-md text-[11px] font-mono text-white/90 border border-white/15 pointer-events-none">{project.data.category}</span>
              </div>
              <div class="p-6 flex-1 flex flex-col justify-between">
                <div>
                  <h3 class="font-serif text-xl font-bold text-charcoal-DEFAULT dark:text-cream-50 group-hover:text-terracotta transition-colors leading-snug">
                    <a href={`/portfolio/${project.id}`}>{project.data.title}</a>
                  </h3>
                  <p class="mt-2.5 text-sm text-charcoal-100 dark:text-cream-300 line-clamp-2 leading-relaxed">{project.data.description}</p>
                </div>
                <div class="mt-5 pt-4 border-t border-charcoal-500/8 dark:border-white/8 flex items-center justify-between gap-3">
                  <CoCreationBadge humanShare={project.data.coCreation.humanShare} aiShare={project.data.coCreation.aiShare} models={project.data.coCreation.models} />
                  <a href={`/portfolio/${project.id}`} class="text-xs font-mono text-terracotta group-hover:translate-x-1 transition-transform inline-flex items-center gap-1 font-semibold">
                    复盘分析 →
                  </a>
                </div>
              </div>
            </div>
            );
          })}
        </div>
      </section>
    )}

    <!-- Latest blog posts -->
    <section>
      <div class="flex items-end justify-between mb-8 pb-4 border-b border-charcoal-500/8 dark:border-white/8">
        <div>
          <div class="text-xs font-mono uppercase tracking-widest text-amber-500 mb-1 font-semibold flex items-center gap-1.5">
            <BookOpen class="w-3.5 h-3.5" /> Technical Blog
          </div>
          <h2 class="font-serif text-2xl sm:text-3xl font-bold text-charcoal-DEFAULT dark:text-cream-50">最新博客精选</h2>
        </div>
        <a href="/posts" class="text-xs sm:text-sm font-mono text-terracotta hover:underline inline-flex items-center gap-1">
          全部文章 ({allPosts.length}) <ArrowUpRight class="w-4 h-4" />
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {latestPosts.map((post, idx) => {
          const coverImg = getPostCover(post.data.cover, post.data.title, idx, post.body);
          const categoryName = Array.isArray(post.data.categories) ? post.data.categories[0] : post.data.categories || '笔记';
          return (
            <a href={`/posts/${post.id}`} class="group flex flex-col rounded-[18px] border border-charcoal-500/10 dark:border-white/10 ring-1 ring-inset ring-white/40 dark:ring-white/10 overflow-hidden hover:border-terracotta/30 shadow-[0_10px_28px_rgba(31,36,48,0.10)] hover:shadow-[0_18px_40px_rgba(31,36,48,0.18)] hover:-translate-y-1.5 transition-all duration-500 ease-[cubic-bezier(0.25,0.75,0.2,1)] bg-white/65 dark:bg-zinc-900/55 backdrop-blur-sm">
              <div class="h-44 relative overflow-hidden">
                <img src={coverImg} alt={post.data.title} loading="lazy" onerror="this.onerror=null;this.src='/img/starry-sky.jpg';" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent" />
                <span class="absolute top-3 left-3 px-2.5 py-1 rounded-full bg-black/50 backdrop-blur-md text-[10px] font-mono text-white/90 border border-white/15">{categoryName}</span>
              </div>
              <div class="p-5 flex-1 flex flex-col">
                <div class="flex items-center gap-2 text-[11px] font-mono text-charcoal-100 dark:text-cream-400 mb-2">
                  <Calendar class="w-3 h-3 text-terracotta" />
                  <span>{new Date(post.data.date).toLocaleDateString('zh-CN')}</span>
                </div>
                <h3 class="font-bold text-base text-charcoal-DEFAULT dark:text-cream-50 group-hover:text-terracotta transition-colors line-clamp-2 leading-snug flex-1">{post.data.title}</h3>
                <div class="mt-4 pt-3 border-t border-charcoal-500/8 dark:border-white/8 flex items-center justify-between text-xs font-mono text-terracotta">
                  <span>阅读文章</span>
                  <ArrowUpRight class="w-4 h-4 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
                </div>
              </div>
            </a>
          );
        })}
      </div>
    </section>

  </div>
</Layout>
