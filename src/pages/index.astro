---
import Layout from '@/layouts/Layout.astro';
import { BentoGrid } from '@/components/portfolio/BentoGrid';
import { CoCreationBadge } from '@/components/portfolio/CoCreationBadge';
import { getCollection } from 'astro:content';
import { getPostCover } from '@/lib/covers';
import { ArrowUpRight, BookOpen, Sparkles, Calendar, Wand2, Star } from 'lucide-react';

// Fetch projects and posts
const allProjects = await getCollection('projects');
const featuredProjects = allProjects
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 4);

const allPosts = await getCollection('posts');
const latestPosts = allPosts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);
---

<Layout title="磊大大 Larry | AI 产品经理与共创作品集">
  <!-- 1. Apple x Claude Interactive Bento Grid Hero -->
  <BentoGrid client:load />

  <!-- 2. AI Co-Creation Showcases Section (Visual Cards) -->
  <section class="my-16">
    <div class="flex items-end justify-between mb-8 pb-4 border-b border-charcoal-500/10 dark:border-white/10">
      <div>
        <div class="inline-flex items-center gap-1.5 text-xs font-mono uppercase tracking-wider text-terracotta mb-1 font-semibold">
          <Sparkles class="w-3.5 h-3.5" />
          Selected Works & Products
        </div>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-charcoal-DEFAULT dark:text-cream-50">
          AI 产品与共创作品精选
        </h2>
      </div>
      <a
        href="/portfolio"
        class="text-xs sm:text-sm font-mono text-terracotta hover:underline inline-flex items-center gap-1"
      >
        浏览全部作品集 ({allProjects.length})
        <ArrowUpRight class="w-4 h-4" />
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {featuredProjects.map((project) => (
        <div class="group flex flex-col rounded-3xl glass overflow-hidden border border-charcoal-500/10 dark:border-white/10 hover:border-terracotta/40 dark:hover:border-terracotta/40 hover:shadow-2xl transition-all duration-300">
          <a href={`/portfolio/${project.id}`} class="h-52 w-full relative overflow-hidden bg-cream-200 dark:bg-obsidian-card block">
            <img
              src={project.data.cover}
              alt={project.data.title}
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent opacity-70" />

            <span class="absolute top-4 left-4 px-3 py-1 rounded-full bg-white/90 dark:bg-black/80 backdrop-blur-md text-[11px] font-mono font-medium text-charcoal-DEFAULT dark:text-cream-100 shadow-sm">
              {project.data.category}
            </span>
          </a>

          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <h3 class="font-serif text-xl font-bold text-charcoal-DEFAULT dark:text-cream-50 group-hover:text-terracotta transition-colors leading-snug">
                <a href={`/portfolio/${project.id}`}>
                  {project.data.title}
                </a>
              </h3>

              <p class="mt-2.5 text-xs sm:text-sm text-charcoal-100 dark:text-cream-300 line-clamp-2 leading-relaxed">
                {project.data.description}
              </p>
            </div>

            <div class="mt-6 pt-4 border-t border-charcoal-500/10 dark:border-white/10 flex flex-wrap items-center justify-between gap-3">
              <CoCreationBadge
                humanShare={project.data.coCreation.humanShare}
                aiShare={project.data.coCreation.aiShare}
                models={project.data.coCreation.models}
              />

              <a
                href={`/portfolio/${project.id}`}
                class="text-xs font-mono font-medium text-terracotta flex items-center gap-1 group-hover:translate-x-1 transition-transform"
              >
                复盘分析 →
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 3. Recent Technical Blog Notes Section (With Visual Image Cards) -->
  <section class="my-16">
    <div class="flex items-end justify-between mb-8 pb-4 border-b border-charcoal-500/10 dark:border-white/10">
      <div>
        <div class="inline-flex items-center gap-1.5 text-xs font-mono uppercase tracking-wider text-amber-500 mb-1 font-semibold">
          <BookOpen class="w-3.5 h-3.5" />
          Technical Blog
        </div>
        <h2 class="font-serif text-2xl sm:text-3xl font-bold text-charcoal-DEFAULT dark:text-cream-50">
          个人技术博客精选
        </h2>
      </div>
      <a
        href="/posts"
        class="text-xs sm:text-sm font-mono text-terracotta hover:underline inline-flex items-center gap-1"
      >
        检索全部文章 ({allPosts.length})
        <ArrowUpRight class="w-4 h-4" />
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {latestPosts.map((post, idx) => {
        const coverImg = getPostCover(post.data.cover, post.data.title, idx);
        const categoryName = Array.isArray(post.data.categories)
          ? post.data.categories[0]
          : post.data.categories || '技术笔记';

        return (
          <a
            href={`/posts/${post.id}`}
            class="group flex flex-col rounded-2xl glass overflow-hidden border border-charcoal-500/10 dark:border-white/10 hover:border-terracotta/40 dark:hover:border-terracotta/40 hover:shadow-xl transition-all duration-300"
          >
            <div class="h-44 w-full relative overflow-hidden bg-cream-200 dark:bg-obsidian-card">
              <img
                src={coverImg}
                alt={post.data.title}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-80" />

              <span class="absolute top-3 left-3 px-2.5 py-1 rounded-full bg-white/90 dark:bg-black/80 backdrop-blur-md text-[10px] font-mono font-medium text-charcoal-DEFAULT dark:text-cream-100 shadow-sm">
                {categoryName}
              </span>
            </div>

            <div class="p-5 flex-1 flex flex-col justify-between">
              <div>
                <div class="flex items-center gap-2 text-[11px] font-mono text-charcoal-100 dark:text-cream-400 mb-2">
                  <Calendar class="w-3 h-3 text-terracotta" />
                  <span>{new Date(post.data.date).toLocaleDateString('zh-CN')}</span>
                </div>

                <h3 class="font-serif text-base font-bold text-charcoal-DEFAULT dark:text-cream-50 group-hover:text-terracotta transition-colors line-clamp-2 leading-snug">
                  {post.data.title}
                </h3>
              </div>

              <div class="mt-4 pt-3 border-t border-charcoal-500/10 dark:border-white/10 flex items-center justify-between text-xs font-mono text-terracotta">
                <span>阅读文章</span>
                <ArrowUpRight class="w-4 h-4 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </section>
</Layout>
