---
import Layout from '@/layouts/Layout.astro';
import { BentoGrid } from '@/components/portfolio/BentoGrid';
import { CoCreationBadge } from '@/components/portfolio/CoCreationBadge';
import { getCollection } from 'astro:content';
import { ArrowUpRight, BookOpen, Sparkles, Calendar, Tag } from 'lucide-react';

// Fetch projects and posts
const allProjects = await getCollection('projects');
const featuredProjects = allProjects.slice(0, 3);

const allPosts = await getCollection('posts');
const latestPosts = allPosts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 4);
---

<Layout title="磊大大 Larry | AI 共创作品集与知识库">
  <!-- 1. Apple x Claude Interactive Bento Grid -->
  <BentoGrid client:load />

  <!-- 2. AI Co-Creation Showcases Section -->
  <section class="my-14">
    <div class="flex items-end justify-between mb-8 pb-4 border-b border-charcoal-500/10 dark:border-white/10">
      <div>
        <div class="inline-flex items-center gap-1.5 text-xs font-mono uppercase tracking-wider text-terracotta mb-1">
          <Sparkles class="w-3.5 h-3.5" />
          Selected Works
        </div>
        <h2 class="font-serif text-2xl sm:text-3xl font-medium text-charcoal-DEFAULT dark:text-cream-50">
          与 AI 共创作品精选
        </h2>
      </div>
      <a
        href="/portfolio"
        class="text-xs sm:text-sm font-medium text-terracotta hover:underline inline-flex items-center gap-1"
      >
        浏览全部作品
        <ArrowUpRight class="w-4 h-4" />
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {featuredProjects.map((project) => (
        <a
          href={`/portfolio/${project.id}`}
          class="group block p-6 rounded-2xl glass border border-charcoal-500/10 dark:border-white/10 hover:border-terracotta/40 dark:hover:border-terracotta/40 hover:shadow-apple-card transition-all duration-300"
        >
          <div class="flex items-center justify-between mb-4">
            <span class="px-2.5 py-1 rounded-full bg-cream-200/80 dark:bg-obsidian-border text-[11px] font-mono text-charcoal-200 dark:text-cream-300">
              {project.data.category}
            </span>
            <span class="text-xs font-mono text-charcoal-100 dark:text-cream-400">
              {new Date(project.data.date).getFullYear()}
            </span>
          </div>

          <h3 class="font-serif text-xl font-medium text-charcoal-DEFAULT dark:text-cream-50 group-hover:text-terracotta transition-colors">
            {project.data.title}
          </h3>

          <p class="mt-2 text-xs sm:text-sm text-charcoal-100 dark:text-cream-300 line-clamp-2 leading-relaxed">
            {project.data.description}
          </p>

          <div class="mt-6 pt-4 border-t border-charcoal-500/10 dark:border-white/10 flex items-center justify-between">
            <CoCreationBadge
              humanShare={project.data.coCreation.humanShare}
              aiShare={project.data.coCreation.aiShare}
              models={project.data.coCreation.models}
            />
            <span class="text-xs font-medium text-terracotta flex items-center gap-1 group-hover:translate-x-1 transition-transform">
              复盘详情 →
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- 3. Knowledge Base Notes Section -->
  <section class="my-14">
    <div class="flex items-end justify-between mb-8 pb-4 border-b border-charcoal-500/10 dark:border-white/10">
      <div>
        <div class="inline-flex items-center gap-1.5 text-xs font-mono uppercase tracking-wider text-amber-600 dark:text-amber-400 mb-1">
          <BookOpen class="w-3.5 h-3.5" />
          Technical Notes
        </div>
        <h2 class="font-serif text-2xl sm:text-3xl font-medium text-charcoal-DEFAULT dark:text-cream-50">
          最新技术沉淀与笔记
        </h2>
      </div>
      <a
        href="/posts"
        class="text-xs sm:text-sm font-medium text-terracotta hover:underline inline-flex items-center gap-1"
      >
        检索 99+ 篇长文
        <ArrowUpRight class="w-4 h-4" />
      </a>
    </div>

    <div class="divide-y divide-charcoal-500/10 dark:divide-white/10">
      {latestPosts.map((post) => (
        <a
          href={`/posts/${post.id}`}
          class="group py-5 flex flex-col sm:flex-row sm:items-center justify-between gap-3 hover:px-2 rounded-xl transition-all duration-200"
        >
          <div class="flex-1">
            <div class="flex items-center gap-2 text-xs font-mono text-charcoal-100 dark:text-cream-400 mb-1">
              <span class="flex items-center gap-1">
                <Calendar class="w-3 h-3" />
                {new Date(post.data.date).toLocaleDateString('zh-CN')}
              </span>
              {post.data.categories && (
                <>
                  <span>·</span>
                  <span class="text-terracotta">
                    {Array.isArray(post.data.categories) ? post.data.categories.join(', ') : post.data.categories}
                  </span>
                </>
              )}
            </div>
            <h3 class="font-serif text-lg font-medium text-charcoal-DEFAULT dark:text-cream-50 group-hover:text-terracotta transition-colors">
              {post.data.title}
            </h3>
          </div>

          <div class="flex items-center gap-2 self-start sm:self-center">
            <span class="text-xs font-medium text-charcoal-100 dark:text-cream-400 group-hover:text-terracotta transition-colors flex items-center gap-1">
              阅读全文
              <ArrowUpRight class="w-3.5 h-3.5 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
            </span>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>
