---
import Layout from '@/layouts/Layout.astro';
import { MessageBoard } from '@/components/guestbook/MessageBoard';
---

<Layout title="互动留言板与友链 | 磊大大の小栈" sideTitle="互动留言板">
  <div class="py-6">
    <MessageBoard client:load />
  </div>

  <!-- Fixed Bottom-Right Lovely Corgi -->
  <div class="fixed bottom-3 right-3 z-30 pointer-events-none select-none" aria-hidden="true">
    <iframe
      src="/effects/lovely_dog/widget.html"
      title="可爱柯基"
      class="w-28 h-24 sm:w-32 sm:h-28 border-0 bg-transparent pointer-events-none"
    />
  </div>
</Layout>
