---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const validProjects = allProjects
  .filter(p => !p.data.hidden && p.data.description && p.data.title)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const isEmbeddableDemo = (url?: string | null) =>
  !!url && !url.includes('mp.weixin.qq.com');
---

<Layout title="个人作品集合 | 磊大大の小栈" sideTitle="个人作品集合">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-6 relative">

    <div class="mb-4 xl:hidden">
      <p class="text-xs font-mono uppercase tracking-widest text-terracotta mb-1">Portfolio · {validProjects.length} projects</p>
      <h1 class="text-3xl font-extrabold text-charcoal-DEFAULT dark:text-cream-50 tracking-tight">个人作品集合</h1>
    </div>

    <!-- Faint Pale-Pink/Peach Oversized Watermark Title partially occluded by cards, rises & fades on scroll -->
    <div
      id="portfolio-watermark"
      aria-hidden="true"
      class="scroll-watermark-rise pointer-events-none select-none text-center -mb-10 sm:-mb-16 relative z-0 overflow-hidden"
    >
      <span class="block text-[20vw] sm:text-[9.5rem] lg:text-[11.5rem] font-black leading-none tracking-[0.14em] bg-gradient-to-r from-rose-300/20 via-orange-200/20 to-pink-300/20 dark:from-rose-300/15 dark:via-orange-200/15 dark:to-pink-300/15 bg-clip-text text-transparent">
        作品集
      </span>
    </div>

    <div class="relative z-10 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
      {validProjects.map((project) => {
        const canEmbed = isEmbeddableDemo(project.data.demoUrl);

        return (
          <div class="scroll-reveal-card ring-collapse group flex flex-col rounded-[18px] border border-charcoal-500/10 dark:border-white/10 ring-1 ring-inset ring-white/40 dark:ring-white/10 overflow-hidden hover:border-terracotta/30 shadow-[0_10px_28px_rgba(31,36,48,0.10)] hover:shadow-[0_18px_40px_rgba(31,36,48,0.18)] hover:-translate-y-1.5 transition-all duration-500 ease-[cubic-bezier(0.25,0.75,0.2,1)] bg-white/70 dark:bg-zinc-900/65">
            {/* Cover: Compact Custom Cover Image */}
            <div class="relative overflow-hidden bg-zinc-950 h-44">
              <a href={`/portfolio/${project.id}`} class="block w-full h-full">
                <img
                  src={project.data.cover}
                  alt={project.data.title}
                  loading="lazy"
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent" />
              </a>
              {canEmbed && (
                <span class="absolute top-3 right-3 px-2.5 py-0.5 rounded-full bg-emerald-500/90 text-white text-[10px] font-mono font-semibold shadow pointer-events-none">
                  ● DEMO
                </span>
              )}
              <span class="absolute top-3 left-3 px-2.5 py-0.5 rounded-full bg-black/60 text-[11px] font-mono text-white/95 border border-white/15 pointer-events-none">
                {project.data.category}
              </span>
            </div>

            {/* Content */}
            <div class="p-4 sm:p-5 flex-1 flex flex-col">
              <h2 class="text-lg font-bold text-charcoal-DEFAULT dark:text-cream-50 group-hover:text-terracotta transition-colors leading-snug line-clamp-2">
                <a href={`/portfolio/${project.id}`}>{project.data.title}</a>
              </h2>

              <p class="mt-2.5 text-sm text-charcoal-100 dark:text-cream-300 line-clamp-3 leading-relaxed flex-1">
                {project.data.description}
              </p>

              {project.data.tags && project.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-1.5 mt-4">
                  {project.data.tags.slice(0, 5).map((tag: string) => (
                    <span class="px-2.5 py-1 rounded-full text-xs bg-terracotta/8 text-terracotta border border-terracotta/15 font-mono">
                      {tag}
                    </span>
                  ))}
                </div>
              )}

              <div class="mt-5 pt-4 border-t border-charcoal-500/8 dark:border-white/8 flex items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                  {project.data.githubUrl && (
                    <a href={project.data.githubUrl} target="_blank" rel="noopener noreferrer" class="text-xs font-mono text-charcoal-100 dark:text-cream-400 hover:text-terracotta flex items-center gap-1 transition-colors">
                      GitHub
                    </a>
                  )}
                  {project.data.demoUrl && (
                    <a href={project.data.demoUrl} target="_blank" rel="noopener noreferrer" class="text-xs font-mono text-emerald-600 dark:text-emerald-400 hover:underline flex items-center gap-1 transition-colors">
                      打开演示 ↗
                    </a>
                  )}
                </div>
                <a href={`/portfolio/${project.id}`} class="text-sm font-semibold text-terracotta group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                  复盘详情 →
                </a>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</Layout>
