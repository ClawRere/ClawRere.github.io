---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');
const validProjects = allProjects
  .filter(p => !p.data.hidden && p.data.description && p.data.title)
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const isEmbeddableDemo = (url?: string | null) =>
  !!url && !url.includes('mp.weixin.qq.com');
---

<Layout title="AI 共创作品集 | 磊大大の小栈" sideTitle="AI 共创作品集">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-6">

    <div class="mb-6 xl:hidden">
      <p class="text-xs font-mono uppercase tracking-widest text-terracotta mb-1">Portfolio · {validProjects.length} projects</p>
      <h1 class="text-3xl font-extrabold text-charcoal-DEFAULT dark:text-cream-50 tracking-tight">AI 共创作品集</h1>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {validProjects.map((project, idx) => {
        const isLarge = idx === 0;
        const canEmbed = isEmbeddableDemo(project.data.demoUrl);

        return (
          <div class={`group flex flex-col rounded-3xl border border-charcoal-500/10 dark:border-white/8 overflow-hidden hover:border-terracotta/30 hover:shadow-2xl transition-all duration-300 bg-white/60 dark:bg-zinc-900/60 backdrop-blur-md ${isLarge ? 'md:col-span-2' : ''}`}>
            {/* Cover: Direct Live Demo Iframe if available, otherwise Cover Image */}
            <div class={`relative overflow-hidden bg-zinc-950 ${isLarge ? 'h-80 sm:h-96' : 'h-60'}`}>
              {canEmbed ? (
                <>
                  <iframe
                    src={project.data.demoUrl}
                    title={project.data.title}
                    loading="lazy"
                    class="w-full h-full border-0 bg-white dark:bg-zinc-950"
                    sandbox="allow-scripts allow-same-origin allow-popups allow-forms"
                  />
                  <span class="absolute top-3 right-3 px-2.5 py-1 rounded-full bg-emerald-500/90 text-white text-[10px] font-mono font-semibold shadow pointer-events-none">
                    ● LIVE DEMO
                  </span>
                </>
              ) : (
                <a href={`/portfolio/${project.id}`} class="block w-full h-full">
                  <img
                    src={project.data.cover}
                    alt={project.data.title}
                    loading="lazy"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent" />
                </a>
              )}
              <span class="absolute top-3 left-3 px-3 py-1 rounded-full bg-black/60 backdrop-blur-md text-xs font-mono text-white/95 border border-white/15 pointer-events-none">
                {project.data.category}
              </span>
            </div>

            {/* Content */}
            <div class="p-6 flex-1 flex flex-col">
              <h2 class={`font-bold text-charcoal-DEFAULT dark:text-cream-50 group-hover:text-terracotta transition-colors leading-snug ${isLarge ? 'text-2xl' : 'text-xl'}`}>
                <a href={`/portfolio/${project.id}`}>{project.data.title}</a>
              </h2>

              <p class="mt-2.5 text-sm text-charcoal-100 dark:text-cream-300 line-clamp-3 leading-relaxed flex-1">
                {project.data.description}
              </p>

              {project.data.tags && project.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-1.5 mt-4">
                  {project.data.tags.slice(0, 5).map((tag: string) => (
                    <span class="px-2.5 py-1 rounded-full text-xs bg-terracotta/8 text-terracotta border border-terracotta/15 font-mono">
                      {tag}
                    </span>
                  ))}
                </div>
              )}

              <div class="mt-5 pt-4 border-t border-charcoal-500/8 dark:border-white/8 flex items-center justify-between gap-4">
                <div class="flex items-center gap-3">
                  {project.data.githubUrl && (
                    <a href={project.data.githubUrl} target="_blank" rel="noopener noreferrer" class="text-xs font-mono text-charcoal-100 dark:text-cream-400 hover:text-terracotta flex items-center gap-1 transition-colors">
                      GitHub
                    </a>
                  )}
                  {project.data.demoUrl && (
                    <a href={project.data.demoUrl} target="_blank" rel="noopener noreferrer" class="text-xs font-mono text-emerald-600 dark:text-emerald-400 hover:underline flex items-center gap-1 transition-colors">
                      打开演示 ↗
                    </a>
                  )}
                </div>
                <a href={`/portfolio/${project.id}`} class="text-sm font-semibold text-terracotta group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                  复盘详情 →
                </a>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>
</Layout>
