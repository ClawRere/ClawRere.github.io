---
import Layout from '@/layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { ArrowLeft, Calendar, Tag, User, Share2 } from 'lucide-react';

export async function getStaticPaths() {
  const posts = await getCollection('posts');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={`${post.data.title} | 磊大大の小栈`}>
  <article class="py-6 max-w-3xl mx-auto">
    <!-- Back to posts link -->
    <a
      href="/posts"
      class="inline-flex items-center gap-1.5 text-xs font-mono text-charcoal-100 dark:text-cream-400 hover:text-terracotta transition-colors mb-6"
    >
      <ArrowLeft class="w-3.5 h-3.5" />
      返回知识库列表
    </a>

    <!-- Article Header -->
    <header class="mb-10 pb-6 border-b border-charcoal-500/10 dark:border-white/10">
      <div class="flex items-center gap-2 text-xs font-mono text-charcoal-100 dark:text-cream-400 mb-3">
        <span class="flex items-center gap-1">
          <Calendar class="w-3.5 h-3.5 text-terracotta" />
          {new Date(post.data.date).toLocaleDateString('zh-CN')}
        </span>
        {post.data.categories && (
          <>
            <span>·</span>
            <span class="text-terracotta">
              {Array.isArray(post.data.categories) ? post.data.categories.join(', ') : post.data.categories}
            </span>
          </>
        )}
      </div>

      <h1 class="font-serif text-3xl sm:text-4xl lg:text-5xl font-medium text-charcoal-DEFAULT dark:text-cream-50 leading-[1.2]">
        {post.data.title}
      </h1>

      {post.data.description && (
        <p class="mt-4 text-base text-charcoal-100 dark:text-cream-300 leading-relaxed font-serif">
          {post.data.description}
        </p>
      )}

      <div class="mt-6 flex items-center justify-between text-xs font-mono text-charcoal-100 dark:text-cream-400 pt-4 border-t border-charcoal-500/10 dark:border-white/10">
        <div class="flex items-center gap-2">
          <User class="w-3.5 h-3.5 text-terracotta" />
          <span>作者：{post.data.author || 'Larry'}</span>
        </div>
        <div class="flex items-center gap-1">
          <span>阅读归档：Markdown 渲染</span>
        </div>
      </div>
    </header>

    <!-- Article Prose Body (Claude-inspired typography) -->
    <div class="prose prose-charcoal dark:prose-invert max-w-none prose-headings:font-serif prose-headings:font-medium prose-a:text-terracotta prose-a:underline-offset-4 prose-pre:bg-charcoal-900 prose-pre:border prose-pre:border-white/5 prose-img:rounded-2xl prose-img:shadow-apple-card leading-relaxed">
      <Content />
    </div>

    <!-- Article Footer -->
    <footer class="mt-14 pt-6 border-t border-charcoal-500/10 dark:border-white/10 flex items-center justify-between text-xs font-mono text-charcoal-100 dark:text-cream-400">
      <a href="/posts" class="text-terracotta hover:underline">
        ← 返回知识库所有文章
      </a>
      <span>© 磊大大的数字花园</span>
    </footer>
  </article>

  <script is:inline>
    (() => {
      const hideBrokenImages = () => {
        document.querySelectorAll('.prose img').forEach((img) => {
          if (img.dataset.hideBound) return;
          img.dataset.hideBound = '1';
          const hide = () => {
            img.style.display = 'none';
          };
          img.addEventListener('error', hide, { once: true });
          if (img.complete && img.naturalWidth === 0) hide();
        });
      };
      hideBrokenImages();
      document.addEventListener('astro:page-load', hideBrokenImages);
    })();
  </script>
</Layout>
