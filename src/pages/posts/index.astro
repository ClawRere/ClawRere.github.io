---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getPostCover } from '@/lib/covers';
import { QuickPostButton } from '@/components/blog/QuickPostButton';
import { Calendar, Tag, ArrowUpRight, Search } from 'lucide-react';

const allPosts = await getCollection('posts');
const sortedPosts = allPosts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const categories = Array.from(
  new Set(
    sortedPosts
      .map((p) => p.data.categories)
      .filter(Boolean)
      .flatMap((c) => (Array.isArray(c) ? c : [c]))
  )
) as string[];
---

<Layout title="知识库与技术博客 | 磊大大の小栈" sideTitle="知识库与博客">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-6">

    <!-- Page hero (title shown vertically in left margin on xl) -->
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
      <div class="xl:hidden">
        <p class="text-xs font-mono uppercase tracking-widest text-terracotta mb-1">Technical Blog · {sortedPosts.length}</p>
        <h1 class="text-3xl font-extrabold text-charcoal-DEFAULT dark:text-cream-50 tracking-tight">知识库</h1>
      </div>
      <div class="hidden xl:block text-xs font-mono text-terracotta">
        Technical Blog · {sortedPosts.length} 篇文章
      </div>
      <QuickPostButton client:load />
    </div>

    <!-- Category filter chips -->
    <div class="flex flex-wrap gap-2 mb-10" id="category-filter">
      <button
        data-cat="all"
        onclick="filterPosts('all')"
        class="cat-btn active px-4 py-1.5 rounded-full text-xs font-medium border border-terracotta bg-terracotta/10 text-terracotta transition-all"
      >
        全部 ({sortedPosts.length})
      </button>
      {categories.map(cat => (
        <button
          data-cat={cat}
          onclick={`filterPosts('${cat}')`}
          class="cat-btn px-4 py-1.5 rounded-full text-xs font-medium border border-charcoal-500/15 dark:border-white/10 text-charcoal-200 dark:text-cream-300 hover:border-terracotta/40 hover:text-terracotta transition-all"
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Posts masonry-ish grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5" id="posts-grid">
      {sortedPosts.map((post, idx) => {
        const cover = getPostCover(post.data.cover, post.data.title, idx, post.body);
        const category = Array.isArray(post.data.categories)
          ? post.data.categories[0]
          : post.data.categories || '笔记';
        const isLarge = idx === 0;

        return (
          <a
            href={`/posts/${post.id}`}
            data-category={category}
            class={`post-card group relative flex flex-col overflow-hidden rounded-[18px] border border-charcoal-500/10 dark:border-white/10 ring-1 ring-inset ring-white/40 dark:ring-white/10 hover:border-terracotta/30 dark:hover:border-terracotta/30 shadow-[0_10px_28px_rgba(31,36,48,0.10)] hover:shadow-[0_18px_40px_rgba(31,36,48,0.18)] hover:-translate-y-1.5 transition-all duration-500 ease-[cubic-bezier(0.25,0.75,0.2,1)] bg-white/65 dark:bg-zinc-900/55 backdrop-blur-sm ${isLarge ? 'sm:col-span-2 lg:col-span-2' : ''}`}
          >
            <!-- Cover image -->
            <div class={`relative overflow-hidden ${isLarge ? 'h-56 sm:h-64' : 'h-40'}`}>
              <img
                src={cover}
                alt={post.data.title}
                loading="lazy"
                onerror="this.onerror=null;this.src='https://images.unsplash.com/photo-1462331940025-496dfbfc7564?q=80&w=1200&auto=format&fit=crop';"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent" />

              <!-- Category badge -->
              <span class="absolute top-3 left-3 px-2.5 py-1 rounded-full text-[10px] font-mono font-semibold bg-black/50 backdrop-blur-md text-white/90 border border-white/15">
                {category}
              </span>
            </div>

            <!-- Content -->
            <div class="p-5 flex flex-col flex-1">
              <div class="flex items-center gap-2 text-[11px] font-mono text-charcoal-100 dark:text-cream-400 mb-2.5">
                <Calendar class="w-3 h-3 text-terracotta" />
                <span>{new Date(post.data.date).toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
              </div>

              <h2 class={`font-bold text-charcoal-DEFAULT dark:text-cream-50 group-hover:text-terracotta transition-colors leading-snug line-clamp-2 ${isLarge ? 'text-xl' : 'text-base'}`}>
                {post.data.title}
              </h2>

              {post.data.description && (
                <p class="mt-2 text-xs text-charcoal-100 dark:text-cream-400 line-clamp-2 leading-relaxed flex-1">
                  {post.data.description}
                </p>
              )}

              <!-- Tags -->
              {post.data.tags && post.data.tags.length > 0 && (
                <div class="flex flex-wrap gap-1 mt-3">
                  {(Array.isArray(post.data.tags) ? post.data.tags : [post.data.tags]).slice(0, 3).map((tag: string) => (
                    <span class="px-2 py-0.5 rounded-md bg-terracotta/8 text-terracotta text-[10px] font-mono">
                      #{tag}
                    </span>
                  ))}
                </div>
              )}

              <div class="mt-4 pt-3 border-t border-charcoal-500/8 dark:border-white/8 flex items-center justify-between text-xs font-mono text-terracotta">
                <span class="opacity-0 group-hover:opacity-100 transition-opacity">阅读全文</span>
                <ArrowUpRight class="w-4 h-4 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</Layout>

<script>
  function filterPosts(cat: string) {
    const cards = document.querySelectorAll('.post-card') as NodeListOf<HTMLElement>;
    const btns = document.querySelectorAll('.cat-btn') as NodeListOf<HTMLElement>;

    btns.forEach(btn => {
      const isActive = btn.dataset.cat === cat;
      btn.classList.toggle('active', isActive);
      btn.classList.toggle('border-terracotta', isActive);
      btn.classList.toggle('bg-terracotta/10', isActive);
      btn.classList.toggle('text-terracotta', isActive);
      btn.classList.toggle('border-charcoal-500/15', !isActive);
      btn.classList.toggle('dark:border-white/10', !isActive);
      btn.classList.toggle('text-charcoal-200', !isActive);
    });

    cards.forEach(card => {
      const matchAll = cat === 'all';
      const matchCat = card.dataset.category === cat;
      card.style.display = matchAll || matchCat ? '' : 'none';
    });
  }

  (window as any).filterPosts = filterPosts;
</script>

<style>
  .cat-btn.active {
    border-color: rgb(var(--color-terracotta) / 1);
    background-color: rgb(var(--color-terracotta) / 0.1);
    color: rgb(var(--color-terracotta) / 1);
  }
</style>
