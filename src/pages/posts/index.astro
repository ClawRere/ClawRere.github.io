---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { BookOpen, Calendar, Tag, ArrowUpRight, Search } from 'lucide-react';

const allPosts = await getCollection('posts');
const sortedPosts = allPosts.sort(
  (a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime()
);

// Collect unique categories
const categories = Array.from(
  new Set(
    sortedPosts
      .map((p) => p.data.categories)
      .filter(Boolean)
      .flatMap((c) => (Array.isArray(c) ? c : [c]))
  )
);
---

<Layout title="知识库 | 磊大大 Larry - 技术笔记">
  <div class="py-8">
    <div class="max-w-2xl">
      <div class="inline-flex items-center gap-1.5 text-xs font-mono uppercase tracking-wider text-amber-600 dark:text-amber-400 mb-2">
        <BookOpen class="w-3.5 h-3.5" />
        Knowledge Garden & Notes
      </div>
      <h1 class="font-serif text-3xl sm:text-4xl font-medium text-charcoal-DEFAULT dark:text-cream-50">
        技术知识库沉淀
      </h1>
      <p class="mt-3 text-sm text-charcoal-100 dark:text-cream-300 leading-relaxed">
        收录从 Hexo 站点完整迁移的 99+ 篇技术长文与实践随笔，涵盖 AI 工具链实践、Cursor 提示工程、大模型部署以及个人工程哲学。
      </p>
    </div>

    <!-- Category Pills Bar -->
    <div class="flex flex-wrap items-center gap-2 mt-8 mb-10 pb-4 border-b border-charcoal-500/10 dark:border-white/10">
      <span class="px-3 py-1 rounded-full text-xs font-medium bg-terracotta text-white">
        全部 ({sortedPosts.length})
      </span>
      {categories.map((cat) => (
        <span class="px-3 py-1 rounded-full text-xs font-medium bg-cream-200/80 dark:bg-obsidian-border text-charcoal-200 dark:text-cream-300 hover:bg-cream-300/80 cursor-pointer transition-colors">
          {cat}
        </span>
      ))}
    </div>

    <!-- Post list -->
    <div class="divide-y divide-charcoal-500/10 dark:divide-white/10">
      {sortedPosts.map((post) => (
        <a
          href={`/posts/${post.id}`}
          class="group py-6 flex flex-col sm:flex-row sm:items-center justify-between gap-4 hover:px-3 rounded-2xl transition-all duration-200 hover:bg-cream-100/40 dark:hover:bg-obsidian-card/40"
        >
          <div class="flex-1">
            <div class="flex items-center gap-2 text-xs font-mono text-charcoal-100 dark:text-cream-400 mb-1.5">
              <span class="flex items-center gap-1">
                <Calendar class="w-3.5 h-3.5 text-terracotta" />
                {new Date(post.data.date).toLocaleDateString('zh-CN')}
              </span>
              {post.data.categories && (
                <>
                  <span>·</span>
                  <span class="px-2 py-0.5 rounded bg-cream-200/60 dark:bg-obsidian-border text-terracotta text-[11px]">
                    {Array.isArray(post.data.categories) ? post.data.categories.join(', ') : post.data.categories}
                  </span>
                </>
              )}
            </div>

            <h2 class="font-serif text-lg sm:text-xl font-medium text-charcoal-DEFAULT dark:text-cream-50 group-hover:text-terracotta transition-colors">
              {post.data.title}
            </h2>

            {post.data.description && (
              <p class="mt-1 text-xs text-charcoal-100 dark:text-cream-400 line-clamp-1">
                {post.data.description}
              </p>
            )}
          </div>

          <div class="flex items-center gap-2 self-start sm:self-center">
            <span class="text-xs font-medium text-charcoal-100 dark:text-cream-400 group-hover:text-terracotta transition-colors flex items-center gap-1">
              阅读全文
              <ArrowUpRight class="w-3.5 h-3.5 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-transform" />
            </span>
          </div>
        </a>
      ))}
    </div>
  </div>
</Layout>
