---
import Layout from '@/layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { getPostCover } from '@/lib/covers';
import { QuickPostButton } from '@/components/blog/QuickPostButton';
import { Calendar, Tag, ArrowUpRight, Search } from 'lucide-react';

const allPosts = await getCollection('posts');
const sortedPosts = allPosts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());

const categories = Array.from(
  new Set(
    sortedPosts
      .map((p) => p.data.categories)
      .filter(Boolean)
      .flatMap((c) => (Array.isArray(c) ? c : [c]))
  )
) as string[];
---

<Layout title="知识库与技术博客 | 磊大大の小栈" sideTitle="知识库与博客">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 py-6">

    <!-- Page hero (title shown vertically in left margin on xl) -->
    <div class="mb-6 flex flex-wrap items-center justify-between gap-4">
      <div class="xl:hidden">
        <p class="text-xs font-mono uppercase tracking-widest text-terracotta mb-1">Technical Blog · {sortedPosts.length}</p>
        <h1 class="text-3xl font-extrabold text-charcoal-DEFAULT dark:text-cream-50 tracking-tight">知识库</h1>
      </div>
      <div class="hidden xl:block text-xs font-mono text-terracotta">
        Technical Blog · {sortedPosts.length} 篇文章
      </div>
      <QuickPostButton client:load />
    </div>

    <!-- Category filter chips -->
    <div class="flex flex-wrap gap-2 mb-10" id="category-filter">
      <button
        data-cat="all"
        onclick="filterPosts('all')"
        class="cat-btn active px-4 py-1.5 rounded-full text-xs font-medium border border-terracotta bg-terracotta/10 text-terracotta transition-all"
      >
        全部 ({sortedPosts.length})
      </button>
      {categories.map(cat => (
        <button
          data-cat={cat}
          onclick={`filterPosts('${cat}')`}
          class="cat-btn px-4 py-1.5 rounded-full text-xs font-medium border border-charcoal-500/15 dark:border-white/10 text-charcoal-200 dark:text-cream-300 hover:border-terracotta/40 hover:text-terracotta transition-all"
        >
          {cat}
        </button>
      ))}
    </div>

    <!-- Faint Pale-Pink/Peach Oversized Watermark Title partially occluded by cards, rises & fades on scroll -->
    <div
      aria-hidden="true"
      class="scroll-watermark-rise pointer-events-none select-none text-center -mb-10 sm:-mb-16 relative z-0 overflow-hidden"
    >
      <span class="block text-[20vw] sm:text-[9.5rem] lg:text-[11.5rem] font-black leading-none tracking-[0.14em] bg-gradient-to-r from-rose-400/45 via-orange-300/45 to-pink-400/45 dark:from-rose-300/35 dark:via-orange-200/35 dark:to-pink-300/35 bg-clip-text text-transparent">
        知识库
      </span>
    </div>

    <!-- Horizontal Two-Column Frosted Glass Cards -->
    <div class="relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-5" id="posts-grid">
      {sortedPosts.map((post, idx) => {
        const category = Array.isArray(post.data.categories)
          ? post.data.categories[0]
          : post.data.categories || '笔记';
        const tags: string[] = Array.isArray(post.data.tags)
          ? post.data.tags
          : post.data.tags
          ? [post.data.tags]
          : [];
        const cover = `/img/blog/cover-${(idx % 10) + 1}.svg`;

        return (
          <a
            href={`/posts/${post.id}`}
            data-category={category}
            class="post-card scroll-reveal-card group relative flex flex-col sm:flex-row overflow-hidden rounded-2xl glass border border-charcoal-500/12 dark:border-white/12 hover:border-terracotta/45 shadow-md hover:shadow-xl hover:-translate-y-1 transition-all duration-300"
          >
            {/* Left Illustrated Cover Image (no vertical color bar) */}
            <div class="relative w-full sm:w-44 md:w-48 h-40 sm:h-auto shrink-0 overflow-hidden bg-zinc-900/10">
              <img
                src={cover}
                alt={post.data.title}
                loading="lazy"
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
              />
              <span class="absolute top-2.5 left-3 px-2.5 py-0.5 rounded-full text-[10px] font-mono font-semibold bg-black/55 backdrop-blur-sm text-white border border-white/15">
                {category}
              </span>
            </div>

            {/* Right: Title + Optional Summary + Date + Tags */}
            <div class="flex-1 p-4 sm:p-5 flex flex-col justify-between min-w-0 gap-3">
              <div class="space-y-1.5">
                <h2 class="font-bold text-sm sm:text-base text-charcoal-DEFAULT dark:text-cream-50 group-hover:text-terracotta transition-colors leading-snug line-clamp-2">
                  {post.data.title}
                </h2>
                {post.data.description && (
                  <p class="text-xs text-charcoal-100 dark:text-cream-300/80 line-clamp-2 leading-relaxed">
                    {post.data.description}
                  </p>
                )}
              </div>

              <div class="flex flex-wrap items-center justify-between gap-2 pt-2 border-t border-charcoal-500/10 dark:border-white/10">
                <div class="flex items-center gap-1.5 text-[11px] font-mono text-charcoal-100 dark:text-cream-400">
                  <Calendar class="w-3.5 h-3.5 text-terracotta shrink-0" />
                  <span>{new Date(post.data.date).toLocaleDateString('zh-CN', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
                </div>
                <div class="flex items-center gap-1.5 flex-wrap">
                  {tags.slice(0, 2).map((t) => (
                    <span class="inline-flex items-center gap-0.5 px-2 py-0.5 rounded-full text-[10px] font-mono bg-terracotta/10 text-terracotta border border-terracotta/15">
                      <Tag class="w-2.5 h-2.5" />
                      {t}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</Layout>

<script>
  function filterPosts(cat: string) {
    const cards = document.querySelectorAll('.post-card') as NodeListOf<HTMLElement>;
    const btns = document.querySelectorAll('.cat-btn') as NodeListOf<HTMLElement>;

    btns.forEach(btn => {
      const isActive = btn.dataset.cat === cat;
      btn.classList.toggle('active', isActive);
      btn.classList.toggle('border-terracotta', isActive);
      btn.classList.toggle('bg-terracotta/10', isActive);
      btn.classList.toggle('text-terracotta', isActive);
      btn.classList.toggle('border-charcoal-500/15', !isActive);
      btn.classList.toggle('dark:border-white/10', !isActive);
      btn.classList.toggle('text-charcoal-200', !isActive);
    });

    cards.forEach(card => {
      const matchAll = cat === 'all';
      const matchCat = card.dataset.category === cat;
      card.style.display = matchAll || matchCat ? '' : 'none';
    });
  }

  (window as any).filterPosts = filterPosts;

  // Black-hole vortex transition when entering an article
  const bindPortalTransition = () => {
    document.querySelectorAll('.post-card').forEach((card) => {
      const el = card as HTMLAnchorElement;
      if (el.dataset.portalBound) return;
      el.dataset.portalBound = '1';
      el.addEventListener('click', (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey) return;
        e.preventDefault();
        const href = el.getAttribute('href');
        if (!href) return;

        el.style.transition = 'transform 0.42s cubic-bezier(0.7, 0, 0.84, 0), opacity 0.42s ease';
        el.style.transform = 'scale(0.15) rotate(14deg)';
        el.style.opacity = '0';

        const portal = document.createElement('div');
        portal.className = 'fixed inset-0 z-[120] pointer-events-none flex items-center justify-center bg-black/0 transition-colors duration-300';
        portal.innerHTML = '<div class="w-40 h-40 rounded-full bg-[radial-gradient(circle,#000_35%,rgba(217,119,87,0.55)_65%,transparent_80%)] animate-[spin_0.45s_linear_infinite] scale-[8] transition-transform duration-500"></div>';
        document.body.appendChild(portal);
        requestAnimationFrame(() => {
          portal.style.backgroundColor = 'rgba(10,12,18,0.85)';
        });

        setTimeout(() => {
          window.location.href = href;
        }, 380);
      });
    });
  };
  bindPortalTransition();
  document.addEventListener('astro:page-load', bindPortalTransition);
</script>

<style>
  .cat-btn.active {
    border-color: rgb(var(--color-terracotta) / 1);
    background-color: rgb(var(--color-terracotta) / 0.1);
    color: rgb(var(--color-terracotta) / 1);
  }
</style>
