---
import Layout from '@/layouts/Layout.astro';
import { Newspaper, Wrench, ExternalLink } from 'lucide-react';

const tools = [
  {
    id: 'daily',
    title: '今日 AI 早报',
    desc: '聚合科技热榜、行业日报与 HackerNews 精选',
    emoji: '📰',
    src: 'https://www.ithome.com/',
    color: 'from-amber-500/15 to-orange-500/10',
  },
  {
    id: 'recommend',
    title: 'AI 工具推荐',
    desc: 'Cursor · 大模型 API · 本地 LLM · 效率神器',
    emoji: '🛠️',
    src: 'https://www.futurepedia.io/',
    color: 'from-sky-500/15 to-blue-500/10',
  },
];
---

<Layout title="生产力工具箱 | 磊大大 Larry">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 py-10 space-y-10">

    <div>
      <p class="text-xs font-mono uppercase tracking-widest text-terracotta mb-2">Productivity Toolbox</p>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-charcoal-DEFAULT dark:text-cream-50">生产力工具箱</h1>
      <p class="mt-2 text-sm text-charcoal-100 dark:text-cream-300">整合日常开发、产品构思与 AI 效率的精选工具集</p>
    </div>

    <!-- Tool PiP grid: each takes ~half screen height -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
      {tools.map(tool => (
        <div class={`group flex flex-col rounded-3xl border border-charcoal-500/10 dark:border-white/8 overflow-hidden bg-gradient-to-br ${tool.color} bg-white/40 dark:bg-zinc-900/40 backdrop-blur-sm`}>
          <!-- Tool header bar -->
          <div class="flex items-center justify-between px-5 py-3.5 border-b border-charcoal-500/8 dark:border-white/8">
            <div class="flex items-center gap-2.5">
              <div class="flex gap-1.5">
                <span class="w-2.5 h-2.5 rounded-full bg-red-400/70" />
                <span class="w-2.5 h-2.5 rounded-full bg-amber-400/70" />
                <span class="w-2.5 h-2.5 rounded-full bg-green-400/70" />
              </div>
              <span class="text-xs font-mono text-charcoal-100 dark:text-cream-400 ml-2">
                {tool.emoji} {tool.title}
              </span>
            </div>
            <a
              href={tool.src}
              target="_blank"
              rel="noopener noreferrer"
              class="text-charcoal-100 dark:text-cream-400 hover:text-terracotta transition-colors p-1 rounded-lg hover:bg-terracotta/8"
              title="在新标签页打开"
            >
              <ExternalLink class="w-3.5 h-3.5" />
            </a>
          </div>

          <!-- Embedded iframe -->
          <div class="relative flex-1 min-h-[480px] lg:min-h-[520px]">
            <iframe
              src={tool.src}
              title={tool.title}
              class="w-full h-full border-0 absolute inset-0"
              loading="lazy"
              sandbox="allow-scripts allow-same-origin allow-popups allow-forms"
            />
          </div>

          <!-- Footer info -->
          <div class="px-5 py-3 border-t border-charcoal-500/8 dark:border-white/8 flex items-center justify-between">
            <p class="text-xs text-charcoal-100 dark:text-cream-400">{tool.desc}</p>
            <a href={tool.src} target="_blank" rel="noopener noreferrer" class="text-xs font-mono text-terracotta hover:underline flex items-center gap-1">
              新窗口打开 <ExternalLink class="w-3 h-3" />
            </a>
          </div>
        </div>
      ))}
    </div>
  </div>
</Layout>
