---
import Layout from '@/layouts/Layout.astro';
import { ToolboxViewer } from '@/components/tools/ToolboxViewer';
---

<Layout title="生产力工具箱 | 磊大大の小栈" sideTitle="生产力工具箱">
  <div class="py-6 space-y-6">
    <div class="pb-1 xl:hidden">
      <p class="text-xs font-mono uppercase tracking-widest text-terracotta mb-1">Productivity Toolbox</p>
      <h1 class="text-3xl font-extrabold text-charcoal-DEFAULT dark:text-cream-50">生产力工具箱</h1>
    </div>

    <ToolboxViewer client:load />
  </div>
</Layout>
